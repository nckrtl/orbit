{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nckrtl/orbit",
    "description": "Development orchestration for the Orbit monorepo.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5"
    },
    "scripts": {
        "bootstrap": "bin/bootstrap",
        "docs-build": "@php apps/docs/artisan orbit:docs-index",
        "docs-context": "@php apps/docs/artisan orbit:docs-context",
        "docs-lint": "@php apps/docs/artisan librarian:lint --format=agent",
        "test": "bin/test"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
