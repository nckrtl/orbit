{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nckrtl/orbit-php-sdk",
    "description": "PHP SDK for the Orbit gateway API.",
    "keywords": ["infrastructure", "orbit", "saloon", "sdk"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.5",
        "psr/http-message": "^2.0",
        "saloonphp/saloon": "^4.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.47",
        "pestphp/pest": "^5.1",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Orbit\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Orbit\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/mago analyze src --reporting-format=medium",
        "check": [
            "@test",
            "@format:check",
            "@lint",
            "@analyse"
        ],
        "format": "vendor/bin/mago format",
        "format:check": "vendor/bin/mago format --check",
        "lint": "vendor/bin/mago lint src tests --reporting-format=medium",
        "test": "vendor/bin/pest --compact",
        "test:full": "vendor/bin/pest --no-tia --compact"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
