{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nckrtl/orbit-php-sdk",
    "description": "PHP SDK for the Orbit gateway API.",
    "keywords": ["infrastructure", "orbit", "saloon", "sdk"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.5",
        "psr/http-message": "^2.0",
        "saloonphp/saloon": "^4.0"
    },
    "require-dev": {
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.1",
        "phpstan/phpstan": "^2.2.13",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Orbit\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Orbit\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "pre-autoload-dump": "@php ../../bin/pest-setup",
        "test:affected": "vendor/bin/pest --parallel --processes=2 --tia --compact",
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "check": [
            "@guidance:check",
            "@rector",
            "@format:check",
            "@analyse"
        ],
        "format": "vendor/bin/pint",
        "format:check": "vendor/bin/pint --test",
        "guidance:check": "vendor/bin/pest --tia --compact",
        "lint": "@format:check",
        "rector": "vendor/bin/rector process --dry-run --no-progress-bar",
        "test": "vendor/bin/pest --parallel --tia --compact"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "rector/rector": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
