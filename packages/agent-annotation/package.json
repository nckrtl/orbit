{
    "name": "@nckrtl/annotator",
    "version": "0.1.1",
    "description": "Browser annotations with voice input and a local task server for coding agents.",
    "license": "MIT",
    "author": "Nick Retel",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nckrtl/orbit.git",
        "directory": "packages/agent-annotation"
    },
    "bin": {
        "annotator": "bin/serve.mjs"
    },
    "files": [
        "dist",
        "bin",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./inject": "./dist/inject.js",
        "./vite": {
            "types": "./bin/vite.d.mts",
            "import": "./bin/vite.mjs"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "vp build && ANNOTATION_INJECT=1 vp build && tsc --emitDeclarationOnly",
        "test": "node tests/smoke.mjs && node tests/service.mjs && node tests/orbit.mjs && node tests/local-server.mjs && node tests/lifecycle.mjs && node tests/proxy.mjs && node tests/host-controls.mjs",
        "check": "vp check",
        "prepack": "vp run build"
    },
    "dependencies": {
        "@heroicons/react": "2",
        "html-to-image": "^1.11.13",
        "pusher-js": "^8.6.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "playwright": "1.62.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
        "vite-plus": "0.2.6",
        "ws": "^8.21.3"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.4.2",
            "onFail": "ignore"
        }
    },
    "engines": {
        "node": ">=22"
    }
}
