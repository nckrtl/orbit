APP_NAME="Orbit Gateway"
APP_VERSION=0.1.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Defaults to $HOME/.orbit when unset.
ORBIT_HOME=
ORBIT_GATEWAY_CHECKOUT=/home/orbit/orbit-gateway
ORBIT_APP_DEV_DOMAIN=orbit
ORBIT_HIBERNATION_IDLE_SECONDS=3600
ORBIT_HIBERNATION_SWEEP_SECONDS=600
ORBIT_HIBERNATION_WAKE_TIMEOUT_SECONDS=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Realtime record events broadcast through the `websocket` node role
# (`orbit node:role:add <node> websocket`). There is no env configuration
# for this any more; see docs/solutions/realtime-reverb.mdx.
# ORBIT_WEBSOCKET_REPOSITORY=https://github.com/nckrtl/orbit-reverb.git
# ORBIT_WEBSOCKET_REF=main
# ORBIT_WEBSOCKET_INSTALL_PATH=/opt/orbit/websocket
# ORBIT_WEBSOCKET_PORT=8790

# TypeSafe Jev for task-session routing. Commander stored only this key and
# TOOLBAR_TYPESAFE_ENABLED; it had no laravel/ai package or config/ai.php.
# A missing key fails closed and never invents a next action.
TYPESAFE_API_KEY=
ORBIT_TASKS_JEV_CONFIDENCE_THRESHOLD=0.75
