APP_NAME="Orbit Gateway"
APP_VERSION=0.1.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Defaults to $HOME/.orbit when unset.
ORBIT_HOME=
ORBIT_GATEWAY_CHECKOUT=/home/orbit/orbit-gateway
ORBIT_APP_DEV_DOMAIN=orbit
ORBIT_HIBERNATION_IDLE_SECONDS=3600
ORBIT_HIBERNATION_SWEEP_SECONDS=600
ORBIT_HIBERNATION_WAKE_TIMEOUT_SECONDS=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Realtime record events. Leave BROADCAST_CONNECTION unset to disable.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb.orbit
REVERB_PORT=443
REVERB_SCHEME=https

# Absolute path of a wrapper the antigravity-watch preset runs instead of Antigravity print mode.
# ORBIT_AGENTATION_WATCH_COMMAND=
