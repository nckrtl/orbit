#!/usr/bin/env python3
"""Orbit task check (ADR 0125). The Gateway installs this script in .git/orbit/ and runs it over SSH.

check start CHECKOUT [SETUP|-] [DELIVERABLES|-] [COMMAND]
                                start the Project task check detached; print the process and the tree it checks.
                                SETUP is a JSON file of setup steps to run first: [{"name", "command", "timeout_seconds"}]
                                DELIVERABLES is a JSON file of the subtask's deliverables to verify after a passing check
                                (ADR 0133): {"start", "tests": [{"id", "project", "file", "fails_on_base"}], "commands": [{"id", "command", "directory"}]}
                                A test with fails_on_base runs on the start commit, with only that test file taken from the working tree, then on the working tree (ADR 0163).
                                COMMAND is a file with the Project's task check command; an empty file runs no command.
                                Without COMMAND, the check runs `composer check`.
check run CHECKOUT HEAD TREE [SETUP|-] [DELIVERABLES|-] [COMMAND]
                                run the setup steps and the command, then write check.json (started by `start`)
check status PID STARTED        print running, finished (with the result), or lost
check cancel PID STARTED        stop the check's process group
check snapshot CHECKOUT         print HEAD, its parent, its tree, and the working-tree hash, without touching the index
"""

import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ElementTree

DIRECTORY = os.path.dirname(os.path.abspath(__file__))
RESULT = os.path.join(DIRECTORY, 'check.json')
LOG = os.path.join(DIRECTORY, 'check.log')
OUTPUT_TAIL = 16384
COMMAND_OUTPUT_TAIL = 4096
TEST_RESULTS = os.path.join(DIRECTORY, 'tests')


def git(checkout, *arguments, environment=None):
    return subprocess.check_output(['git', '-C', checkout, *arguments], env=environment, text=True,
                                   stderr=subprocess.DEVNULL).strip()


def working_tree(checkout):
    """The tree of the whole working tree, uncommitted and untracked files included, without touching the index."""
    index = git(checkout, 'rev-parse', '--path-format=absolute', '--git-path', 'index')
    with tempfile.TemporaryDirectory(prefix='orbit-check-') as scratch:
        candidate = os.path.join(scratch, 'index')
        if os.path.exists(index):
            shutil.copyfile(index, candidate)
        environment = {**os.environ, 'GIT_INDEX_FILE': candidate}
        subprocess.run(['git', '-C', checkout, 'add', '--all'], env=environment, check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return git(checkout, 'write-tree', environment=environment)


def changed_paths(checkout, before, after):
    if before == after:
        return []
    return git(checkout, 'diff-tree', '-r', '--name-only', before, after).splitlines()


def process_started(pid):
    """The process start time as ps reports it, or None when the process does not exist."""
    result = subprocess.run(['ps', '-o', 'lstart=', '-p', str(pid)], capture_output=True, text=True)
    started = result.stdout.strip()
    return started if result.returncode == 0 and started else None


def optional(path):
    return path if path and path != '-' else None


def start(checkout, setup=None, deliverables=None, command=None):
    setup, deliverables = optional(setup), optional(deliverables)
    if command:
        with open(command) as source:
            command = source.read()
    else:
        command = 'composer check'
    head = git(checkout, 'rev-parse', 'HEAD')
    tree = working_tree(checkout)
    for path in (RESULT, LOG):
        if os.path.exists(path):
            os.remove(path)
    pid = os.fork()
    if pid == 0:
        os.setsid()
        null = os.open(os.devnull, os.O_RDWR)
        for descriptor in (0, 1, 2):
            os.dup2(null, descriptor)
        os.execv(sys.executable, [sys.executable, os.path.abspath(__file__), 'run', checkout, head, tree, setup or '-', deliverables or '-', command])
    for _ in range(50):
        started = process_started(pid)
        if started:
            break
        time.sleep(0.02)
    print(json.dumps({'pid': pid, 'started': started, 'head': head, 'tree': tree}))


def run_setup(checkout, setup, log):
    """Run each setup step in order. Return the name and exit code of the first step that fails."""
    with open(setup) as steps:
        for step in json.load(steps):
            log.write(f"$ {step['command']}\n".encode())
            log.flush()
            try:
                exit_code = subprocess.run(['bash', '-lc', step['command']], cwd=checkout, stdin=subprocess.DEVNULL,
                                           stdout=log, stderr=subprocess.STDOUT,
                                           timeout=step.get('timeout_seconds') or None).returncode
            except subprocess.TimeoutExpired:
                log.write(f"Setup step {step['name']} timed out after {step['timeout_seconds']} seconds.\n".encode())
                exit_code = 124
            if exit_code != 0:
                return step['name'], exit_code
    return None, 0


def inside(checkout, relative):
    """The absolute path of a directory inside the checkout, or None when it points outside."""
    root = os.path.realpath(checkout)
    path = os.path.realpath(os.path.join(root, relative or '.'))
    return path if path == root or path.startswith(root + os.sep) else None


def run_logged(arguments, cwd, log, capture=None):
    """Run a command into the check log. With capture, keep its own output in that file as well."""
    if capture is None:
        return subprocess.run(arguments, cwd=cwd, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT).returncode
    with open(capture, 'wb') as output:
        process = subprocess.Popen(arguments, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        for chunk in iter(lambda: process.stdout.read(8192), b''):
            log.write(chunk)
            output.write(chunk)
        return process.wait()


def test_cases(junit):
    """Each test case in a JUnit file with its status: passed, failed, or skipped."""
    if not os.path.exists(junit):
        return []
    try:
        root = ElementTree.parse(junit).getroot()
    except ElementTree.ParseError:
        return []
    cases = []
    for case in root.iter('testcase'):
        status = 'passed'
        if case.find('failure') is not None or case.find('error') is not None:
            status = 'failed'
        elif case.find('skipped') is not None:
            status = 'skipped'
        cases.append({'name': case.get('name', ''), 'status': status})
    return cases


def deliverable_path(checkout, project, relative):
    """The absolute path of a project file inside the checkout, or None when it escapes."""
    if not isinstance(relative, str) or relative == '' or relative.startswith('/'):
        return None
    if not isinstance(project, str) or project in ('', '.'):
        project = ''
    elif project.startswith('/'):
        return None
    return inside(checkout, os.path.join(project, relative) if project else relative)


def commit_exists(checkout, revision):
    if not isinstance(revision, str) or revision == '' or revision.startswith('-') or any(character.isspace() for character in revision):
        return False
    return subprocess.run(['git', '-C', checkout, 'rev-parse', '--verify', '--quiet', revision + '^{commit}'],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def share_vendor(checkout, worktree, project):
    """Copy the project's installed vendor into the temporary checkout without a second install.

    The copy is a reflink when the filesystem can clone, otherwise a full copy. It is never a hardlink, so a
    Pest process in the temporary checkout cannot change the workspace's vendor files.
    """
    source_root = inside(checkout, project if isinstance(project, str) and project not in ('', '.') else '.')
    destination_root = inside(worktree, project if isinstance(project, str) and project not in ('', '.') else '.')
    if source_root is None or destination_root is None or not os.path.isdir(source := os.path.join(source_root, 'vendor')):
        return
    source_real = os.path.realpath(source)
    checkout_real = os.path.realpath(checkout)
    if source_real != checkout_real and not source_real.startswith(checkout_real + os.sep):
        return
    destination = os.path.join(destination_root, 'vendor')
    if os.path.lexists(destination):
        return
    os.makedirs(destination_root, exist_ok=True)
    if subprocess.run(['cp', '-a', '--reflink=auto', source_real, destination],
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        return
    shutil.rmtree(destination, ignore_errors=True)
    try:
        shutil.copytree(source_real, destination, symlinks=False)
    except OSError:
        shutil.rmtree(destination, ignore_errors=True)


def remove_base_checkout(checkout, scratch):
    """Remove the temporary start-commit checkout and its worktree registration."""
    checkout_real = os.path.realpath(checkout)
    scratch_real = os.path.realpath(scratch)
    if not os.path.basename(scratch_real).startswith('orbit-base-'):
        return
    if scratch_real == checkout_real or checkout_real.startswith(scratch_real + os.sep) or scratch_real.startswith(checkout_real + os.sep):
        return
    subprocess.run(['git', '-C', checkout, 'worktree', 'remove', '--force', scratch_real],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if os.path.lexists(scratch_real):
        shutil.rmtree(scratch_real, ignore_errors=True)
    subprocess.run(['git', '-C', checkout, 'worktree', 'prune'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cancelled(signum, _frame):
    """Cancellation must unwind finally blocks. The default SIGTERM action would skip them and leave the base checkout."""
    raise SystemExit(128 + signum)


def base_run(checkout, start, test, log):
    """Run the test file on the start commit with only that file taken from the working tree (ADR 0163).

    The temporary worktree is the tree under test. The task workspace is not checked out or edited, and the
    worktree is removed before this returns.
    """
    scratch = None
    try:
        source = deliverable_path(checkout, test.get('project'), test.get('file'))
        if source is None or not os.path.isfile(source) or not commit_exists(checkout, start):
            return {'base_placed': False}
        parent = os.path.dirname(os.path.realpath(checkout))
        try:
            scratch = tempfile.mkdtemp(prefix='orbit-base-', dir=parent if os.path.isdir(parent) and os.access(parent, os.W_OK) else None)
        except OSError:
            return {'base_placed': False}
        log.write(f'# orbit base checkout {scratch}\n'.encode())
        log.flush()
        if subprocess.run(['git', '-C', checkout, 'worktree', 'add', '--detach', '--quiet', scratch, start],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
            return {'base_placed': False}
        destination = deliverable_path(scratch, test.get('project'), test.get('file'))
        if destination is None:
            return {'base_placed': False}
        try:
            os.makedirs(os.path.dirname(destination), exist_ok=True)
            shutil.copyfile(source, destination)
        except OSError:
            return {'base_placed': False}
        share_vendor(checkout, scratch, test.get('project'))
        project = test.get('project') if isinstance(test.get('project'), str) and test.get('project') not in ('', '.') else '.'
        directory = inside(scratch, project)
        junit = os.path.join(TEST_RESULTS, test['id'] + '-base.xml')
        log.write(f"$ vendor/bin/pest {test['file']} --log-junit={junit}   # {test['id']} on the start commit in {project}\n".encode())
        log.flush()
        if directory is None:
            return {'base_placed': True, 'base_exit_code': 127}
        exit_code = run_logged(['bash', '-lc', 'exec vendor/bin/pest "$1" --log-junit="$2"', 'pest', test['file'], junit], directory, log)
        if not os.path.isfile(junit):
            return {'base_placed': True, 'base_exit_code': exit_code}
        return {'base_placed': True, 'base_exit_code': exit_code, 'base_cases': test_cases(junit)}
    finally:
        if scratch is not None:
            remove_base_checkout(checkout, scratch)


def diff(checkout, start_commit, tree):
    """The subtask's diff from its start commit to the checked tree, as paths with their Git status."""
    try:
        lines = git(checkout, 'diff-tree', '-r', '--no-renames', '--name-status', start_commit, tree).splitlines()
    except subprocess.CalledProcessError:
        return None
    entries = []
    for line in lines:
        status, _, path = line.partition('\t')
        if path:
            entries.append({'status': status[:1], 'path': path})
    return entries


def verify_deliverables(checkout, tree, deliverables, log):
    """Record the evidence for a subtask's deliverables (ADR 0133). Test files run by path, so Pest never replays them."""
    with open(deliverables) as source:
        spec = json.load(source)
    evidence = {'start': spec.get('start'), 'diff': None, 'tests': {}, 'commands': {}}
    if spec.get('start'):
        evidence['diff'] = diff(checkout, spec['start'], tree)
    shutil.rmtree(TEST_RESULTS, ignore_errors=True)
    os.makedirs(TEST_RESULTS, exist_ok=True)
    for test in spec.get('tests', []):
        # The base run is first, and it is gone before the working-tree run, so that run still sees the implementer's tree.
        base = base_run(checkout, spec.get('start'), test, log) if test.get('fails_on_base') is True else None
        directory = inside(checkout, test.get('project'))
        junit = os.path.join(TEST_RESULTS, test['id'] + '.xml')
        log.write(f"$ vendor/bin/pest {test['file']} --log-junit={junit}   # {test['id']} in {test.get('project') or '.'}\n".encode())
        log.flush()
        if directory is None:
            result = {'exit_code': 127, 'cases': []}
        else:
            exit_code = run_logged(['bash', '-lc', 'exec vendor/bin/pest "$1" --log-junit="$2"', 'pest', test['file'], junit], directory, log)
            result = {'exit_code': exit_code, 'cases': test_cases(junit)}
        if base is not None:
            result.update(base)
        evidence['tests'][test['id']] = result
    for command in spec.get('commands', []):
        directory = inside(checkout, command.get('directory'))
        log.write(f"$ {command['command']}   # {command['id']} in {command.get('directory') or '.'}\n".encode())
        log.flush()
        if directory is None:
            evidence['commands'][command['id']] = {'exit_code': 127, 'output': 'The directory is outside the workspace.'}
            continue
        capture = os.path.join(TEST_RESULTS, command['id'] + '.log')
        exit_code = run_logged(['bash', '-lc', command['command']], directory, log, capture)
        with open(capture, 'rb') as output:
            output.seek(0, os.SEEK_END)
            output.seek(max(0, output.tell() - COMMAND_OUTPUT_TAIL))
            tail = output.read().decode('utf-8', errors='replace')
        evidence['commands'][command['id']] = {'exit_code': exit_code, 'output': tail}
    return evidence


def run(checkout, head, tree, setup=None, deliverables=None, command='composer check'):
    signal.signal(signal.SIGTERM, cancelled)
    setup, deliverables = optional(setup), optional(deliverables)
    started_at = time.time()
    evidence = None
    failed_step = None
    exit_code = 0
    with open(LOG, 'wb') as log:
        if setup:
            failed_step, exit_code = run_setup(checkout, setup, log)
            # Setup steps install dependencies, so the tree after setup is the tree the check sees.
            tree = working_tree(checkout)
        if failed_step is None and command:
            log.write(f"$ {command}\n".encode())
            log.flush()
            exit_code = subprocess.run(['bash', '-lc', command], cwd=checkout, stdin=subprocess.DEVNULL,
                                       stdout=log, stderr=subprocess.STDOUT).returncode
        if failed_step is None and exit_code == 0 and deliverables:
            evidence = verify_deliverables(checkout, tree, deliverables, log)
    head_after = git(checkout, 'rev-parse', 'HEAD')
    tree_after = working_tree(checkout)
    result = {
        'exit_code': exit_code,
        'failed_step': failed_step,
        'head_before': head,
        'tree_before': tree,
        'head_after': head_after,
        'tree_after': tree_after,
        'changed_paths': changed_paths(checkout, tree, tree_after),
        'deliverables': evidence,
        'started_at': started_at,
        'finished_at': time.time(),
    }
    temporary = RESULT + '.' + str(os.getpid())
    with open(temporary, 'w') as output:
        json.dump(result, output)
    os.replace(temporary, RESULT)


def output_tail():
    if not os.path.exists(LOG):
        return ''
    with open(LOG, 'rb') as log:
        log.seek(0, os.SEEK_END)
        log.seek(max(0, log.tell() - OUTPUT_TAIL))
        return log.read().decode('utf-8', errors='replace')


def status(pid, started):
    # Read liveness before the result: the check writes check.json before it exits, so a check that
    # finishes between the two reads is still running on the first and finished on the second.
    alive = process_started(pid) == started
    if os.path.exists(RESULT):
        with open(RESULT) as result:
            print(json.dumps({'state': 'finished', 'result': json.load(result), 'output': output_tail()}))
    elif alive:
        print(json.dumps({'state': 'running'}))
    else:
        print(json.dumps({'state': 'lost', 'output': output_tail()}))


def cancel(pid, started):
    if process_started(pid) != started:
        print(json.dumps({'cancelled': False}))
        return
    try:
        os.killpg(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    print(json.dumps({'cancelled': True}))


def optional_rev(checkout, revision):
    result = subprocess.run(['git', '-C', checkout, 'rev-parse', '--verify', '--quiet', revision], capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else ''


def snapshot(checkout):
    """HEAD, its parent and tree, and the working-tree hash, read again without copying an earlier check row."""
    print(json.dumps({
        'head': git(checkout, 'rev-parse', 'HEAD'),
        'tree': working_tree(checkout),
        'parent': optional_rev(checkout, 'HEAD^'),
        'commit_tree': git(checkout, 'rev-parse', 'HEAD^{tree}'),
    }))


def main(arguments):
    command = arguments[0] if arguments else ''
    if command == 'start' and len(arguments) in (2, 3, 4, 5):
        start(*arguments[1:])
    elif command == 'run' and len(arguments) in (4, 5, 6, 7):
        run(*arguments[1:])
    elif command == 'status' and len(arguments) == 3:
        status(int(arguments[1]), arguments[2])
    elif command == 'cancel' and len(arguments) == 3:
        cancel(int(arguments[1]), arguments[2])
    elif command == 'snapshot' and len(arguments) == 2:
        snapshot(arguments[1])
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
