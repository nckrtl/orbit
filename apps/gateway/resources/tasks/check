#!/usr/bin/env python3
"""Orbit task check (ADR 0125). The Gateway installs this script in .git/orbit/ and runs it over SSH.

check start CHECKOUT [SETUP|-] [DELIVERABLES|-] [COMMAND]
                                start the Project task check detached; print the process and the tree it checks.
                                SETUP is a JSON file of setup steps to run first: [{"name", "command", "timeout_seconds"}]
                                DELIVERABLES is a JSON file of the subtask's deliverables to verify after a passing check
                                (ADR 0133): {"start", "commands": [{"id", "command", "directory", "fails_on_base", "paths"}]}
                                A command with fails_on_base runs on the start commit with its paths overlaid, then on the working tree (ADR 0163).
                                The base tree is a temporary archive under .git/orbit/bases/, not a registered worktree. The base run stops after 600 seconds.
                                COMMAND is a file with the Project's task check command. An empty file, or no COMMAND, runs no command.
check run CHECKOUT HEAD TREE [SETUP|-] [DELIVERABLES|-] [COMMAND]
                                run the setup steps and the command, then write check.json (started by `start`).
                                Invalid command deliverables fail before that command. An unexpected error still writes check.json.
check status PID STARTED        print running, finished (with the result), or lost
check cancel PID STARTED        stop the check's process group
check snapshot CHECKOUT         print HEAD, its parent, its tree, and the working-tree hash, without touching the index

The detached `run` process removes its allocated TMPDIR when it ends, including on INT, TERM, HUP, or cancel.
It only removes a non-empty directory it owns that sits directly under the host temp root and matches
`orbit-check-<euid>-*`. A leftover after SIGKILL is removed when status sees the process is gone. A cleanup
failure does not change the check's exit status. Status and snapshot keep working until the check finishes.

The check runs as the managed user. When ORBIT_TASK_WORKER_USER names an account on the Node, `run` grants that worker
and the managed user rwX on every checkout entry the managed user owns, as workspace inspection does, before it writes
check.json. .git/config and .git/hooks keep their ACLs. Directories the managed user cannot enter are skipped.
Before setup and the command, `run` does the reverse as the worker, through `sudo -n -u WORKER`: it grants the managed
user rwX on every entry the worker owns, so the check can replace what an agent's build or install created.
"""

import atexit
import json
import os
import pwd
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
import traceback
import xml.etree.ElementTree as ElementTree

DIRECTORY = os.path.dirname(os.path.abspath(__file__))
RESULT = os.path.join(DIRECTORY, 'check.json')
LOG = os.path.join(DIRECTORY, 'check.log')
OUTPUT_TAIL = 16384
COMMAND_OUTPUT_TAIL = 4096
DELIVERABLE_RESULTS = os.path.join(DIRECTORY, 'deliverables')
# The Gateway reads these failed_step values. invalid_deliverable asks for assistance with the log's messages.
INVALID_DELIVERABLE = 'invalid_deliverable'
CHECK_ERROR = 'check_error'
WORKER_ENVIRONMENT = 'ORBIT_TASK_WORKER_USER'
CHECK_TMPDIR_PREFIX = 'orbit-check-{uid}-'
TMPDIR_RECORD = os.path.join(DIRECTORY, 'check-tmpdir')


def system_temp_roots():
    """Resolved host temp roots. Ignore a process TMPDIR so a check root is not its own parent."""
    roots = {os.path.realpath('/tmp')}
    saved = os.environ.pop('TMPDIR', None)
    try:
        roots.add(os.path.realpath(tempfile.gettempdir()))
    finally:
        if saved is not None:
            os.environ['TMPDIR'] = saved
    return roots


def allocated_check_tmpdir(path):
    """The real allocated check TMPDIR, or None when $path is not this check's directory."""
    if not isinstance(path, str) or path == '' or not path.startswith('/'):
        return None
    prefix = CHECK_TMPDIR_PREFIX.format(uid=os.geteuid())
    given = os.path.basename(os.path.normpath(path))
    if not given.startswith(prefix) or given == prefix:
        return None
    try:
        candidate = os.path.realpath(path)
    except OSError:
        return None
    parent = os.path.dirname(candidate)
    name = os.path.basename(candidate)
    if parent not in system_temp_roots() or not name.startswith(prefix) or name == prefix:
        return None
    try:
        details = os.lstat(candidate)
    except OSError:
        return None
    if not stat.S_ISDIR(details.st_mode) or details.st_uid != os.geteuid():
        return None
    return candidate


def remove_allocated_check_tmpdir(path=None):
    """Remove this check's allocated TMPDIR. Never raise; a failure does not change the check status."""
    try:
        target = allocated_check_tmpdir(os.environ.get('TMPDIR', '') if path is None else path)
        if target is None:
            return False
        shutil.rmtree(target, ignore_errors=True)
        return not os.path.lexists(target)
    except Exception:
        return False


def _release_allocated_tmpdir():
    try:
        remove_allocated_check_tmpdir()
    finally:
        try:
            os.remove(TMPDIR_RECORD)
        except OSError:
            pass


def record_allocated_tmpdir():
    path = os.environ.get('TMPDIR', '')
    if allocated_check_tmpdir(path) is None:
        return
    with open(TMPDIR_RECORD, 'w') as output:
        output.write(path)


def remove_recorded_check_tmpdir():
    """Remove a leftover allocated TMPDIR after the check process is already gone."""
    try:
        with open(TMPDIR_RECORD) as source:
            path = source.read().strip()
    except OSError:
        return False
    removed = remove_allocated_check_tmpdir(path)
    try:
        os.remove(TMPDIR_RECORD)
    except OSError:
        pass
    return removed


def git_arguments(checkout, *arguments):
    return ['git', '-c', 'core.hooksPath=/dev/null', '-c', 'core.fsmonitor=false', '-c', 'safe.directory=' + checkout, '-C', checkout, *arguments]


def git(checkout, *arguments, environment=None):
    return subprocess.check_output(git_arguments(checkout, *arguments), env=environment, text=True,
                                   stderr=subprocess.DEVNULL).strip()


def working_tree(checkout):
    """The tree of the whole working tree, uncommitted and untracked files included, without touching the index."""
    index = git(checkout, 'rev-parse', '--path-format=absolute', '--git-path', 'index')
    with tempfile.TemporaryDirectory(prefix='orbit-check-') as scratch:
        candidate = os.path.join(scratch, 'index')
        if os.path.exists(index):
            shutil.copyfile(index, candidate)
        environment = {**os.environ, 'GIT_INDEX_FILE': candidate}
        subprocess.run(git_arguments(checkout, 'add', '--all'), env=environment, check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return git(checkout, 'write-tree', environment=environment)


def changed_paths(checkout, before, after):
    if before == after:
        return []
    return git(checkout, 'diff-tree', '-r', '--name-only', before, after).splitlines()


def process_started(pid):
    """The process start time as ps reports it, or None when the process does not exist."""
    result = subprocess.run(['ps', '-o', 'lstart=', '-p', str(pid)], capture_output=True, text=True)
    started = result.stdout.strip()
    return started if result.returncode == 0 and started else None


def optional(path):
    return path if path and path != '-' else None


def start(checkout, setup=None, deliverables=None, command=None):
    retire_stale_base_directories()
    setup, deliverables = optional(setup), optional(deliverables)
    if command:
        with open(command) as source:
            command = source.read()
    else:
        command = ''
    head = git(checkout, 'rev-parse', 'HEAD')
    tree = working_tree(checkout)
    for path in (RESULT, LOG):
        if os.path.exists(path):
            os.remove(path)
    pid = os.fork()
    if pid == 0:
        os.setsid()
        null = os.open(os.devnull, os.O_RDWR)
        for descriptor in (0, 1, 2):
            os.dup2(null, descriptor)
        os.execv(sys.executable, [sys.executable, os.path.abspath(__file__), 'run', checkout, head, tree, setup or '-', deliverables or '-', command])
    for _ in range(50):
        started = process_started(pid)
        if started:
            break
        time.sleep(0.02)
    print(json.dumps({'pid': pid, 'started': started, 'head': head, 'tree': tree}))


def run_setup(checkout, setup, log):
    """Run each setup step in order. Return the name and exit code of the first step that fails."""
    with open(setup) as steps:
        for step in json.load(steps):
            log.write(f"$ {step['command']}\n".encode())
            log.flush()
            try:
                exit_code = subprocess.run(['bash', '-lc', step['command']], cwd=checkout, stdin=subprocess.DEVNULL,
                                           stdout=log, stderr=subprocess.STDOUT,
                                           timeout=step.get('timeout_seconds') or None).returncode
            except subprocess.TimeoutExpired:
                log.write(f"Setup step {step['name']} timed out after {step['timeout_seconds']} seconds.\n".encode())
                exit_code = 124
            if exit_code != 0:
                return step['name'], exit_code
    return None, 0


def inside(checkout, relative):
    """The absolute path of a directory inside the checkout, or None when it points outside."""
    root = os.path.realpath(checkout)
    path = os.path.realpath(os.path.join(root, relative or '.'))
    return path if path == root or path.startswith(root + os.sep) else None


def run_logged(arguments, cwd, log, capture=None):
    """Run a command into the check log. With capture, keep its own output in that file as well."""
    if capture is None:
        return subprocess.run(arguments, cwd=cwd, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT).returncode
    with open(capture, 'wb') as output:
        process = subprocess.Popen(arguments, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        for chunk in iter(lambda: process.stdout.read(8192), b''):
            log.write(chunk)
            output.write(chunk)
        return process.wait()


FAILURE_TAIL = 4096
BASE_RUN_TIMEOUT = 600
BASE_PROCESS = None


def deliverable_path(checkout, relative):
    """Return a safe workspace path, rejecting absolute and parent-traversal paths."""
    if not isinstance(relative, str) or relative == '' or relative.startswith('/'):
        return None
    if any(part in ('', '.', '..') for part in relative.split('/')):
        return None
    return inside(checkout, relative)


def commit_exists(checkout, revision):
    if not isinstance(revision, str) or revision == '' or revision.startswith('-') or any(character.isspace() for character in revision):
        return False
    return subprocess.run(git_arguments(checkout, 'rev-parse', '--verify', '--quiet', revision + '^{commit}'), capture_output=True).returncode == 0


def base_directories():
    return os.path.join(DIRECTORY, 'bases')


def remove_base_tree(scratch):
    shutil.rmtree(scratch, ignore_errors=True)


def retire_stale_base_directories():
    directory = base_directories()
    if not os.path.isdir(directory):
        return
    for name in os.listdir(directory):
        path = os.path.join(directory, name)
        if name.startswith('orbit-base-') and os.path.isdir(path):
            shutil.rmtree(path, ignore_errors=True)


def process_group_exists(process_group):
    try:
        os.killpg(process_group, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def stop_base_process():
    global BASE_PROCESS
    if BASE_PROCESS is None:
        return
    process = BASE_PROCESS
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    deadline = time.monotonic() + 5
    while process_group_exists(process.pid) and time.monotonic() < deadline:
        time.sleep(0.05)
    if process_group_exists(process.pid):
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    process.wait()
    BASE_PROCESS = None


def cancelled(signum, _frame):
    stop_base_process()
    raise SystemExit(128 + signum)


def extract_archive(checkout, start, scratch):
    if not commit_exists(checkout, start):
        return False
    archive = subprocess.Popen(git_arguments(checkout, 'archive', start), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    extract = subprocess.run(['tar', '-xf', '-', '-C', scratch], stdin=archive.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    archive.stdout.close()
    return archive.wait() == 0 and extract.returncode == 0


def run_base(command, cwd, log, timeout):
    """Run an overlaid command in a separate process group; timeout kills the whole command tree."""
    global BASE_PROCESS
    BASE_PROCESS = subprocess.Popen(['bash', '-lc', command], cwd=cwd, stdin=subprocess.DEVNULL,
                                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
    process = BASE_PROCESS
    try:
        output, _ = process.communicate(timeout=timeout)
        code = process.returncode
        BASE_PROCESS = None
        log.write(output)
        return code, output[-COMMAND_OUTPUT_TAIL:].decode('utf-8', errors='replace'), False
    except subprocess.TimeoutExpired as timeout_error:
        stop_base_process()
        try:
            output, _ = process.communicate()
        except (OSError, subprocess.SubprocessError):
            output = timeout_error.output or b''
        if not output:
            output = timeout_error.output or b''
        log.write(output)
        log.write(f'Base command timed out after {timeout} seconds.\n'.encode())
        return None, output[-COMMAND_OUTPUT_TAIL:].decode('utf-8', errors='replace'), True


def copy_dependencies(checkout, scratch):
    """Make installed dependency directories available to the archived base tree."""
    for root, directories, _files in os.walk(checkout):
        directories[:] = [name for name in directories if name not in {'.git', 'vendor', 'node_modules'}]
        for name in ('vendor', 'node_modules'):
            source = os.path.join(root, name)
            if not os.path.isdir(source):
                continue
            relative = os.path.relpath(source, checkout)
            destination = os.path.join(scratch, relative)
            if os.path.exists(destination):
                shutil.rmtree(destination)
            os.makedirs(os.path.dirname(destination), exist_ok=True)
            shutil.copytree(source, destination, symlinks=True, copy_function=shutil.copy2)


def base_run(checkout, start, command, log):
    """Run a command on the start commit with only its declared paths overlaid."""
    timeout = BASE_RUN_TIMEOUT
    scratch = None
    try:
        os.makedirs(base_directories(), exist_ok=True)
        scratch = tempfile.mkdtemp(prefix='orbit-base-', dir=base_directories())
        log.write(f'# orbit base tree {scratch}\n'.encode())
        log.flush()
        if not extract_archive(checkout, start, scratch):
            return {'base_started': False, 'base_exit_code': 127, 'base_output': 'Could not extract the start commit.'}
        copy_dependencies(checkout, scratch)
        for relative in command.get('paths', []):
            source = deliverable_path(checkout, relative)
            destination = deliverable_path(scratch, relative)
            if source is None or destination is None or not os.path.isfile(source) or os.path.islink(source):
                return {'base_started': False, 'base_exit_code': 127, 'base_output': f'Could not overlay path {relative}.'}
            os.makedirs(os.path.dirname(destination), exist_ok=True)
            shutil.copyfile(source, destination)
            shutil.copymode(source, destination)
        directory = inside(scratch, command.get('directory', '.'))
        if directory is None or not os.path.isdir(directory):
            return {'base_started': False, 'base_exit_code': 127, 'base_output': 'The command directory is outside the base tree.'}
        log.write(f"$ {command['command']}   # base on start commit\n".encode())
        code, output, timed_out = run_base(command['command'], directory, log, timeout)
        result = {'base_started': True, 'base_exit_code': code if code is not None else 124, 'base_output': output}
        if timed_out:
            result.update({'base_timed_out': True, 'base_timeout_seconds': timeout})
        return result
    except (OSError, subprocess.SubprocessError):
        return {'base_started': False, 'base_exit_code': 127, 'base_output': 'The base command could not be started.'}
    finally:
        if scratch is not None:
            remove_base_tree(scratch)


def diff(checkout, start_commit, tree):
    """The subtask's diff from its start commit to the checked tree, as paths with their Git status."""
    try:
        lines = git(checkout, 'diff-tree', '-r', '--no-renames', '--name-status', start_commit, tree).splitlines()
    except subprocess.CalledProcessError:
        return None
    entries = []
    for line in lines:
        status, _, path = line.partition('\t')
        if path:
            entries.append({'status': status[:1], 'path': path})
    return entries


def invalid_command_deliverables(checkout, deliverables):
    """Reject unsafe command directories or overlay paths before running the Project check."""
    if not deliverables:
        return []
    with open(deliverables) as source:
        spec = json.load(source)
    if not isinstance(spec, dict):
        raise ValueError('Deliverables must be a JSON object.')
    commands = spec.get('commands', [])
    if not isinstance(commands, list):
        raise ValueError('Deliverables commands must be a list.')
    messages = []
    for command in commands:
        if not isinstance(command, dict) or not isinstance(command.get('id'), str):
            messages.append('A command deliverable is invalid.')
            continue
        directory = command.get('directory', '.')
        if inside(checkout, directory) is None:
            messages.append(f"Deliverable {command['id']} names a directory outside the checkout.")
        if command.get('fails_on_base') is True:
            paths = command.get('paths')
            if not isinstance(paths, list) or not paths:
                messages.append(f"Deliverable {command['id']} needs paths for its base run.")
                continue
            for relative in paths:
                path = deliverable_path(checkout, relative)
                if path is None or not os.path.isfile(path) or os.path.islink(path):
                    messages.append(f"Deliverable {command['id']} names invalid overlay path {relative}.")
    return messages


def verify_deliverables(checkout, tree, deliverables, log):
    """Record diff and command evidence for every checked deliverable."""
    with open(deliverables) as source:
        spec = json.load(source)
    evidence = {'start': spec.get('start'), 'diff': None, 'commands': {}}
    if spec.get('start'):
        evidence['diff'] = diff(checkout, spec['start'], tree)
    shutil.rmtree(DELIVERABLE_RESULTS, ignore_errors=True)
    os.makedirs(DELIVERABLE_RESULTS, exist_ok=True)
    for command in spec.get('commands', []):
        directory = inside(checkout, command.get('directory', '.'))
        if directory is None or not os.path.isdir(directory):
            evidence['commands'][command['id']] = {'exit_code': 127, 'output': 'The directory is outside the workspace.'}
            continue
        log.write(f"$ {command['command']}   # {command['id']} in {command.get('directory') or '.'}\n".encode())
        log.flush()
        base = base_run(checkout, spec.get('start'), command, log) if command.get('fails_on_base') is True else {}
        capture = os.path.join(DELIVERABLE_RESULTS, command['id'] + '.log')
        exit_code = run_logged(['bash', '-lc', command['command']], directory, log, capture)
        with open(capture, 'rb') as output:
            output.seek(0, os.SEEK_END)
            output.seek(max(0, output.tell() - COMMAND_OUTPUT_TAIL))
            tail = output.read().decode('utf-8', errors='replace')
        result = {'exit_code': exit_code, 'output': tail}
        result.update(base)
        evidence['commands'][command['id']] = result
    return evidence


def share_with_worker(checkout, worker):
    """Grant the task worker what the check created, so its next turn can read and change it."""
    if not worker:
        return
    try:
        pwd.getpwnam(worker)
    except KeyError:
        return
    managed = pwd.getpwuid(os.geteuid()).pw_name
    # Default ACLs first, as inspection does, so a partial grant never leaves a directory without inheritance.
    for selection, grant in ((['-type', 'd'], f'd:u:{worker}:rwX,d:u:{managed}:rwX'),
                             (['!', '-type', 'l'], f'u:{worker}:rwX,u:{managed}:rwX')):
        # Skip directories the managed user cannot enter, such as private directories an agent or an earlier
        # worker-run gate created. Their owner keeps access, and find would otherwise fail on them.
        subprocess.run([*grant_options(os.geteuid()), *selection, '-exec', 'setfacl', '-m', grant, '--', '{}', '+'],
                       cwd=checkout, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)


def grant_options(owner):
    """Select owned checkout entries, excluding protected Git files, role-private temp directories,
    and any directory the running user cannot enter."""
    return ['find', '-P', '.', '(', '-path', './.git/config', '-o', '-path', './.git/hooks',
            '-o', '-path', './.git/orbit/tmp',
            '-o', '(', '-type', 'd', '!', '(', '-readable', '-executable', ')', ')', ')', '-prune', '-o', '-user', str(owner)]


def claim_from_worker(checkout, worker):
    """Grant the managed user write on what the worker created, so setup and the command can replace it.

    Only an entry's owner can change its ACL, so this runs as the worker. Without the grant, a directory that a
    package manager created with mode 0755 keeps an ACL mask of r-x, and the managed user cannot replace it."""
    if not worker:
        return
    try:
        worker_uid = pwd.getpwnam(worker).pw_uid
    except KeyError:
        return
    if worker_uid == os.geteuid():
        return
    managed = pwd.getpwuid(os.geteuid()).pw_name
    switch = ['sudo', '-n', '-u', worker, '-H', '--']
    if subprocess.run([*switch, 'true'], cwd=checkout, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode != 0:
        raise RuntimeError(f'The managed user cannot run commands as {worker}.')
    # Default ACLs first, as inspection does, so a partial grant never leaves a directory without inheritance.
    for selection, grant in ((['-type', 'd'], f'd:u:{worker}:rwX,d:u:{managed}:rwX'),
                             (['!', '-type', 'l'], f'u:{managed}:rwX')):
        result = subprocess.run([*switch, *grant_options(worker_uid), *selection,
                                 '-exec', 'setfacl', '-m', grant, '--', '{}', '+'],
                                cwd=checkout, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        if result.returncode != 0:
            raise RuntimeError(f'Could not grant {managed} access to the files {worker} owns: '
                               + result.stderr.decode('utf-8', errors='replace').strip()[-2000:])


def perform(checkout, head, tree, setup, deliverables, command, started_at, worker=''):
    """Run setup and the project check, then verify deliverables. Invalid command deliverables fail first."""
    evidence = None
    failed_step = None
    exit_code = 0
    claim_from_worker(checkout, worker)
    with open(LOG, 'wb') as log:
        messages = invalid_command_deliverables(checkout, deliverables)
        if messages:
            failed_step = INVALID_DELIVERABLE
            exit_code = 1
            log.write(('\n'.join(messages) + '\n').encode())
        if failed_step is None and setup:
            failed_step, exit_code = run_setup(checkout, setup, log)
            # Setup steps install dependencies, so the tree after setup is the tree the check sees.
            tree = working_tree(checkout)
        if failed_step is None and command:
            log.write(f"$ {command}\n".encode())
            log.flush()
            exit_code = subprocess.run(['bash', '-lc', command], cwd=checkout, stdin=subprocess.DEVNULL,
                                       stdout=log, stderr=subprocess.STDOUT).returncode
        if failed_step is None and exit_code == 0 and deliverables:
            evidence = verify_deliverables(checkout, tree, deliverables, log)
    head_after = git(checkout, 'rev-parse', 'HEAD')
    tree_after = working_tree(checkout)
    result = check_result(
        head, tree, head_after, tree_after, changed_paths(checkout, tree, tree_after),
        exit_code, failed_step, evidence, started_at,
    )
    share_with_worker(checkout, worker)
    write_check_result(result)


def run(checkout, head, tree, setup=None, deliverables=None, command=''):
    signal.signal(signal.SIGTERM, cancelled)
    signal.signal(signal.SIGINT, cancelled)
    signal.signal(signal.SIGHUP, cancelled)
    record_allocated_tmpdir()
    atexit.register(_release_allocated_tmpdir)
    # The worker name is for this process only, not for the commands the check runs.
    worker = os.environ.pop(WORKER_ENVIRONMENT, '')
    setup, deliverables = optional(setup), optional(deliverables)
    started_at = time.time()
    try:
        perform(checkout, head, tree, setup, deliverables, command, started_at, worker)
    except SystemExit:
        # A cancelled check writes no result, but the worker still needs what it created.
        try:
            share_with_worker(checkout, worker)
        except Exception:
            pass
        raise
    except Exception:
        fail_check(checkout, head, tree, started_at, worker)


def fail_check(checkout, head, tree, started_at, worker=''):
    """Append the traceback and write a failed result. The check must not exit without check.json."""
    error = traceback.format_exc().encode()
    try:
        with open(LOG, 'ab') as log:
            if log.tell() > 0:
                log.write(b'\n')
            log.write(error)
    except OSError:
        pass
    head_after = head
    tree_after = tree
    paths = []
    try:
        head_after = git(checkout, 'rev-parse', 'HEAD')
        tree_after = working_tree(checkout)
        paths = changed_paths(checkout, tree, tree_after)
    except Exception:
        pass
    try:
        share_with_worker(checkout, worker)
    except Exception:
        pass
    try:
        write_check_result(check_result(head, tree, head_after, tree_after, paths, 1, CHECK_ERROR, None, started_at))
    except OSError:
        pass


def check_result(head, tree, head_after, tree_after, paths, exit_code, failed_step, evidence, started_at):
    return {
        'exit_code': exit_code,
        'failed_step': failed_step,
        'head_before': head,
        'tree_before': tree,
        'head_after': head_after,
        'tree_after': tree_after,
        'changed_paths': paths,
        'deliverables': evidence,
        'started_at': started_at,
        'finished_at': time.time(),
    }


def write_check_result(result):
    temporary = RESULT + '.' + str(os.getpid())
    with open(temporary, 'w') as output:
        json.dump(result, output)
    os.replace(temporary, RESULT)


def output_tail():
    if not os.path.exists(LOG):
        return ''
    with open(LOG, 'rb') as log:
        log.seek(0, os.SEEK_END)
        log.seek(max(0, log.tell() - OUTPUT_TAIL))
        return log.read().decode('utf-8', errors='replace')


def status(pid, started):
    # Read liveness before the result: the check writes check.json before it exits, so a check that
    # finishes between the two reads is still running on the first and finished on the second.
    alive = process_started(pid) == started
    if os.path.exists(RESULT):
        with open(RESULT) as result:
            print(json.dumps({'state': 'finished', 'result': json.load(result), 'output': output_tail()}))
    elif alive:
        print(json.dumps({'state': 'running'}))
    else:
        remove_recorded_check_tmpdir()
        print(json.dumps({'state': 'lost', 'output': output_tail()}))


def cancel(pid, started):
    if process_started(pid) != started:
        remove_recorded_check_tmpdir()
        print(json.dumps({'cancelled': False}))
        return
    try:
        os.killpg(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    print(json.dumps({'cancelled': True}))


def optional_rev(checkout, revision):
    result = subprocess.run(git_arguments(checkout, 'rev-parse', '--verify', '--quiet', revision), capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else ''


def snapshot(checkout):
    """HEAD, its parent and tree, and the working-tree hash, read again without copying an earlier check row."""
    print(json.dumps({
        'head': git(checkout, 'rev-parse', 'HEAD'),
        'tree': working_tree(checkout),
        'parent': optional_rev(checkout, 'HEAD^'),
        'commit_tree': git(checkout, 'rev-parse', 'HEAD^{tree}'),
    }))


def main(arguments):
    command = arguments[0] if arguments else ''
    if command == 'start' and len(arguments) in (2, 3, 4, 5):
        start(*arguments[1:])
    elif command == 'run' and len(arguments) in (4, 5, 6, 7):
        run(*arguments[1:])
    elif command == 'status' and len(arguments) == 3:
        status(int(arguments[1]), arguments[2])
    elif command == 'cancel' and len(arguments) == 3:
        cancel(int(arguments[1]), arguments[2])
    elif command == 'snapshot' and len(arguments) == 2:
        snapshot(arguments[1])
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
