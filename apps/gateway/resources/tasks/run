#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Orbit run receipt. The Gateway installs this script and turn.json in .git/orbit/.
 * An agent ends its turn with: .git/orbit/run --outcome=OUTCOME --summary="..."
 * A blocked turn also asks the operator one specific question: --question="..."
 * The approval of the last subtask also describes the pull request:
 * --pr-summary="..." --pr-change="..." (repeat) --pr-breaking="..." (repeat, or none)
 * Each subtask deliverable in turn.json is confirmed with --deliverable=ID=evidence (repeat):
 * every deliverable for ready_for_review, and every review deliverable for approved.
 */

const OUTCOMES = [
    'implementer' => ['ready_for_review', 'blocked'],
    'reviewer' => ['approved', 'changes_requested', 'blocked'],
];

const REPEATABLE = ['pr-change', 'pr-breaking', 'deliverable'];

function refuse(string $message): never
{
    fwrite(STDERR, "orbit run: {$message}\n");
    exit(2);
}

$turn = json_decode((string) @file_get_contents(__DIR__.'/turn.json'), true);
$role = is_array($turn) ? ($turn['role'] ?? null) : null;
if (! is_string($role) || ! array_key_exists($role, OUTCOMES)) {
    refuse('Orbit has not started a turn in this workspace.');
}
$final = ($turn['final'] ?? false) === true;
$deliverables = [];
foreach (is_array($turn['deliverables'] ?? null) ? $turn['deliverables'] : [] as $deliverable) {
    if (is_array($deliverable) && is_string($deliverable['id'] ?? null)) {
        $deliverables[$deliverable['id']] = is_string($deliverable['type'] ?? null) ? $deliverable['type'] : '';
    }
}

$options = [];
$arguments = array_slice($argv, 1);
while ($arguments !== []) {
    $argument = array_shift($arguments);
    if (preg_match('/\A--(outcome|summary|question|pr-summary|pr-change|pr-breaking|deliverable)(?:=(.*))?\z/s', $argument, $match) !== 1) {
        refuse("unknown argument {$argument}.");
    }
    $name = $match[1];
    $value = array_key_exists(2, $match) ? $match[2] : array_shift($arguments);
    if (! is_string($value)) {
        refuse("--{$name} needs a value.");
    }
    if (! in_array($name, REPEATABLE, true) && array_key_exists($name, $options)) {
        refuse("pass --{$name} once.");
    }
    $value = trim($value);
    if ($value === '') {
        refuse("--{$name} cannot be empty.");
    }
    if (in_array($name, REPEATABLE, true)) {
        $options[$name][] = $value;
    } else {
        $options[$name] = $value;
    }
}

$allowed = OUTCOMES[$role];
$outcome = $options['outcome'] ?? '';
if (! in_array($outcome, $allowed, true)) {
    refuse('--outcome must be one of: '.implode(', ', $allowed).'.');
}
if (! array_key_exists('summary', $options)) {
    refuse('--summary is required.');
}
if ($outcome === 'blocked' && ! array_key_exists('question', $options)) {
    refuse('blocked needs --question with one specific question the operator can answer. If you can decide or find the answer yourself, keep working instead.');
}
if ($outcome !== 'blocked' && array_key_exists('question', $options)) {
    refuse('--question is only for --outcome=blocked.');
}

$confirmations = [];
foreach ($options['deliverable'] ?? [] as $confirmation) {
    if (preg_match('/\A([a-z0-9]+(?:-[a-z0-9]+)*)=(.*)\z/s', $confirmation, $match) !== 1) {
        refuse("--deliverable needs the form ID=evidence, such as --deliverable=export-test=\"tests/Feature/ExportTest.php\".");
    }
    [, $id, $evidence] = $match;
    if (! array_key_exists($id, $deliverables)) {
        refuse("unknown deliverable {$id}. This subtask's deliverables are: ".($deliverables === [] ? 'none' : implode(', ', array_keys($deliverables))).'.');
    }
    if (array_key_exists($id, $confirmations)) {
        refuse("confirm deliverable {$id} once.");
    }
    if (trim($evidence) === '') {
        refuse("--deliverable={$id} needs evidence after the equals sign.");
    }
    $confirmations[$id] = trim($evidence);
}
$confirms = $role === 'implementer' ? $outcome === 'ready_for_review' : $outcome === 'approved';
if (! $confirms && $confirmations !== []) {
    refuse('--deliverable is only for --outcome='.($role === 'implementer' ? 'ready_for_review' : 'approved').'.');
}
if ($confirms) {
    $required = $role === 'implementer'
        ? array_keys($deliverables)
        : array_keys(array_filter($deliverables, static fn (string $type): bool => $type === 'review'));
    $missing = array_values(array_diff($required, array_keys($confirmations)));
    if ($missing !== []) {
        refuse(($role === 'implementer' ? 'ready_for_review' : 'approved')." needs --deliverable=ID=evidence for: ".implode(', ', $missing).'. Say where or how each one is met.');
    }
}

$receipt = ['outcome' => $outcome, 'summary' => $options['summary']];
if ($confirmations !== []) {
    $receipt['deliverables'] = $confirmations;
}
if ($outcome === 'blocked') {
    $receipt['question'] = $options['question'];
}
$describesPullRequest = array_key_exists('pr-summary', $options) || array_key_exists('pr-change', $options) || array_key_exists('pr-breaking', $options);
if ($final && $role === 'reviewer' && $outcome === 'approved') {
    if (! array_key_exists('pr-summary', $options)) {
        refuse('approving the last subtask needs --pr-summary.');
    }
    if (! array_key_exists('pr-change', $options)) {
        refuse('approving the last subtask needs at least one --pr-change.');
    }
    if (! array_key_exists('pr-breaking', $options)) {
        refuse('approving the last subtask needs at least one --pr-breaking. Use --pr-breaking=none when nothing breaks.');
    }
    $breaking = $options['pr-breaking'];
    if (in_array('none', array_map(strtolower(...), $breaking), true)) {
        if (count($breaking) > 1) {
            refuse('--pr-breaking=none cannot be combined with other breaking changes.');
        }
        $breaking = [];
    }
    $receipt['pull_request'] = ['summary' => $options['pr-summary'], 'changes' => $options['pr-change'], 'breaking' => $breaking];
} elseif ($describesPullRequest) {
    refuse('--pr-summary, --pr-change, and --pr-breaking are only for approving the last subtask.');
}
$receipt['nonce'] = bin2hex(random_bytes(16));

$contents = json_encode($receipt, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR);
$temporary = __DIR__.'/run.json.'.getmypid();
if (file_put_contents($temporary, $contents."\n") === false || ! rename($temporary, __DIR__.'/run.json')) {
    @unlink($temporary);
    refuse('could not write the run receipt.');
}

fwrite(STDOUT, "Orbit recorded the run receipt ({$outcome}). End your turn now.\n");
