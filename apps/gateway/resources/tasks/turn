#!/usr/bin/env python3
"""Orbit turn receipt. The Gateway installs this command and turn.json in .git/orbit/.

An agent ends its turn with .git/orbit/turn --thread=ID --outcome=OUTCOME --summary="..."
Every required deliverable confirmation is passed as --deliverable=ID=evidence.
"""

import json
import os
import re
import secrets
import sys

OUTCOMES = {
    'implementer': {'ready_for_review', 'blocked'},
    'reviewer': {'approved', 'changes_requested', 'blocked', 'topology_requested'},
}
REVIEWER_QUESTION = {'answered', 'blocked', 'topology_requested'}
REPEATABLE = {'pr-change', 'pr-breaking', 'deliverable'}
OUTCOME_ORDER = {
    'implementer': ['ready_for_review', 'blocked'],
    'reviewer': ['approved', 'changes_requested', 'blocked', 'topology_requested'],
}
QUESTION_ORDER = ['answered', 'blocked', 'topology_requested']
CAUSES = ['brief_unclear', 'contract_gap', 'scope', 'environment', 'missed_contract']


def refuse(message):
    print(f'orbit turn: {message}', file=sys.stderr)
    raise SystemExit(2)


def main(argv):
    directory = os.path.dirname(os.path.abspath(__file__))
    try:
        with open(os.path.join(directory, 'turn.json'), encoding='utf-8') as source:
            turn = json.load(source)
    except (OSError, json.JSONDecodeError):
        turn = None
    role = turn.get('role') if isinstance(turn, dict) else None
    if role not in OUTCOMES:
        refuse('Orbit has not started a turn in this workspace.')
    final = turn.get('final') is True
    question_turn = role == 'reviewer' and (turn.get('consult') is True or turn.get('relay') is True)
    cause_required = role == 'reviewer' and turn.get('cause_required') is True
    allowed = REVIEWER_QUESTION if question_turn else OUTCOMES[role]
    order = QUESTION_ORDER if question_turn else OUTCOME_ORDER[role]
    deliverables = {}
    for item in turn.get('deliverables', []):
        if isinstance(item, dict) and isinstance(item.get('id'), str):
            deliverables[item['id']] = item.get('type', '')

    options = {}
    arguments = list(argv)
    while arguments:
        argument = arguments.pop(0)
        match = re.fullmatch(r'--(outcome|summary|question|cause|pr-summary|pr-change|pr-breaking|deliverable|thread)(?:=(.*))?', argument, re.S)
        if not match:
            refuse(f'unknown argument {argument}.')
        name, value = match.group(1), match.group(2)
        if value is None:
            if not arguments:
                refuse(f'--{name} needs a value.')
            value = arguments.pop(0)
        value = value.strip()
        if not value:
            refuse(f'--{name} cannot be empty.')
        if name in REPEATABLE:
            options.setdefault(name, []).append(value)
        elif name in options:
            refuse(f'pass --{name} once.')
        else:
            options[name] = value

    outcome = options.get('outcome', '')
    if outcome == 'topology_requested' and role == 'implementer':
        refuse('only the reviewer can request a topology. Ask the reviewer through a blocked consult.')
    if outcome == 'topology_requested' and any(key in options for key in ('question', 'cause', 'pr-summary', 'pr-change', 'pr-breaking')):
        refuse('topology_requested refuses --question, --cause, and pull request flags.')
    if outcome not in allowed:
        refuse('--outcome must be one of: ' + ', '.join(order) + '.')
    if 'summary' not in options:
        refuse('--summary is required.')
    if outcome == 'blocked' and 'question' not in options:
        refuse('blocked needs --question with one specific question the operator can answer. If you can decide or find the answer yourself, keep working instead.')
    if outcome != 'blocked' and 'question' in options:
        refuse('--question is only for --outcome=blocked.')
    needs_cause = outcome != 'topology_requested' and (outcome == 'answered' or (role == 'reviewer' and outcome == 'blocked') or cause_required)
    if needs_cause:
        if options.get('cause') not in CAUSES:
            refuse('--cause must be one of: ' + ', '.join(CAUSES) + '.')
    elif 'cause' in options:
        refuse('--cause is only for a reviewer answering or blocked, or the review after a direction resolution.')

    confirmations = {}
    for confirmation in options.get('deliverable', []):
        match = re.fullmatch(r'([a-z0-9]+(?:-[a-z0-9]+)*)=(.*)', confirmation, re.S)
        if not match:
            refuse('--deliverable needs the form ID=evidence, such as --deliverable=export-test="tests/Feature/ExportTest.php".')
        deliverable_id, evidence = match.groups()
        if deliverable_id not in deliverables:
            refuse(f"unknown deliverable {deliverable_id}. This subtask's deliverables are: " + (', '.join(deliverables) if deliverables else 'none') + '.')
        if deliverable_id in confirmations:
            refuse(f'confirm deliverable {deliverable_id} once.')
        if not evidence.strip():
            refuse(f'--deliverable={deliverable_id} needs evidence after the equals sign.')
        confirmations[deliverable_id] = evidence.strip()
    confirms = (role == 'implementer' and outcome == 'ready_for_review') or (role == 'reviewer' and outcome == 'approved')
    if not confirms and confirmations:
        refuse('--deliverable is only for --outcome=' + ('ready_for_review' if role == 'implementer' else 'approved') + '.')
    if confirms:
        required = list(deliverables) if role == 'implementer' else [key for key, kind in deliverables.items() if kind == 'review']
        missing = [key for key in required if key not in confirmations]
        if missing:
            refuse(('ready_for_review' if role == 'implementer' else 'approved') + ' needs --deliverable=ID=evidence for: ' + ', '.join(missing) + '. Say where or how each one is met.')

    thread_id = None
    if 'thread' in options:
        if not re.fullmatch(r'[1-9][0-9]*', options['thread']):
            refuse('--thread must be the Orbit thread id.')
        thread_id = int(options['thread'])

    receipt = {'outcome': outcome, 'summary': options['summary']}
    if thread_id is not None:
        receipt['thread'] = thread_id
    if confirmations:
        receipt['deliverables'] = confirmations
    if outcome == 'blocked':
        receipt['question'] = options['question']
    if 'cause' in options:
        receipt['cause'] = options['cause']
    describes_pr = any(key in options for key in ('pr-summary', 'pr-change', 'pr-breaking'))
    if final and role == 'reviewer' and outcome == 'approved':
        if 'pr-summary' not in options:
            refuse('approving the last subtask needs --pr-summary.')
        if 'pr-change' not in options:
            refuse('approving the last subtask needs at least one --pr-change.')
        if 'pr-breaking' not in options:
            refuse('approving the last subtask needs at least one --pr-breaking. Use --pr-breaking=none when nothing breaks.')
        breaking = options['pr-breaking']
        if any(item.lower() == 'none' for item in breaking):
            if len(breaking) > 1:
                refuse('--pr-breaking=none cannot be combined with other breaking changes.')
            breaking = []
        receipt['pull_request'] = {'summary': options['pr-summary'], 'changes': options['pr-change'], 'breaking': breaking}
    elif describes_pr:
        refuse('--pr-summary, --pr-change, and --pr-breaking are only for approving the last subtask.')
    receipt['nonce'] = secrets.token_hex(16)
    temporary = os.path.join(directory, f'receipt.json.{os.getpid()}')
    try:
        with open(temporary, 'w', encoding='utf-8') as output:
            json.dump(receipt, output, ensure_ascii=False, indent=2)
            output.write('\n')
        os.replace(temporary, os.path.join(directory, 'receipt.json'))
    except OSError:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        refuse('could not write the turn receipt.')
    print(f'Orbit recorded the turn receipt ({outcome}). End your turn now.')


if __name__ == '__main__':
    main(sys.argv[1:])
