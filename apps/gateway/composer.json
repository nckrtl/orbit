{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nckrtl/orbit-gateway",
    "type": "project",
    "description": "The Orbit infrastructure control plane.",
    "keywords": ["infrastructure", "laravel", "orbit"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "composer/semver": "^3.4",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-data": "^4.23"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.11",
        "laravel/boost": "^2.5",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.3",
        "spatie/guidelines-skills": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "scripts": {
        "pre-autoload-dump": "@php ../../bin/pest-setup",
        "test:affected": "vendor/bin/pest --parallel --processes=2 --tia --compact",
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php -r '$root = getenv(\"ORBIT_HOME\") ?: getenv(\"HOME\").\"/.orbit\"; is_dir($root) || mkdir($root, 0700, true); file_exists($root.\"/gateway.sqlite\") || touch($root.\"/gateway.sqlite\");'",
            "@php artisan migrate --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "check": [
            "@guidance:check",
            "@rector",
            "@format:check",
            "@analyse"
        ],
        "format": "vendor/bin/pint",
        "format:check": "vendor/bin/pint --test",
        "guidance:check": "vendor/bin/pest --no-tia --compact tests/Unit/Configuration/BoostConfigurationTest.php tests/Feature/Configuration/BoostGuidanceTest.php",
        "guidance:update": [
            "@guidance:check",
            "@php artisan boost:update --no-discover --no-interaction",
            "@guidance:check"
        ],
        "lint": "@format:check",
        "rector": "vendor/bin/rector process --dry-run --no-progress-bar",
        "test": "vendor/bin/pest --parallel --no-tia --compact",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/boost"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "rector/rector": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
