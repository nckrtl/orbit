    {
        "name": "env key lowercase",
        "input": "api_key=abc123",
        "expected": "api_key=[REDACTED]"
    },
    {
        "name": "env key mixed case with hyphen",
        "input": "Api-Key=abc",
        "expected": "Api-Key=[REDACTED]"
    },
    {
        "name": "env password",
        "input": "DB_PASSWORD=secret",
        "expected": "DB_PASSWORD=[REDACTED]"
    },
    {
