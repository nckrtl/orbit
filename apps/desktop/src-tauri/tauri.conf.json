{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Orbit",
    "version": "0.1.0",
    "identifier": "com.github.nckrtl.orbit",
    "build": {
        "beforeDevCommand": "bun run --cwd ../web dev",
        "devUrl": "http://localhost:5173",
        "frontendDist": "https://gateway.orbit"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Orbit",
                "width": 1280,
                "height": 800,
                "minWidth": 960,
                "minHeight": 600
            }
        ]
    },
    "bundle": {
        "active": true,
        "targets": ["app", "dmg"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns"
        ]
    }
}
