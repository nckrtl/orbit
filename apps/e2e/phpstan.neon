includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
    tmpDir: vendor/phpstan/cache
    parallel:
        maximumNumberOfProcesses: 2

    # Larastan checks inherited helpers against every registered subclass, even
    # when that subclass never calls the helper. Only the callers declare these
    # inputs; E2E also guards its optional worktree input with hasOption().
    # Match the exact commands, input names, files, and counts. New findings fail.
    ignoreErrors:
        -
            identifier: larastan.console.undefinedOption
            message: '#^Command "(?:topology\-snapshot:rebuild|topology\-snapshot:recover\-legacy|topology\-snapshot:refresh|topology\-snapshot:restore|topology:acquire)" does not have option "worktree"\.$#'
            path: app/Console/Commands/E2ECommand.php
            count: 5
        -
            identifier: larastan.console.undefinedArgument
            message: '#^Command "(?:topology\-snapshot:rebuild|topology\-snapshot:recover\-legacy|topology\-snapshot:refresh|topology\-snapshot:restore)" does not have argument "issue"\.$#'
            path: app/Console/Commands/E2ECommand.php
            count: 4
