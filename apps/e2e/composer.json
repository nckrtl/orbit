{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nckrtl/orbit-e2e",
    "type": "project",
    "description": "The Orbit Incus end-to-end console harness.",
    "keywords": ["infrastructure", "laravel", "orbit"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "composer/semver": "^3.4",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.47",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.5",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.3",
        "spatie/guidelines-skills": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate"
        ],
        "analyse": "vendor/bin/mago analyze app --reporting-format=medium --minimum-report-level=error",
        "check": [
            "@guidance:check",
            "@rector",
            "@test",
            "@format:check",
            "@lint",
            "@analyse"
        ],
        "format": "vendor/bin/mago format",
        "format:check": "vendor/bin/mago format --check",
        "guidance:check": "vendor/bin/pest --no-tia --compact tests/Feature/Configuration/BoostConfigurationTest.php tests/Feature/Configuration/BoostGuidanceTest.php",
        "guidance:update": [
            "@guidance:check",
            "@php artisan boost:update --no-discover --no-interaction",
            "@guidance:check"
        ],
        "lint": "vendor/bin/mago lint app tests --reporting-format=medium --minimum-report-level=error",
        "rector": "vendor/bin/rector process --no-progress-bar",
        "test": "vendor/bin/pest --parallel --no-tia --compact",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/boost"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "rector/rector": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
