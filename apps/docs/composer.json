{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nckrtl/orbit-docs",
    "description": "Console tooling for verified Orbit documentation context.",
    "keywords": ["documentation", "laravel", "librarian", "orbit"],
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "hardimpactdev/librarian": "^0.0.2",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.47",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/mago analyze app config --reporting-format=medium --minimum-report-level=error",
        "check": [
            "@guidance:check",
            "@docs:lint",
            "@rector",
            "@test",
            "@format:check",
            "@lint",
            "@analyse"
        ],
        "context": "@php artisan orbit:docs-context",
        "context:build": "@php artisan orbit:docs-index",
        "docs:lint": "@php artisan orbit:docs-lint --format=agent",
        "format": "vendor/bin/mago format",
        "format:check": "vendor/bin/mago format --check",
        "guidance:check": "vendor/bin/pest --no-tia --compact tests/Unit/RepositoryGuidanceTest.php",
        "lint": "vendor/bin/mago lint app bootstrap config tests --reporting-format=medium --minimum-report-level=error",
        "rector": "vendor/bin/rector process --no-progress-bar",
        "test": "vendor/bin/pest --parallel --no-tia --compact",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "rector/rector": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
