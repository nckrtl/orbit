{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nckrtl/orbit-docs",
    "description": "Console tooling for verified Orbit documentation context.",
    "keywords": [
        "documentation",
        "laravel",
        "librarian",
        "orbit"
    ],
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "hardimpactdev/librarian": "^0.0.2",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.11",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "nckrtl/pestphp-monorepo": "^1.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test:affected": "vendor/bin/pest --parallel --processes=2 --tia --compact",
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "check": [
            "@guidance:check",
            "@docs:lint",
            "@commands:check",
            "@rector",
            "@format:check",
            "@analyse"
        ],
        "context": "@php artisan orbit:docs-context",
        "context:build": "@php artisan orbit:docs-index",
        "commands:check": "python3 ../../bin/docs-commands --check",
        "docs:lint": "@php artisan orbit:docs-lint --format=agent --strict",
        "issue:lint": "@php artisan orbit:issue-lint",
        "format": "vendor/bin/pint",
        "format:check": "vendor/bin/pint --test",
        "guidance:check": "ORBIT_TIA_DIRECTORY=vendor/.orbit-guidance-tia vendor/bin/pest --configuration=phpunit.guidance.xml --tia --fresh --compact",
        "lint": "@format:check",
        "rector": "vendor/bin/rector process --dry-run --no-progress-bar",
        "test": "vendor/bin/pest --parallel --tia --compact",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "rector/rector": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
