{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nckrtl/orbit-cli",
    "description": "The minimal command-line client for the Orbit gateway.",
    "keywords": ["cli", "infrastructure", "laravel-zero", "orbit"],
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "laravel-zero/foundation": "^13.0",
        "laravel-zero/framework": "^13.0",
        "nckrtl/orbit-php-sdk": "dev-main"
    },
    "require-dev": {
        "larastan/larastan": "^3.11",
        "laravel/boost": "^2.5",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^5.1",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.3",
        "spatie/guidelines-skills": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/php-sdk",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "pre-autoload-dump": "@php ../../bin/pest-setup",
        "test:affected": "vendor/bin/pest --parallel --processes=2 --tia --compact",
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "check": [
            "@guidance:check",
            "@rector",
            "@format:check",
            "@analyse"
        ],
        "format": "vendor/bin/pint",
        "format:check": "vendor/bin/pint --test",
        "guidance:check": "vendor/bin/pest tests/Feature/BoostGuidanceTest.php --no-tia --compact",
        "guidance:generate": "@php orbit boost:update --no-discover --no-interaction",
        "lint": "@format:check",
        "rector": "vendor/bin/rector process --dry-run --no-progress-bar",
        "test": "vendor/bin/pest --parallel --no-tia --compact"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "rector/rector": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["orbit"]
}
