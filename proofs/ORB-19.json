{
    "setup": [
        {
            "id": "enable-metrics",
            "node": "app-dev",
            "argv": ["orbit", "metrics:enable", "app-dev", "--json"],
            "timeout_seconds": 900
        }
    ],
    "acceptance": [
        {
            "id": "grafana-datasource-migration",
            "node": "app-dev",
            "argv": ["bash", "/var/lib/orbit-e2e/proof/grafana-migration.sh"],
            "timeout_seconds": 900
        },
        {
            "id": "dashboard-orbit-folder",
            "node": "app-dev",
            "argv": ["bash", "/var/lib/orbit-e2e/proof/dashboard-folder.sh"],
            "timeout_seconds": 120
        },
        {
            "id": "container-health-start-period",
            "node": "app-dev",
            "argv": ["bash", "/var/lib/orbit-e2e/proof/health-grace.sh"],
            "timeout_seconds": 120
        },
        {
            "id": "metrics-firewall-drift-visible-read-only",
            "node": "app-dev",
            "argv": ["bash", "/var/lib/orbit-e2e/proof/firewall-drift.sh"],
            "timeout_seconds": 300
        },
        {
            "id": "explicit-metrics-repair",
            "node": "app-dev",
            "argv": ["bash", "/var/lib/orbit-e2e/proof/firewall-repair.sh"],
            "timeout_seconds": 900
        },
        {
            "id": "doctor-output-redacted",
            "node": "app-dev",
            "argv": ["bash", "/var/lib/orbit-e2e/proof/doctor-redaction.sh"],
            "timeout_seconds": 120
        }
    ],
    "mutates": true
}
