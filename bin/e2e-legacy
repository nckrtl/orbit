#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

if [[ $# -lt 1 ]]; then
    echo "usage: bin/e2e-legacy inventory|quarantine|delete|verify [options]" >&2
    exit 64
fi

action=$1
shift

case "$action" in
    inventory|quarantine|delete|verify)
        exec php "$root/apps/e2e/artisan" "legacy:$action" "$@"
        ;;
    *)
        echo "unknown legacy action: $action" >&2
        exit 64
        ;;
esac
