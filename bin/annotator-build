#!/usr/bin/env python3
"""Build the matching injection asset shipped in the Gateway's source distribution."""
import gzip
import hashlib
import json
import pathlib
import subprocess
import sys

root = pathlib.Path(__file__).resolve().parent.parent
package = root / 'packages/agent-annotation'
output = root / 'apps/gateway/resources/annotator'
check = sys.argv[1:] == ['--check']
if sys.argv[1:] and not check:
    sys.exit('usage: bin/annotator-build [--check]')
paths = [package / name for name in ('package.json', 'vite.config.ts', 'tsconfig.json', 'bun.lock')]
paths += [p for directory in ('src', 'bin') for p in (package / directory).rglob('*') if p.is_file()]
def source_digest():
    digest = hashlib.sha256()
    for path in sorted(paths):
        digest.update(path.relative_to(package).as_posix().encode() + b'\0' + path.read_bytes() + b'\0')
    return digest.hexdigest()
if check:
    try:
        manifest = json.loads((output / 'manifest.json').read_text())
        asset = (output / 'inject.js.gz').read_bytes()
        valid = manifest == {'source_sha256': source_digest(), 'asset_sha256': hashlib.sha256(asset).hexdigest()} and bool(gzip.decompress(asset))
    except (OSError, ValueError):
        valid = False
    if not valid:
        sys.exit('Gateway annotator asset is missing or stale. Run bin/annotator-build and commit its resource outputs.')
    print('Gateway annotator asset matches the package sources.')
else:
    subprocess.run(['vp', 'run', 'build'], cwd=package, check=True)
    asset = gzip.compress((package / 'dist/inject.js').read_bytes(), mtime=0)
    output.mkdir(parents=True, exist_ok=True)
    (output / 'inject.js.gz').write_bytes(asset)
    (output / 'manifest.json').write_text(json.dumps({'source_sha256': source_digest(), 'asset_sha256': hashlib.sha256(asset).hexdigest()}, indent=2) + '\n')
    print('Wrote Gateway annotator injection asset and source manifest.')
