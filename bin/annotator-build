#!/usr/bin/env python3
"""Vendor the annotation server files of the @nckrtl/annotator release that apps/web locks."""
import gzip
import hashlib
import json
import pathlib
import re
import shutil
import sys

root = pathlib.Path(__file__).resolve().parent.parent
web = root / 'apps/web'
package = web / 'node_modules/@nckrtl/annotator'
output = root / 'apps/gateway/resources/annotator'
check = sys.argv[1:] == ['--check']
if sys.argv[1:] and not check:
    sys.exit('usage: bin/annotator-build [--check]')


def locked_version():
    match = re.search(r'"@nckrtl/annotator": \["@nckrtl/annotator@([^"]+)"', (web / 'bun.lock').read_text())
    if not match:
        sys.exit('apps/web/bun.lock does not lock @nckrtl/annotator.')
    return match.group(1)


def digests(directory):
    files = [p for p in (directory / 'bin').iterdir() if p.is_file()] + [directory / 'inject.js.gz']
    return {p.relative_to(directory).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(files)}


if check:
    try:
        manifest = json.loads((output / 'manifest.json').read_text())
        valid = manifest == {'package': '@nckrtl/annotator', 'version': locked_version(), 'files': digests(output)}
        valid = valid and bool(gzip.decompress((output / 'inject.js.gz').read_bytes()))
    except (OSError, ValueError):
        valid = False
    if not valid:
        sys.exit('The vendored annotator is missing, changed, or not the version apps/web locks. Run bun install in apps/web, then bin/annotator-build, and commit its resource outputs.')
    print('Vendored annotator matches the version apps/web locks.')
else:
    installed = json.loads((package / 'package.json').read_text())['version']
    if installed != locked_version():
        sys.exit(f'apps/web has @nckrtl/annotator {installed} installed but locks {locked_version()}. Run bun install in apps/web.')
    if output.exists():
        shutil.rmtree(output)
    (output / 'bin').mkdir(parents=True)
    for path in (package / 'bin').iterdir():
        if path.is_file():
            shutil.copyfile(path, output / 'bin' / path.name)
    (output / 'inject.js.gz').write_bytes(gzip.compress((package / 'dist/inject.js').read_bytes(), mtime=0))
    manifest = {'package': '@nckrtl/annotator', 'version': installed, 'files': digests(output)}
    (output / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    print(f'Vendored @nckrtl/annotator {installed} for the Gateway.')
