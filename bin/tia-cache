#!/usr/bin/env python3
"""Seed checkouts from the main caches that main CI publishes, and refresh them through one background worker."""
import argparse
import base64
from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

PROJECTS = ('apps/cli', 'apps/docs', 'apps/gateway', 'apps/e2e', 'packages/php-sdk')
QUALITY = {
    'pint': ('pint.json', 'vendor/pint.cache'),
    'phpstan': ('phpstan.neon', 'vendor/phpstan/cache/resultCache.php'),
}
# The CI jobs that test each project on main. A failure of any of them is a correctness failure of the project.
CI_JOBS = {
    'apps/cli': ('CLI',), 'apps/docs': ('Docs',), 'apps/gateway': ('Gateway', 'Gateway privileged'),
    'apps/e2e': ('E2E',), 'packages/php-sdk': ('PHP SDK',),
}
CI_WORKFLOW = 'ci.yml'
CI_EVENTS = ('push', 'schedule', 'workflow_dispatch')
CI_RUNS = 30
CI_ARTIFACTS = 'sandbox-tia-*'
TEST_INPUTS = ('composer.lock', 'tests/Pest.php', 'phpunit.xml', 'phpunit.xml.dist')
SHA = re.compile(r'[0-9a-f]{40}|[0-9a-f]{64}')
COMMAND_TIMEOUT = 600
FAILURE_OUTPUT_LIMIT = 65536
ISOLATED_ENVIRONMENT_PREFIXES = ('APP_', 'DB_', 'ORBIT_')
ISOLATED_ENVIRONMENT_NAMES = frozenset((
    'CACHE_STORE', 'DATABASE_URL', 'QUEUE_CONNECTION', 'SESSION_DRIVER',
))
PHP_METADATA = r'''
require $argv[1].'/vendor/autoload.php';
Pest\Plugins\Tia\Storage::useDirectory($argv[1].'/.orbit-tia');
echo json_encode([
    'cache' => Pest\Plugins\Tia\Storage::tempDir($argv[1]),
    'fingerprint' => Pest\Plugins\Tia\Fingerprint::compute($argv[1]),
], JSON_THROW_ON_ERROR);
'''


class CommandFailure(RuntimeError):
    def __init__(self, message, exit_code=None):
        super().__init__(message)
        self.exit_code = exit_code


def maintenance_environment():
    environment = {
        name: value for name, value in os.environ.items()
        if name not in ISOLATED_ENVIRONMENT_NAMES
        and not name.startswith(ISOLATED_ENVIRONMENT_PREFIXES)
    }
    # An agent session that queues a refresh must not switch its commands to agent output (laravel/pao).
    environment['PAO_DISABLE'] = '1'
    return environment


def command_failure_message(command, returncode, *parts):
    output = '\n'.join(part.strip() for part in parts if part and part.strip())
    if not output:
        return f'{command[0]} exited {returncode}'
    if len(output) <= FAILURE_OUTPUT_LIMIT:
        return output
    tail = output[-FAILURE_OUTPUT_LIMIT:]
    newline = tail.find('\n')
    return tail[newline + 1:] if newline != -1 else tail


def run(root, *command):
    process = subprocess.Popen(command, cwd=root, text=True, start_new_session=True,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=maintenance_environment())
    try:
        stdout, stderr = process.communicate(timeout=COMMAND_TIMEOUT)
    except subprocess.TimeoutExpired as error:
        for termination in (signal.SIGTERM, signal.SIGKILL):
            try:
                os.killpg(process.pid, termination)
            except ProcessLookupError:
                pass
            if termination == signal.SIGTERM:
                try:
                    process.communicate(timeout=5)
                except subprocess.TimeoutExpired:
                    pass
        process.communicate()
        raise CommandFailure(f'{command[0]} timed out after {COMMAND_TIMEOUT}s') from error
    if process.returncode:
        raise CommandFailure(command_failure_message(command, process.returncode, stdout, stderr), process.returncode)
    return stdout.strip()


def git(root, *args):
    return run(root, 'git', *args)


def blob(repository, commit, path):
    """Return a file's bytes at a commit, or None when the commit has no such file."""
    result = subprocess.run(['git', '-C', str(repository), 'cat-file', 'blob', f'{commit}:{path}'],
                            capture_output=True)
    return result.stdout if result.returncode == 0 else None


def common_directory(repository):
    return Path(git(repository, 'rev-parse', '--path-format=absolute', '--git-common-dir'))


def cache_store(common):
    return common / 'orbit-tia/v1'


def origin_key(root):
    """Name one repository across all its local clones by its normalized origin URL."""
    url = git(root, 'remote', 'get-url', 'origin')
    match = re.fullmatch(r'(?:[a-z][a-z0-9+.-]*://)?(?:[^@/]+@)?([^:/]+)[:/](.+?)(?:\.git)?/*', url, re.IGNORECASE)
    return digest((f'{match.group(1).lower()}/{match.group(2)}' if match else url).encode())


def registry_path(root):
    state = os.environ.get('XDG_STATE_HOME') or str(Path.home() / '.local/state')
    return Path(state) / 'orbit/main-cache-stores' / origin_key(root)


def has_publications(store):
    return (store / 'published').is_dir() or (store / 'quality').is_dir()


def register_store(root, store, force=False):
    """Let independent clones of the same origin on this machine seed from this store."""
    link = registry_path(root)
    store = store.resolve()
    try:
        current = link.resolve(strict=True)
    except (OSError, RuntimeError):
        current = None
    if current == store or (current is not None and has_publications(current) and not force):
        # The first live store keeps the registration, so a short-lived clone cannot take it over.
        return False
    link.parent.mkdir(parents=True, exist_ok=True)
    temporary = link.with_name(f'.{link.name}.{os.getpid()}')
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(store)
    os.replace(temporary, link)
    return True


def seed_store(root, common):
    """Choose where a checkout seeds from: the explicit store, its own Git store, or its origin's registered store."""
    explicit = os.environ.get('ORBIT_MAIN_CACHE_STORE')
    if explicit:
        return Path(explicit), False
    own = cache_store(common)
    if has_publications(own):
        return own, False
    try:
        registered = registry_path(root).resolve(strict=True)
    except (OSError, RuntimeError):
        return own, False
    return (registered, True) if has_publications(registered) else (own, False)


def store_common(store):
    """Return the Git common directory that owns a store under orbit-tia/v1."""
    common = store.parent.parent
    if store != cache_store(common) or not (common / 'HEAD').is_file():
        raise ValueError(f'{store} is not a repository cache store.')
    return common


def digest(data):
    return hashlib.sha256(data).hexdigest()


def atomic_write(path, data, replace=True):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as stream:
            temporary = Path(stream.name)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        if replace:
            os.replace(temporary, path)
        else:
            # A concurrent seed or a first Pest run must win over this copy.
            os.link(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def runner_identity(lock, bootstrap):
    return digest(lock + bootstrap)


def metadata(root, project):
    data = json.loads(run(root, 'php', '-r', PHP_METADATA, str(root / project)))
    data['runner'] = runner_identity((root / project / 'composer.lock').read_bytes(),
                                     (root / project / 'tests/Pest.php').read_bytes())
    return data


def require_ancestor(root, ancestor, head):
    if not isinstance(ancestor, str) or not SHA.fullmatch(ancestor):
        raise ValueError('Invalid baseline commit.')
    git(root, 'merge-base', '--is-ancestor', ancestor, head)


def validate_graph(root, graph_text, info, tested_commit):
    graph = json.loads(graph_text)
    if not isinstance(graph, dict) or graph.get('schema') != 1 or graph.get('fingerprint') != info['fingerprint']:
        raise ValueError('Graph schema or fingerprint differs.')
    baselines = graph.get('baselines', {})
    if not isinstance(baselines, dict) or set(baselines) != {'main'}:
        raise ValueError('Only a main baseline can be published.')
    main = baselines['main']
    if (not isinstance(main, dict) or main.get('tree') not in ({}, [])
            or not isinstance(main.get('results'), dict) or not main['results']
            or not isinstance(graph.get('edges'), dict) or not graph['edges']):
        raise ValueError('Main graph has no recorded coverage/results or contains working edits.')
    if any(not isinstance(result, dict) or result.get('status') not in range(7)
           for result in main['results'].values()):
        raise ValueError('Main graph contains failed or unknown results.')
    require_ancestor(root, main.get('sha'), tested_commit)
    files = graph.get('files', [])
    if not isinstance(files, (dict, list)):
        raise ValueError('Graph file list is invalid.')
    paths = list(files.values() if isinstance(files, dict) else files) + list(graph['edges'])
    paths += [result['file'] for result in main['results'].values() if 'file' in result]
    if any(not isinstance(path, str) or Path(path).is_absolute() or '..' in Path(path).parts
           for path in paths):
        raise ValueError('Graph contains nonportable paths.')
    return main['sha']


def publication_path(store, project):
    return store / 'published' / (project.replace('/', '-') + '.json')


def artifact_file(artifact, name):
    path = artifact / name
    if path.is_symlink() or not path.is_file():
        raise ValueError(f'The CI artifact has no regular {name}.')
    return path.read_bytes()


def read_artifact(project, artifact, commit, inputs):
    """Check an extracted main CI artifact against the tested commit and the expected test configuration."""
    manifest = json.loads(artifact_file(artifact, 'manifest.json'))
    if (not isinstance(manifest, dict) or manifest.get('schema') != 1
            or manifest.get('project') != project or manifest.get('commit') != commit
            or not re.fullmatch(r'[1-9][0-9]*', str(manifest.get('run_id', '')))):
        raise ValueError('The CI baseline identity differs.')
    if not inputs or manifest.get('inputs') != inputs:
        raise ValueError('The CI baseline test configuration differs.')
    graph = artifact_file(artifact, 'graph.json')
    if manifest.get('graph_sha256') != digest(graph):
        raise ValueError('The CI baseline checksum differs.')
    return manifest, graph


def import_ci(root, project, artifact, commit):
    """Seed a checkout's private graph from an extracted main CI artifact, without publishing it."""
    if project not in PROJECTS:
        raise ValueError('Unknown baseline project.')
    require_ancestor(root, commit, git(root, 'rev-parse', 'HEAD'))
    inputs = {name: digest((root / project / name).read_bytes())
              for name in TEST_INPUTS if (root / project / name).is_file()}
    _, graph = read_artifact(project, artifact, commit, inputs)
    info = metadata(root, project)
    if validate_graph(root, graph.decode(), info, commit) != commit:
        raise ValueError('The CI graph does not describe the tested commit.')
    destination = root / project / '.orbit-tia'
    if destination.is_symlink() or destination.resolve() != destination:
        raise ValueError('The private baseline directory is not canonical.')
    destination.mkdir(mode=0o700, exist_ok=True)
    try:
        atomic_write(destination / 'graph.json', graph, replace=False)
    except FileExistsError:
        print(f'[{project}] kept existing private graph', flush=True)
        return False
    print(f'[{project}] imported CI baseline {commit}', flush=True)
    return True


def read_publication(store, project):
    snapshot = json.loads(publication_path(store, project).read_text())
    if not isinstance(snapshot, dict) or not isinstance(snapshot.get('graph'), str):
        raise ValueError('Invalid publication.')
    return snapshot


def compatible(root, project, snapshot, info):
    if snapshot.get('schema') != 1 or snapshot.get('project') != project:
        raise ValueError('Publication belongs to another schema or project.')
    if snapshot.get('runner') != info['runner'] or snapshot.get('fingerprint') != info['fingerprint']:
        raise ValueError('Dependencies, runtime, or test configuration differ.')
    if digest(snapshot['graph'].encode()) != snapshot['sha256']:
        raise ValueError('Publication checksum differs.')
    require_ancestor(root, snapshot['tested_commit'], 'HEAD')
    validate_graph(root, snapshot['graph'], info, snapshot['tested_commit'])


def seed(root, store, projects):
    for project in projects:
        try:
            info = metadata(root, project)
            destination = Path(info['cache']) / 'graph.json'
            if destination.exists() or destination.is_symlink():
                print(f'[{project}] kept existing private cache', flush=True)
                continue
            snapshot = read_publication(store, project)
            compatible(root, project, snapshot, info)
            atomic_write(destination, snapshot['graph'].encode(), replace=False)
            print(f'[{project}] seeded main {snapshot["tested_commit"][:12]} -> {destination}', flush=True)
        except (RuntimeError, OSError, ValueError, KeyError, TypeError) as error:
            print(f'[{project}] cache not seeded: {error}', flush=True)


def is_ancestor(repository, ancestor, descendant):
    return subprocess.run(['git', '-C', str(repository), 'merge-base', '--is-ancestor', ancestor, descendant],
                          capture_output=True).returncode == 0


def request_refresh(root, store):
    """Queue an import for a store that lags this checkout's main, without retrying a failed target."""
    target = known_main(common_directory(root))
    if target is None:
        return
    common = store_common(store)
    results = load_requests(store).get('results', {})
    lagging = []
    for project in PROJECTS:
        try:
            tested = read_publication(store, project)['tested_commit']
        except (OSError, ValueError, KeyError, TypeError):
            tested = None
        if tested is not None and (tested == target or not is_ancestor(root, tested, target)):
            continue
        result = results.get(project, {})
        if not result.get('success', True) and (result.get('commit') == target
                                               or is_ancestor(common, target, result.get('commit', ''))):
            continue
        lagging.append(project)
    if lagging:
        print(f'Registered main caches lag {target[:12]}: {", ".join(lagging)}', flush=True)
        start_background(common, store, lagging)


def quality_path(store, project, tool):
    return store / 'quality' / project.replace('/', '-') / (tool + '.json')


def quality_data(snapshot, project, tool):
    if snapshot.get('schema') != 1 or snapshot.get('project') != project or snapshot.get('tool') != tool:
        raise ValueError('Quality publication belongs to another project or tool.')
    data = base64.b64decode(snapshot['data'], validate=True)
    if not data or digest(data) != snapshot['sha256']:
        raise ValueError('Quality publication checksum differs.')
    return data


def announce(root, store):
    try:
        if register_store(root, store):
            print(f'Registered {store} for clones of this origin: {registry_path(root)}', flush=True)
    except (OSError, RuntimeError) as error:
        print(f'Main cache store not registered: {error}', file=sys.stderr, flush=True)


def newer_publication(repository, path, commit):
    """Return whether the store already holds this commit or a descendant of it."""
    try:
        previous = json.loads(path.read_text())['tested_commit']
    except FileNotFoundError:
        return False
    return previous == commit or is_ancestor(repository, commit, previous)


def publish_snapshot(root, path, snapshot):
    # Callers hold the worker lock.
    if path.exists():
        previous = json.loads(path.read_text())
        require_ancestor(root, previous['tested_commit'], snapshot['tested_commit'])
    atomic_write(path, json.dumps(snapshot).encode())


def publish_artifact(common, store, project, artifact, commit, run_id):
    """Publish one validated main CI artifact into the store. The worker runs no tests."""
    files = {name: blob(common, commit, f'{project}/{name}') for name in TEST_INPUTS}
    if files['composer.lock'] is None or files['tests/Pest.php'] is None:
        raise ValueError(f'{project} has no locked test configuration at {commit}.')
    inputs = {name: digest(data) for name, data in files.items() if data is not None}
    manifest, graph = read_artifact(project, artifact, commit, inputs)
    if str(manifest['run_id']) != str(run_id):
        raise ValueError('The CI baseline belongs to another run.')
    text = graph.decode()
    fingerprint = json.loads(text).get('fingerprint')
    if validate_graph(common, text, {'fingerprint': fingerprint}, commit) != commit:
        raise ValueError('The CI graph does not describe the tested commit.')
    published = datetime.now(timezone.utc).isoformat()
    source = {'run_id': int(run_id)}
    path = publication_path(store, project)
    if not newer_publication(common, path, commit):
        publish_snapshot(common, path, {
            'schema': 1, 'project': project, 'tested_commit': commit, 'graph_commit': commit,
            'published_at': published, 'fingerprint': fingerprint,
            'runner': runner_identity(files['composer.lock'], files['tests/Pest.php']),
            'sha256': digest(graph), 'graph': text, 'source': source,
        })
        print(f'[{project}] published main {commit[:12]} from CI run {run_id}', flush=True)
    quality = manifest.get('quality') or {}
    php = manifest.get('php')
    if not isinstance(quality, dict) or (quality and not (isinstance(php, str) and re.fullmatch(r'\d+\.\d+', php))):
        raise ValueError('The CI quality caches are invalid.')
    for tool, expected in quality.items():
        if tool not in QUALITY:
            continue
        data = artifact_file(artifact, 'quality/' + tool)
        if not data or digest(data) != expected:
            raise ValueError(f'The CI {tool} cache checksum differs.')
        configuration = blob(common, commit, f'{project}/{QUALITY[tool][0]}')
        path = quality_path(store, project, tool)
        if configuration is None or newer_publication(common, path, commit):
            continue
        # bin/worktree-cache checks the same lock file, tool configuration, and PHP minor version before it seeds.
        identity = digest(files['composer.lock'] + b'\0' + configuration + b'\0' + php.encode())
        publish_snapshot(common, path, {
            'schema': 1, 'project': project, 'tool': tool, 'tested_commit': commit, 'fingerprint': identity,
            'sha256': digest(data), 'data': base64.b64encode(data).decode(), 'published_at': published,
            'source': source,
        })
    announce(common, store)
    return commit


@contextmanager
def queue_lock(store):
    store.mkdir(parents=True, exist_ok=True)
    with (store / 'requests.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def load_requests(store):
    try:
        state = json.loads((store / 'requests.json').read_text())
    except FileNotFoundError:
        return {'schema': 1, 'generation': 0, 'pending': {}, 'results': {}, 'correctness_failures': {}}
    if (not isinstance(state, dict) or state.get('schema') != 1
            or not isinstance(state.get('pending'), dict) or not isinstance(state.get('results'), dict)
            or type(state.get('generation')) is not int
            or any(project not in PROJECTS or not isinstance(request, dict)
                   or type(request.get('generation')) is not int
                   for project, request in state['pending'].items())
            or any(project not in PROJECTS or not isinstance(result, dict)
                   for project, result in state['results'].items())):
        raise ValueError('Invalid maintenance requests; retain the file for diagnosis.')
    state.setdefault('correctness_failures', {})
    failures = state['correctness_failures']
    # tia, pint, and phpstan entries come from the local checks that earlier versions ran.
    if (not isinstance(failures, dict) or any(
            project not in PROJECTS or not isinstance(checks, dict)
            or any(tool not in ('ci', 'tia', *QUALITY) or not isinstance(check, dict)
                   or check.get('tool') != tool or check.get('kind') != 'check_failure'
                   for tool, check in checks.items()) for project, checks in failures.items())):
        raise ValueError('Invalid correctness failures; retain the file for diagnosis.')
    return state


def save_requests(store, state):
    atomic_write(store / 'requests.json', json.dumps(state).encode())


def record_outcome(state, project, outcome):
    """Only a readable CI history sets or clears a project's correctness failure."""
    if 'ci' in outcome:
        if outcome['ci'] is None:
            state['correctness_failures'].pop(project, None)
        else:
            state['correctness_failures'][project] = {'ci': outcome['ci']}
    state['results'][project] = outcome


def known_main(common):
    try:
        return git(common, 'rev-parse', '--verify', 'refs/remotes/origin/main')
    except RuntimeError:
        return None


def publications_current(store, project, commit):
    try:
        snapshot = read_publication(store, project)
        return snapshot['tested_commit'] == commit and digest(snapshot['graph'].encode()) == snapshot['sha256']
    except (OSError, RuntimeError, ValueError, KeyError, TypeError, AttributeError):
        return False


def worker_source(common):
    """Return the tool as main holds it. A checkout on another branch must never run its copy against the store."""
    source = blob(common, 'refs/remotes/origin/main', 'bin/tia-cache')
    if not source:
        raise RuntimeError('origin/main of the store repository has no bin/tia-cache to run as the worker.')
    return source


def worker_key(common):
    return digest(worker_source(common))


def enqueue(common, store, projects):
    """Caller holds requests.lock through worker launch to avoid a shutdown race."""
    state = load_requests(store)
    target = known_main(common)
    key = worker_key(common)
    state['generation'] += 1
    # Upgrade every retained request, including projects outside this invocation.
    for request in state['pending'].values():
        if request.get('worker_key') != key:
            request.update(worker_key=key, generation=state['generation'])
    for project in projects:
        # The worker fetches main itself, so a stale remote-tracking ref here only names the target.
        pending = state['pending'].get(project)
        if pending and pending.get('target') == target and pending.get('worker_key') == key:
            continue
        state['pending'][project] = {'generation': state['generation'], 'target': target, 'worker_key': key}
    save_requests(store, state)
    return state


def acquire_worker(store, blocking=False):
    lock = (store / 'refresh.lock').open('a+')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
    except BlockingIOError:
        lock.close()
        return None
    return lock


def active_worker(store):
    if not (store / 'refresh.lock').exists():
        return False
    with (store / 'refresh.lock').open('r') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
    return False


def github_repository(common):
    url = git(common, 'remote', 'get-url', 'origin')
    match = re.fullmatch(r'(?:[a-z][a-z0-9+.-]*://)?(?:[^@/]+@)?github\.com[:/]([^/]+)/([^/]+?)(?:\.git)?/*',
                         url, re.IGNORECASE)
    if not match:
        raise ValueError(f'Main caches come from GitHub Actions, but origin is not a GitHub repository: {url}')
    return f'{match.group(1)}/{match.group(2)}'


def ci_runs(common, repository):
    """Return the finished CI runs on main of this repository, the newest finished first."""
    data = json.loads(run(common, 'gh', 'api', f'repos/{repository}/actions/workflows/{CI_WORKFLOW}/runs'
                                               f'?branch=main&status=completed&per_page={CI_RUNS}'))
    runs = [item for item in data['workflow_runs']
            if item.get('event') in CI_EVENTS and item.get('head_branch') == 'main'
            and (item.get('head_repository') or {}).get('full_name') == repository
            and type(item.get('id')) is int and isinstance(item.get('head_sha'), str)
            and SHA.fullmatch(item['head_sha']) and isinstance(item.get('updated_at'), str)]
    return sorted(runs, key=lambda item: item['updated_at'], reverse=True)


def ci_jobs(common, repository, run_id):
    return json.loads(run(common, 'gh', 'api', f'repos/{repository}/actions/runs/{run_id}/jobs?per_page=100'))['jobs']


def job_result(jobs, project):
    """Return success, failure, or None when the run did not finish the project's jobs."""
    names = CI_JOBS[project]
    found = {job.get('name'): job.get('conclusion') for job in jobs if job.get('name') in names}
    failed = sorted(name for name, conclusion in found.items() if conclusion in ('failure', 'timed_out'))
    if failed:
        return 'failure', failed
    if names[0] in found and all(conclusion == 'success' for conclusion in found.values()):
        return 'success', []
    return None, []


def ci_history(common, repository, projects):
    """Find each project's newest tested main commit and the failure on main that no later success covers.

    A failure stays open until a run that finished after it passes on the same commit or a descendant. So a newer
    commit's affected-only run cannot clear a failure that a slower full run found later.
    """
    runs = ci_runs(common, repository)
    jobs = {}
    history = {}
    for project in projects:
        successes, failure = [], None
        for item in runs:
            if any(is_ancestor(common, item['head_sha'], success['head_sha']) for success in successes):
                continue
            if item['id'] not in jobs:
                jobs[item['id']] = ci_jobs(common, repository, item['id'])
            result, failed = job_result(jobs[item['id']], project)
            if result == 'success':
                successes.append(item)
            elif result == 'failure' and failure is None:
                failure = {**item, 'failed_jobs': failed}
        newest = None
        for success in successes:
            if newest is None or is_ancestor(common, newest['head_sha'], success['head_sha']):
                newest = success
        history[project] = {'success': newest, 'failure': failure}
    return history


def download_artifacts(common, repository, run_id, destination):
    destination.mkdir(parents=True)
    run(common, 'gh', 'run', 'download', str(run_id), '-R', repository, '-p', CI_ARTIFACTS, '-D', str(destination))
    return destination


def project_artifact(directory, project):
    for manifest in sorted(directory.glob('*/manifest.json')):
        try:
            if json.loads(manifest.read_text()).get('project') == project:
                return manifest.parent
        except (OSError, ValueError, AttributeError):
            continue
    raise ValueError(f'The CI run has no main cache artifact for {project}.')


def refresh_project(common, store, project, commit, repository, history, directory, downloads):
    """Record the project's CI result on main and publish its newest successful CI artifact."""
    checks = []
    outcome = {'commit': commit, 'checks': checks, 'worker_key': worker_key(common)}
    success, failure = history['success'], history['failure']
    if success is None and failure is None:
        checks.append({'tool': 'import', 'kind': 'maintenance_failure', 'exit_code': 1,
                       'error': f'No finished CI job for {project} in the newest {CI_RUNS} main runs.'})
    else:
        outcome['ci'] = None if failure is None else {
            'tool': 'ci', 'kind': 'check_failure', 'exit_code': 1, 'commit': failure['head_sha'],
            'run_id': failure['id'], 'run_url': failure.get('html_url'), 'jobs': failure['failed_jobs'],
            'error': f'{", ".join(failure["failed_jobs"])} failed on main at {failure["head_sha"][:12]}: '
                     f'{failure.get("html_url")}'}
        if failure is not None:
            checks.append(outcome['ci'])
    if success is not None:
        log = directory / (project.replace('/', '-') + '-import.log')
        try:
            if not publications_current(store, project, success['head_sha']) or any(
                    not newer_publication(common, quality_path(store, project, tool), success['head_sha'])
                    for tool in QUALITY if quality_path(store, project, tool).exists()):
                if success['id'] not in downloads:
                    downloads[success['id']] = download_artifacts(
                        common, repository, success['id'], directory / f'artifacts-{success["id"]}')
                artifact = project_artifact(downloads[success['id']], project)
                publish_artifact(common, store, project, artifact, success['head_sha'], success['id'])
            outcome['published'] = read_publication(store, project)['tested_commit']
            outcome['run_id'] = success['id']
            checks.append({'tool': 'import', 'exit_code': 0, 'run_id': success['id']})
        except (RuntimeError, OSError, ValueError, KeyError, TypeError) as error:
            log.write_text(str(error) + '\n')
            checks.append({'tool': 'import', 'kind': 'maintenance_failure', 'exit_code': 1,
                           'error': str(error), 'log': str(log), 'run_id': success['id']})
    outcome['success'] = all(check['exit_code'] == 0 for check in checks)
    return outcome


def drain(common, store, lock):
    """Drain durable generations; a crash leaves the unacknowledged batch pending."""
    failed = False
    try:
        while True:
            with queue_lock(store):
                state = load_requests(store)
                batch = state['pending'].copy()
                if not batch or any(request.get('worker_key') != worker_key(common) for request in batch.values()):
                    # Release before the queue lock: a concurrent submitter can now start a worker.
                    # Requests from an upgraded runner remain visible for its next invocation.
                    fcntl.flock(lock, fcntl.LOCK_UN)
                    return int(failed)
            directory = Path(tempfile.mkdtemp(prefix='run-', dir=store))
            commit = known_main(common)
            outcomes = {}
            try:
                git(common, 'fetch', 'origin', 'refs/heads/main:refs/remotes/origin/main')
                commit = known_main(common)
                repository = github_repository(common)
                history = ci_history(common, repository, list(batch))
                downloads = {}
                for project in batch:
                    outcomes[project] = refresh_project(common, store, project, commit, repository,
                                                        history[project], directory, downloads)
                    with queue_lock(store):
                        progress = load_requests(store)
                        record_outcome(progress, project, outcomes[project])
                        save_requests(store, progress)
            except (RuntimeError, OSError, ValueError, KeyError, TypeError) as error:
                log = directory / 'setup.log'
                log.write_text(str(error) + '\n')
                for project in batch:
                    outcomes.setdefault(project, {'commit': commit, 'success': False, 'checks': [
                        {'tool': 'setup', 'kind': 'maintenance_failure', 'exit_code': 1,
                         'error': str(error), 'log': str(log)}]})
            finally:
                # Downloaded artifacts are only inputs; the publications hold what the worker accepted.
                for artifacts in directory.glob('artifacts-*'):
                    shutil.rmtree(artifacts, ignore_errors=True)
            with queue_lock(store):
                state = load_requests(store)
                for project, request in batch.items():
                    outcome = outcomes[project]
                    record_outcome(state, project, outcome)
                    failed |= not outcome['success']
                    if state['pending'].get(project) == request:
                        del state['pending'][project]
                save_requests(store, state)
                prune_runs(store, state, directory)
            print(f'Main cache refresh at {commit}: {"FAILED" if any(not o["success"] for o in outcomes.values()) else "passed"}; logs: {directory}', flush=True)
    finally:
        lock.close()


def prune_runs(store, state, current):
    """Delete run logs that no recorded result or failure still names."""
    kept = {current.name}

    def collect(value):
        if isinstance(value, dict):
            for item in value.values():
                collect(item)
        elif isinstance(value, list):
            for item in value:
                collect(item)
        elif isinstance(value, str) and value.startswith(str(store) + os.sep):
            kept.add(Path(value).relative_to(store).parts[0])

    collect(state)
    for run in store.glob('run-*'):
        if run.name not in kept and run.is_dir() and not run.is_symlink():
            shutil.rmtree(run, ignore_errors=True)


def freeze_worker(common, store):
    """Write main's copy of the tool into the store, so the worker survives the caller and its checkout."""
    source = worker_source(common)
    runner = store / 'runners' / (digest(source) + '.py')
    atomic_write(runner, source)
    return runner


def worker_command(common, runner, lock):
    return [sys.executable, str(runner), 'work', '--repository', str(common), '--worker-fd', str(lock.fileno())]


def refresh(common, store, projects):
    with queue_lock(store):
        enqueue(common, store, projects)
    lock = acquire_worker(store, blocking=True)
    try:
        subprocess.run(worker_command(common, freeze_worker(common, store), lock), cwd=common,
                       stdin=subprocess.DEVNULL, pass_fds=(lock.fileno(),), env=maintenance_environment())
    finally:
        lock.close()
    state = load_requests(store)
    return int(any(not state['results'].get(project, {}).get('success') for project in projects))


def start_background(common, store, projects):
    with queue_lock(store):
        state = enqueue(common, store, projects)
        if not state['pending']:
            print('Main caches already published; no refresh needed.')
            return
        lock = acquire_worker(store)
        if lock is None:
            print(f'Cache request retained by active worker; log: {store / "refresh.log"}')
            return
        try:
            runner = freeze_worker(common, store)
            log = store / 'refresh.log'
            with log.open('ab') as output:
                process = subprocess.Popen(
                    worker_command(common, runner, lock), cwd=common, stdin=subprocess.DEVNULL, stdout=output,
                    stderr=subprocess.STDOUT, start_new_session=True, pass_fds=(lock.fileno(),),
                    env=maintenance_environment(),
                )
            print(f'Main cache refresh queued (pid {process.pid}); log: {log}')
        finally:
            # Do not unlock: the child inherited the same lock description.
            lock.close()


def status(common, store, remote=False):
    main = known_main(common)
    if remote:
        lines = git(common, 'ls-remote', 'origin', 'refs/heads/main').splitlines()
        if len(lines) != 1 or not re.fullmatch(r'[0-9a-f]{40,64}\s+refs/heads/main', lines[0]):
            raise RuntimeError('Remote main could not be established.')
        main = lines[0].split()[0]
    state = load_requests(store)
    active = active_worker(store)
    current = {project: bool(main) and publications_current(store, project, main) for project in PROJECTS}
    failures = {project: result for project, result in state['results'].items() if not result.get('success')}
    return {'schema': 1, 'main': main, 'worker_active': active, 'pending': state['pending'],
            'current': current, 'results': state['results'], 'failures': failures,
            'correctness_failures': state['correctness_failures'],
            'needed': not all(current.values()), 'refresh_log': str(store / 'refresh.log')}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('seed', 'refresh', 'status', 'work', 'register', 'import-ci'))
    parser.add_argument('--repository', default='.')
    parser.add_argument('--project', action='append', choices=PROJECTS)
    parser.add_argument('--background', action='store_true')
    parser.add_argument('--json', action='store_true', help='Print machine-readable maintenance status')
    parser.add_argument('--remote', action='store_true', help='Read authoritative remote main for status')
    parser.add_argument('--worker-fd', type=int, help=argparse.SUPPRESS)
    parser.add_argument('--commit', help='Tested commit of the extracted CI artifact (import-ci only)')
    parser.add_argument('--artifact', type=Path, help='Extracted successful main CI baseline (import-ci only)')
    args = parser.parse_args()
    if args.background and args.action != 'refresh':
        parser.error('--background requires refresh')
    if (args.json or args.remote) and args.action != 'status':
        parser.error('--json and --remote require status')
    if args.action == 'work' and args.worker_fd is None:
        parser.error('work requires an inherited worker lock')
    if args.action == 'import-ci':
        if args.artifact is None or args.commit is None or not args.project or len(args.project) != 1:
            parser.error('import-ci requires --artifact, --commit, and one --project')
        root = Path(git(args.repository, 'rev-parse', '--show-toplevel')).resolve()
        import_ci(root, args.project[0], args.artifact, args.commit)
        return 0
    if args.artifact is not None or args.commit is not None:
        parser.error('--artifact and --commit require import-ci')
    common = common_directory(args.repository)
    store = cache_store(common)
    projects = args.project or PROJECTS
    if args.action == 'seed':
        root = Path(git(args.repository, 'rev-parse', '--show-toplevel'))
        store, registered = seed_store(root, common)
        if registered:
            print(f'Seeding from the main cache store registered for this origin: {store}', flush=True)
        seed(root, store, projects)
        if not os.environ.get('ORBIT_MAIN_CACHE_STORE') and has_publications(store):
            try:
                request_refresh(root, store)
            except (RuntimeError, OSError, ValueError, KeyError, TypeError) as error:
                print(f'Main cache refresh not requested: {error}', flush=True)
    elif args.action == 'register':
        if not has_publications(store):
            raise ValueError(f'{store} has no main publications to register.')
        register_store(common, store, force=True)
        print(f'Registered {store} for clones of this origin: {registry_path(common)}')
    elif args.action == 'status':
        if args.json:
            print(json.dumps(status(common, store, args.remote), sort_keys=True))
            return 0
        for project in projects:
            try:
                snapshot = read_publication(store, project)
                print(json.dumps({key: value for key, value in snapshot.items() if key != 'graph'}))
            except (OSError, ValueError) as error:
                print(f'[{project}] no readable publication: {error}')
        print(f'Refresh log: {store / "refresh.log"}')
        print(json.dumps(status(common, store, args.remote), sort_keys=True))
    elif args.action == 'work':
        os.nice(10)
        return drain(common, store, os.fdopen(args.worker_fd, 'a+'))
    elif args.background:
        start_background(common, store, projects)
    else:
        return refresh(common, store, projects)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (RuntimeError, OSError, ValueError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
