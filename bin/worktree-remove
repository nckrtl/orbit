#!/usr/bin/env bash

set -euo pipefail

usage() {
    printf 'Usage: %s LINEAR-ID\n' "${0##*/}" >&2
    exit 2
}

[[ $# -eq 1 || $# -eq 2 ]] || usage
script_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

linear_id="$1"
[[ "$linear_id" =~ ^[A-Za-z]+-[0-9]+$ ]] || usage

name="${linear_id,,}"
branch="$name"
if [[ $# -eq 2 ]]; then
    # Keep old closeout callers usable while their existing worktrees finish.
    [[ "$2" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || usage
    branch="$name-$2"
else
    mapfile -t issue_branches < <(git for-each-ref --format='%(refname:short)' "refs/heads/$name" "refs/heads/$name-*")
    if [[ ${#issue_branches[@]} -gt 1 ]]; then
        printf 'More than one branch matches %s: %s\n' "$linear_id" "${issue_branches[*]}" >&2
        exit 1
    elif [[ ${#issue_branches[@]} -eq 1 ]]; then
        branch="${issue_branches[0]}"
    fi
fi
primary_root="$(git worktree list --porcelain | awk '/^worktree / && !found { print substr($0, 10); found=1 }')"
# The registered branch path wins; the configured issue directory is the fallback.
worktree="$(git worktree list --porcelain | awk -v ref="branch refs/heads/$branch" '/^worktree / { path=substr($0, 10) } $0 == ref && !found { print path; found=1 }')"
worktree_root="$(git config --path --get orbit.worktreeRoot || printf '/fast/worktrees/orbit')"
[[ -n "$worktree" ]] || worktree="$worktree_root/$name"

git fetch --prune origin

if git worktree list --porcelain | grep -Fx "worktree $worktree" >/dev/null; then
    if [[ -n "$(git -C "$worktree" status --porcelain)" ]]; then
        printf 'Worktree is dirty: %s\n' "$worktree" >&2
        exit 1
    fi

    if ! git merge-base --is-ancestor "$branch" origin/main; then
        printf 'Branch is not merged into origin/main: %s\n' "$branch" >&2
        exit 1
    fi

    proof_attempt="$worktree/.e2e/proof-attempt.json"
    proof_result="$worktree/.e2e/proof.json"
    proof_captures="$worktree/.e2e/captured-proof"
    if [[ -f "$proof_attempt" ]]; then
        if php -r '
            try {
                $attempt = json_decode(file_get_contents($argv[1]), true, 16, JSON_THROW_ON_ERROR);
            } catch (Throwable $exception) {
                fwrite(STDERR, "Cannot validate active proof state: {$exception->getMessage()}\n");
                exit(2);
            }
            if (
                ! is_array($attempt)
                || ! is_string($attempt["attempt_id"] ?? null)
                || preg_match("/\\A[0-9a-f]{32}\\z/D", $attempt["attempt_id"]) !== 1
            ) {
                fwrite(STDERR, "Cannot validate active proof state: invalid attempt identity.\n");
                exit(2);
            }
            $capture = $argv[3]."/".$attempt["attempt_id"].".json";
            if (is_file($capture)) {
                exit(0);
            }
            if (! is_file($argv[2])) {
                exit(1);
            }
            try {
                $result = json_decode(file_get_contents($argv[2]), true, 16, JSON_THROW_ON_ERROR);
            } catch (Throwable $exception) {
                fwrite(STDERR, "Cannot validate active proof state: {$exception->getMessage()}\n");
                exit(2);
            }
            if (! is_array($result)) {
                fwrite(STDERR, "Cannot validate active proof state: expected a proof-result object.\n");
                exit(2);
            }
            exit(
                ($result["status"] ?? null) === "proved"
                && ($result["attempt_id"] ?? null) === ($attempt["attempt_id"] ?? null)
                    ? 0
                    : 1
            );
        ' "$proof_attempt" "$proof_result" "$proof_captures"; then
            printf 'Active successful proof for %s must be released by verified closeout before worktree removal.\n' "$linear_id" >&2
            exit 1
        elif [[ $? -ne 1 ]]; then
            exit 1
        fi
    fi

    # Queue before removing the caller; cache maintenance must never hold cleanup.
    "$script_root/bin/tia-cache" refresh --background --repository="$primary_root" || printf 'TIA refresh could not be queued; retry bin/tia-cache refresh --background.\n' >&2

    # Closeout owns successful proof release. Only diagnosis remains releasable here.
    if [[ -f "$worktree/.e2e/proof-attempt.json" ]]; then
        printf 'Releasing the proof topology of %s\n' "$linear_id"
        "$primary_root/bin/e2e-topology" release "$linear_id" "--worktree=$worktree" --proof
    fi

    if [[ -f "$worktree/.e2e/attempt.json" ]]; then
        printf 'Releasing the discovery topology of %s\n' "$linear_id"
        "$primary_root/bin/e2e-topology" release "$linear_id" "--worktree=$worktree"
    fi

    git worktree remove "$worktree"
elif [[ -e "$worktree" ]]; then
    printf 'Path exists but is not a registered worktree: %s\n' "$worktree" >&2
    exit 1
fi

if git show-ref --verify --quiet "refs/heads/$branch"; then
    if ! git merge-base --is-ancestor "$branch" origin/main; then
        printf 'Branch is not merged into origin/main: %s\n' "$branch" >&2
        exit 1
    fi

    git branch -d "$branch"
fi

git worktree prune
printf 'Removed %s\n' "$name"
