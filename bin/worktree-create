#!/usr/bin/env bash

set -euo pipefail

usage() {
    printf 'Usage: %s LINEAR-ID [--flow=discovery|proof]\n' "${0##*/}" >&2
    exit 2
}

initialize_feature_plan() {
    local worktree="$1"
    local linear_id="$2"
    local plan="$worktree/.loop/plan.md"

    mkdir -p "$worktree/.loop/proof"

    if [[ -e "$plan" ]]; then
        return
    fi

    local selected_flow
    selected_flow=$("$script_root/bin/loop-flow" status "--worktree=$worktree")
    sed -e "s/{{ISSUE}}/${linear_id^^}/g" -e "s/{{FLOW}}/$selected_flow/g" \
        "$script_root/.agents/skills/planning-features/template.md" > "$plan"
}

[[ $# -eq 1 || $# -eq 2 ]] || usage
flow_args=()
if [[ $# -eq 2 ]]; then
    case "$2" in
        --flow=discovery|--flow=proof) flow_args=("$2") ;;
        *) usage ;;
    esac
fi
script_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

linear_id="$1"
[[ "$linear_id" =~ ^[A-Za-z]+-[0-9]+$ ]] || usage

name="${linear_id,,}"
branch="$name"
mapfile -t issue_branches < <(git for-each-ref --format='%(refname:short)' "refs/heads/$name" "refs/heads/$name-*")
if [[ ${#issue_branches[@]} -gt 1 ]]; then
    printf 'More than one branch matches %s: %s\n' "$linear_id" "${issue_branches[*]}" >&2
    exit 1
elif [[ ${#issue_branches[@]} -eq 1 ]]; then
    branch="${issue_branches[0]}"
fi
primary_root="$(git worktree list --porcelain | awk '/^worktree / && !found { print substr($0, 10); found=1 }')"
worktree_root="$(git config --path --get orbit.worktreeRoot || printf '/fast/worktrees/orbit')"
if [[ "$worktree_root" != /* ]]; then
    printf 'orbit.worktreeRoot must be an absolute path.\n' >&2
    exit 1
fi
worktree_root="$(realpath -m -- "$worktree_root")"
case "$worktree_root/" in
    "$primary_root/"*)
        printf 'orbit.worktreeRoot must be outside the primary checkout.\n' >&2
        exit 1
        ;;
esac
# Reusing a registered branch preserves existing worktrees at their original path.
worktree="$(git worktree list --porcelain | awk -v ref="branch refs/heads/$branch" '/^worktree / { path=substr($0, 10) } $0 == ref && !found { print path; found=1 }')"
[[ -n "$worktree" ]] || worktree="$worktree_root/${linear_id,,}"

if [[ -n "$(git -C "$primary_root" status --porcelain)" ]]; then
    printf 'The primary worktree must be clean.\n' >&2
    exit 1
fi

if [[ "$(git -C "$primary_root" symbolic-ref --quiet --short HEAD || true)" != main ]]; then
    printf 'The primary checkout must be on main.\n' >&2
    exit 1
fi

git fetch --prune origin
git -C "$primary_root" merge --ff-only origin/main

# Seed immediately from successful compatible publications while main catches up.
"$script_root/bin/tia-cache" refresh --background --repository="$primary_root" || printf 'Cache refresh could not be queued; compatible prior caches or cold checks will be used.\n' >&2

if git worktree list --porcelain | grep -Fx "worktree $worktree" >/dev/null; then
    if [[ -n "$(git -C "$worktree" status --porcelain)" ]]; then
        printf 'Existing worktree is dirty: %s\n' "$worktree" >&2
        exit 1
    fi

    existing_branch="$(git -C "$worktree" symbolic-ref --quiet --short HEAD || true)"
    if [[ "$existing_branch" != "$branch" ]]; then
        printf 'Existing worktree uses %s, expected %s.\n' "$existing_branch" "$branch" >&2
        exit 1
    fi

    "$script_root/bin/loop-flow" init "--worktree=$worktree" "${flow_args[@]}"
    initialize_feature_plan "$worktree" "$linear_id"
    "$worktree/bin/bootstrap"
    printf '%s\n' "$worktree"
    exit 0
fi

if [[ -e "$worktree" ]]; then
    printf 'Path exists but is not a registered worktree: %s\n' "$worktree" >&2
    exit 1
fi

mkdir -p "$worktree_root"

if git show-ref --verify --quiet "refs/heads/$branch"; then
    git worktree add "$worktree" "$branch"
elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    git worktree add --track -b "$branch" "$worktree" "origin/$branch"
else
    git worktree add -b "$branch" "$worktree" origin/main
fi

"$script_root/bin/loop-flow" init "--worktree=$worktree" "${flow_args[@]}"
initialize_feature_plan "$worktree" "$linear_id"
"$worktree/bin/bootstrap"
printf '%s\n' "$worktree"
