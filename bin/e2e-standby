#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

if [[ $# -lt 1 ]]; then
    echo "usage: bin/e2e-standby status|fingerprint|refresh|restore [options]" >&2
    exit 64
fi

action=$1
shift

case "$action" in
    status|fingerprint|refresh|restore)
        exec php "$root/apps/e2e/artisan" "standby:$action" "$@"
        ;;
    *)
        echo "unknown standby action: $action" >&2
        exit 64
        ;;
esac
