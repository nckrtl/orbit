#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

if [[ $# -lt 1 ]]; then
    cat >&2 <<'USAGE'
usage: bin/e2e-standby <action> [options]

  status                        show the promoted standby generation
  fingerprint --main-sha=SHA    compute the prepared-state fingerprint
  promote ISSUE                 make the issue's proved topology the standby generation, then release it
  refresh --main-sha=SHA        fallback: refresh the standby in place when the fingerprint changed
  restore                       restore the promoted generation and leave it stopped
  rebuild --main-sha=SHA        recovery: when exact standby resources are absent, forget stale
                                manifests and build the standby again from the base image
  recover-legacy --main-sha=SHA disaster recovery: prove ownership of present legacy resources,
                                retain evidence, and build the standby again

The standby this checkout owns comes from ORBIT_E2E_STANDBY_NAMESPACE: empty
(the repository's own standby) or `live` (the validation clone bin/e2e-live
drives). Two checkouts never share one physical standby.
USAGE
    exit 64
fi

action=$1
shift

case "$action" in
    status|fingerprint|promote|refresh|restore|rebuild|recover-legacy)
        exec php "$root/apps/e2e/artisan" "standby:$action" "$@"
        ;;
    *)
        echo "unknown standby action: $action" >&2
        exit 64
        ;;
esac
