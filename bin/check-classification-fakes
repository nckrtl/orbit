#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * @param  list<array{0: int|null, 1: string, 2: int}>  $tokens
 * @return array{namespaces: array<int, string>, imports: array<string, array<string, string>>}
 */
function classification_names(array $tokens): array
{
    $namespaces = [];
    $imports = ['' => []];
    $namespace = '';
    $namespaceDepth = 0;
    $braceDepth = 0;
    $namespaceStack = [];
    $count = count($tokens);

    for ($index = 0; $index < $count; $index++) {
        [$id, $text] = $tokens[$index];
        $namespaces[$index] = $namespace;

        if ($id === T_NAMESPACE && $braceDepth === $namespaceDepth) {
            $name = '';
            $cursor = $index + 1;
            while ($cursor < $count && ! in_array($tokens[$cursor][1], [';', '{'], true)) {
                $name .= $tokens[$cursor][1];
                $cursor++;
            }
            if ($cursor < $count) {
                if ($tokens[$cursor][1] === '{') {
                    $namespaceStack[] = [$namespace, $namespaceDepth];
                    $namespace = trim($name, "\\ ");
                    $braceDepth++;
                    $namespaceDepth = $braceDepth;
                } else {
                    $namespace = trim($name, "\\ ");
                    $namespaceDepth = $braceDepth;
                }
                $imports[strtolower($namespace)] ??= [];
                $index = $cursor;
            }

            continue;
        }

        if ($id === T_USE && $braceDepth === $namespaceDepth) {
            if (($tokens[$index - 1][1] ?? null) === ')') {
                continue;
            }

            $cursor = $index + 1;
            if (($tokens[$cursor][0] ?? null) === T_FUNCTION || ($tokens[$cursor][0] ?? null) === T_CONST) {
                while ($cursor < $count && $tokens[$cursor][1] !== ';') {
                    $cursor++;
                }
                $index = $cursor;

                continue;
            }

            $statement = '';
            while ($cursor < $count && $tokens[$cursor][1] !== ';') {
                $statement .= ($tokens[$cursor][0] ?? null) === T_AS
                    ? ' as '
                    : $tokens[$cursor][1];
                $cursor++;
            }
            classification_add_imports($imports[strtolower($namespace)], $statement);
            $index = $cursor;

            continue;
        }

        if ($text === '{') {
            $braceDepth++;

            continue;
        }

        if ($text === '}') {
            if ($namespaceStack !== [] && $braceDepth === $namespaceDepth) {
                $braceDepth--;
                [$namespace, $namespaceDepth] = array_pop($namespaceStack);
            } else {
                $braceDepth--;
            }
        }
    }

    return ['namespaces' => $namespaces, 'imports' => $imports];
}

/** @param array<string, string> $imports */
function classification_add_imports(array &$imports, string $statement): void
{
    $statement = preg_replace('/\s+/', ' ', trim($statement)) ?? trim($statement);
    $prefix = '';
    $groupStart = strpos($statement, '{');
    if ($groupStart !== false && str_ends_with($statement, '}')) {
        $prefix = rtrim(substr($statement, 0, $groupStart), "\\ ");
        $statement = substr($statement, $groupStart + 1, -1);
    }

    foreach (explode(',', $statement) as $import) {
        if (preg_match('/^\\s*(\\\\?[A-Za-z_\x80-\xff][A-Za-z0-9_\x80-\xff\\\\]*)(?:\\s+as\\s+([A-Za-z_\x80-\xff][A-Za-z0-9_\x80-\xff]*))?\\s*$/i', $import, $match) !== 1) {
            continue;
        }

        $name = trim($match[1], "\\");
        if ($prefix !== '') {
            $name = $prefix.'\\'.$name;
        }
        $lastSeparator = strrpos($name, '\\');
        $alias = $match[2] ?? ($lastSeparator === false ? $name : substr($name, $lastSeparator + 1));
        $imports[strtolower($alias)] = strtolower($name);
    }
}

/** @param array<string, string> $imports */
function classification_resolve_name(int $id, string $name, string $namespace, array $imports): string
{
    if ($id === T_NAME_FULLY_QUALIFIED) {
        return strtolower(trim($name, "\\"));
    }

    if ($id === T_NAME_RELATIVE) {
        return strtolower(trim($namespace.'\\'.substr($name, strlen('namespace\\')), "\\"));
    }

    $name = trim($name, "\\");
    $firstSeparator = strpos($name, '\\');
    $first = strtolower($firstSeparator === false ? $name : substr($name, 0, $firstSeparator));
    if (array_key_exists($first, $imports)) {
        $suffix = $firstSeparator === false ? '' : substr($name, $firstSeparator + 1);

        return strtolower($imports[$first].($suffix === '' ? '' : '\\'.$suffix));
    }

    return strtolower($namespace === '' ? $name : $namespace.'\\'.$name);
}

/** @param list<array{0: int|null, 1: string, 2: int}> $tokens */
function classification_fake_violation(string $path, array $tokens): ?string
{
    $resolved = classification_names($tokens);
    $imports = $resolved['imports'];
    $namespaces = $resolved['namespaces'];
    $count = count($tokens);

    for ($index = 0; $index < $count - 3; $index++) {
        [$id, $name, $line] = $tokens[$index];
        if (! in_array($id, [T_STRING, T_NAME_QUALIFIED, T_NAME_FULLY_QUALIFIED, T_NAME_RELATIVE], true)) {
            continue;
        }

        $namespace = $namespaces[$index] ?? '';
        $fqn = classification_resolve_name($id, $name, $namespace, $imports[strtolower($namespace)] ?? []);
        if (
            $fqn !== 'laravel\\ai\\classification'
            || ($tokens[$index + 1][0] ?? null) !== T_DOUBLE_COLON
            || ($tokens[$index + 2][0] ?? null) !== T_STRING
            || strcasecmp($tokens[$index + 2][1], 'fake') !== 0
            || ($tokens[$index + 3][1] ?? null) !== '('
        ) {
            continue;
        }

        $depth = 1;
        $cursor = $index + 4;
        while ($cursor < $count && $depth > 0) {
            if ($tokens[$cursor][1] === '(') {
                $depth++;
            } elseif ($tokens[$cursor][1] === ')') {
                $depth--;
            }
            $cursor++;
        }

        if ($depth !== 0) {
            return $path.':'.$line.': Classification::fake() has unbalanced arguments.';
        }

        $hasGuard =
            ($tokens[$cursor][0] ?? null) === T_OBJECT_OPERATOR
            && strcasecmp($tokens[$cursor + 1][1] ?? '', 'preventStrayClassifications') === 0
            && ($tokens[$cursor + 2][1] ?? null) === '('
            && ($tokens[$cursor + 3][1] ?? null) === ')';

        if (! $hasGuard) {
            return $path.':'.$line.': Classification::fake() must be chained to preventStrayClassifications().';
        }
    }

    return null;
}

/** @param list<array{0: int|null, 1: string, 2: int}> $tokens */
function classification_significant_tokens(array $tokens): array
{
    return array_values(array_filter(
        $tokens,
        static fn (array $token): bool => ! in_array($token[0], [T_WHITESPACE, T_COMMENT, T_DOC_COMMENT], true),
    ));
}

$failed = false;
foreach (array_slice($argv, 1) as $path) {
    if (! is_file($path) || pathinfo($path, PATHINFO_EXTENSION) !== 'php') {
        continue;
    }

    $source = file_get_contents($path);
    if (! is_string($source)) {
        fwrite(STDERR, "Cannot read {$path}.\n");
        $failed = true;
        continue;
    }

    $tokens = [];
    foreach (token_get_all($source) as $token) {
        if (is_array($token)) {
            [$id, $text, $line] = $token;
            $tokens[] = [$id, $text, $line];
        } else {
            $tokens[] = [null, $token, 1];
        }
    }
    $tokens = classification_significant_tokens($tokens);

    $violation = classification_fake_violation($path, $tokens);
    if ($violation !== null) {
        fwrite(STDERR, $violation."\n");
        $failed = true;
    }
}

exit($failed ? 1 : 0);
