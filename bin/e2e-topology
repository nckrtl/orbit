#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

if [[ $# -lt 1 ]]; then
    cat >&2 <<'USAGE'
usage: bin/e2e-topology <action> ISSUE [...]

  acquire ISSUE WORKTREE          fresh discovery topology on the mounted worktree
  shell   ISSUE ROLE              interactive shell as orbit on one role
  exec    ISSUE ROLE --argv=JSON  run one argv vector as orbit on one role
  sync    ISSUE                   re-verify the mounted source identity
  verify  ISSUE                   verify the live topology
  prove   ISSUE [--plan=PATH]     prove the worktree HEAD (default proofs/ISSUE.json)
  status  ISSUE                   report the live attempt from <worktree>/.e2e/
  release ISSUE                   release the live topology and sweep orphan networks

Every action except acquire finds the worktree at <primary>/.worktrees/<issue>-*
or takes --worktree=PATH. State lives in <worktree>/.e2e/.
USAGE
    exit 64
fi

action=$1
shift

case "$action" in
    acquire|shell|exec|sync|verify|prove|status|release)
        exec php "$root/apps/e2e/artisan" "topology:$action" "$@"
        ;;
    *)
        echo "unknown topology action: $action" >&2
        exit 64
        ;;
esac
