#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

if [[ $# -lt 1 ]]; then
    echo "usage: bin/e2e-topology acquire|sync|verify|exec|prove|release|status|reap [options]" >&2
    exit 64
fi

action=$1
shift

case "$action" in
    acquire|sync|verify|exec|prove|release|status|reap)
        exec php "$root/apps/e2e/artisan" "topology:$action" "$@"
        ;;
    *)
        echo "unknown topology action: $action" >&2
        exit 64
        ;;
esac
