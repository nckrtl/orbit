        responses['503'] = {'description': 'An HTML failure page with the animated Orbit mark, the stored error, and a Try again link. It does not poll.', 'content': {'text/html': {'schema': {'type': 'string'}}}}
    else:
        data, is_list = data_schema_for(route)
        if is_list:
            data = {'type': 'array', 'items': data}
        if route['name'] in ('gateway:release:deploy', 'gateway:release:rollback'):
            responses['202'] = envelope(data, 'Accepted. The release record is queued and its unit started.')
            responses['503'] = error_response('systemd did not start the release unit (`gateway.release_unit_failed`). The record ends as failed.')
        elif controllers.get(action, {}).get('created'):
            responses['201'] = envelope(data, 'Created.')
            # Development deploy step creation refuses duplicate names, including exact retries.
            if route['name'] not in ('project:dev-deploy-step:create', 'project:document:create'):
                responses['200'] = envelope(data, 'The request succeeded; an exact retry returned the existing record.')
        else:
            responses['200'] = envelope(data, 'The request succeeded.')
        if route['name'] == 'gateway:trust':
            responses['503'] = error_response('The Gateway root CA is unavailable (`ca.unavailable`).')
        if route['name'] == 'gateway:release:smoke':
            responses['500'] = error_response('Smoke printed no report (`gateway.release_smoke_failed`), ran past its limit (`gateway.release_smoke_timeout`), was killed (`gateway.release_smoke_killed`), or the current release has no `bin/gateway-smoke` (`gateway.release_smoke_missing`).')
    if route['name'].startswith('project:document:'):
        op['description'] = 'Project-scoped Documents. Requires ProjectOwning Node access. See /reference/project-documents for limits, archive inheritance, revision preconditions and retry recovery. No object keys or credentials are returned.'
        if route['name'] in ('project:document:list', 'project:document:search', 'project:document:version:list'):
            meta = responses['200']['content']['application/json']['schema']['properties']
            meta['meta'] = {'allOf': [{'$ref': '#/components/schemas/Meta'}, {'type': 'object', 'properties': {'next_cursor': {'type': ['string', 'null']}}, 'required': ['next_cursor']}]}
        if route['name'] == 'project:document:create':
            responses.pop('200', None)
            responses['201'] = envelope(ref('DocumentEntryData'), 'Created.')
    if route['name'] in ('agent:realtime', 'agent:realtime:auth', 'agent:workspaces', 'agent:log-streams'):
        responses['401'] = error_response('The request carries no agent secret (`agent.secret_required`).')
    if route['name'] in ('agent:realtime', 'agent:workspaces', 'agent:log-streams'):
        responses['403'] = error_response('The caller is not an active WireGuard peer (`peer.identity_unknown`), its agent secret does not match (`agent.secret_invalid`), or its Node is not eligible for an agent (`agent.node_ineligible`).')
    elif route['name'] == 'agent:realtime:auth':
        responses['403'] = error_response('The caller is not an active WireGuard peer (`peer.identity_unknown`), its agent secret does not match (`agent.secret_invalid`), its Node is not eligible for an agent (`agent.node_ineligible`), or it asked for another Node\'s channel (`agent.channel_forbidden`).')
    elif route['name'] not in ('gateway:status', 'gateway:trust'):
        responses['403'] = error_response('The caller is not an active WireGuard peer (`peer.identity_unknown`) or lacks Node access to the target (`node_access.required`).')
    if route['name'] == 'tool:scan':
        responses['404'] = error_response('No Node matches `node_id` (`http.404`).')
        responses['409'] = error_response('The Node is not active (`tool.node_inactive`) or is not Gateway-managed (`tool.node_unmanaged`). `error.details.step` is `scan`, `error.details.outcome` is `manager_failed`, and there is no Tool id. A manager that is absent, unsupported, conflicting, or incomplete does not fail the request.')
        responses['422'] = error_response('The query is not the one strict integer `node_id`, or the body is not empty (`validation.failed`).')
    if params and not stream and route['name'] not in INTERNAL and route['name'] not in ('extension:enable', 'extension:disable'):
        responses['404'] = error_response('No record matches the path parameters.')
    if route['method'] in ('POST', 'PUT', 'PATCH', 'DELETE') and route['name'] not in INTERNAL:
        responses['409'] = error_response('A guard refused the change and the Gateway changed nothing; `error.code` names the guard.')
    if route['name'] in ('instance:log-stream:create', 'process:log-stream:create'):
        responses['409'] = error_response('The live log path is not available (`logs.live_unavailable`); `details.reason` is `ssh_only` for a production Instance, or `realtime_not_configured`, `subscriber_down`, `agent_unavailable`, or `agent_not_joined`.')
    if route['name'] in ('instance:log-stream:renew', 'instance:log-stream:destroy', 'process:log-stream:renew', 'process:log-stream:destroy'):
        responses['404'] = error_response('The stream does not exist, has ended, belongs to another record, or was opened by another Node (`logs.stream_not_found`).')
    if route['name'] in ('tasks:list', 'tasks:show', 'tasks:question:list', 'tasks:agents', 'tasks:agent-stream'):
        responses['409'] = error_response('The tasks extension is disabled (`extension.disabled`).')
    if route['name'] == 'tasks:cancel':
        responses['409'] = error_response('The tasks extension is disabled (`extension.disabled`), or the Task group is completed or in settling or waiting_for_review with a pull request (`tasks.not_cancellable`).')
        responses['502'] = error_response('The approved commits of a settling group could not be pushed to its task branch (`tasks.push_failed`). The group and its Instance stay.')
    if route['name'] == 'tasks:subtask:cancel':
        responses['409'] = error_response('The tasks extension is disabled (`extension.disabled`) or the subtask is not running (`tasks.subtask_not_running`).')
        responses['502'] = error_response('The implementer or the running check could not be stopped (`tasks.subtask_interrupt_failed`). The subtask stays running.')
    if route['name'] == 'tasks:complete':
        responses['409'] = error_response('The tasks extension is disabled (`extension.disabled`) or the Task group is not ready to complete (`tasks.not_settling`). Running or reviewing groups need an ended watched pull request or a stored completion receipt.')
        responses['502'] = error_response('A running agent or check could not be stopped (`tasks.subtask_interrupt_failed`). The completion receipt is kept for retry; the group and its open subtasks remain open.')
    if op.get('x-orbit-extension'):
        extension_error = 'A disabled extension returns HTTP 409 (`extension.disabled`).'
        if '409' in responses:
            responses['409']['description'] += ' ' + extension_error
        else:
            responses['409'] = error_response(extension_error)
    if route['name'] == 'proxycli:models':
        responses['409'] = error_response('The collector is not set up (`proxycli.disabled`). A disabled extension returns HTTP 409 (`extension.disabled`).')
    if route['name'] in ('extension:enable', 'extension:disable'):
        responses['422'] = error_response('The extension slug is unknown (`validation.failed`).')
    if body_schema is not None or stream:
        responses['422'] = error_response('The JSON body is not an object, has duplicate or unknown members, or fails validation (`validation.failed`).')
    if route['name'] in ('tasks:definition:create', 'tasks:definition:update'):
        responses['422'] = error_response('The definition breaks a validation rule (`tasks.definition_invalid`). `details.rules` names each failing rule and the subtask key it concerns. A malformed body returns `validation.failed`.')
    if route['name'] == 'tasks:definition:create':
        responses['409'] = error_response('The Project already uses the name (`tasks.definition_exists`). A disabled extension returns HTTP 409 (`extension.disabled`).')
    if route['name'] in ('node:role:add', 'node:role:remove', 'node:role:relocate'):
        responses['502'] = error_response('A role step failed on the Node (`node_role.convergence_failed` or `node_role.remove_failed`). `error.details.step` names the failed step, and `error.details.error_code` names its own code, such as `node_role.node_busy` or `node_role.tool_manager_locked`.')
    if route['name'] in ('node:add', 'node:remove'):
        responses['502'] = error_response('A step failed on the Node; `error.details.step` names it. When a role step failed, `error.details.error_code` names that step\'s own code.')
    if route['name'] == 'node:metrics':
        responses['409'] = error_response('No Node has the Metrics role (`metrics.assignment_missing`).')
        responses['422'] = error_response('The Node is not an active, WireGuard-managed Node (`node.metrics_unavailable`).')
        responses['502'] = error_response('Grafana or Prometheus did not answer, or Prometheus has no samples for this Node, as for a Node without an enabled exporter (`node.metrics_unreachable`).')
    if route['name'].startswith('project:document:'):
        responses['404'] = error_response('Project-scoped entry or file-scoped version not found (`project_documents.not_found`); a missing Project returns `http.404`.')
        responses['422'] = error_response('Invalid fields, content encoding, names, hierarchy, query or cursor (`validation.failed`), folder content operation (`project_documents.not_file`), or content outside inline editing limits (`project_documents.not_editable`).')
        if route['method'] != 'GET':
            responses['409'] = error_response('Revision conflict (`project_documents.revision_conflict`, with entry_id and current_revision), duplicate sibling name (`project_documents.name_conflict`), archived destination (`project_documents.archived`), nonempty folder (`project_documents.folder_not_empty`), abandoned upload (`project_documents.upload_abandoned`), or unconfigured storage (`project_documents.storage_not_configured`). No automatic retry.')
        if route['name'] in ('project:document:read', 'project:document:download'):
            responses['409'] = error_response('Storage is not configured (`project_documents.storage_not_configured`); metadata remains available.')
        if route['name'] in ('project:document:create', 'project:document:write', 'project:document:read', 'project:document:download', 'project:document:restore-version'):
            responses['413'] = error_response('Decoded content or JSON request exceeds the documented limit (`project_documents.content_too_large`).')
            responses['502'] = error_response('Committed body is missing or corrupt (`project_documents.body_unavailable`); metadata is retained.')
            responses['503'] = error_response('Storage is unavailable (`project_documents.storage_unavailable`); provider diagnostics are not returned.')
    op['responses'] = responses
    request_schema = op.get('requestBody', {}).get('content', {}).get('application/json', {}).get('schema') if (stream or body_schema is not None) else None
    samples = [{'lang': 'bash', 'label': 'curl', 'source': bash_sample(route, path, request_schema, query, tag)}]
    if sdkreq:
        samples.append({'lang': 'php', 'label': 'PHP SDK', 'source': php_sample(sdkreq, stream, tag)})
    op['x-codeSamples'] = samples
    if not op['parameters']:
        op.pop('parameters')
    spec['paths'].setdefault(path, {})[method] = op
    nav_pages[tag].append(f'{route["method"]} {path}')

spec['components']['schemas'].update({k: v for k, v in components.items() if v is not None})


def tighten_task_definition_response(document):
    """The response always includes every field. Its lists use the write item schemas, not bare objects."""
    body = document['paths']['/api/v1/projects/{project}/task-definitions']['post']['requestBody']['content']['application/json']['schema']
    schema = document['components']['schemas']['TaskDefinition']
    for name in ('parameters', 'phases', 'subtasks'):
        schema['properties'][name]['items'] = copy.deepcopy(body['properties'][name]['items'])
    schema['required'] = [
        'project_id', 'name', 'title', 'brief', 'parameters', 'status', 'schedule', 'phases', 'subtasks',
    ]


tighten_task_definition_response(spec)
annotation_create = spec['paths']['/api/v1/instances/{instance}/annotations']['post']['requestBody']['content']['application/json']['schema']
annotation_create['properties']['boundingBox'] = {'type': 'object', 'properties': {key: {'type': 'number'} for key in ('x', 'y', 'width', 'height')}, 'additionalProperties': False}
# AnnotationData::fromModel() builds camelCase (`instanceId`, `syncError`, and the browser context).
# The controller returns that array, so this schema stays camelCase. It has no toArray().
spec['components']['schemas']['Annotation'] = {'type': 'object', 'properties': {
    **annotation_create['properties'], 'instanceId': {'type': 'integer'}, 'taskId': {'type': 'integer'}, 'taskGroupId': {'type': 'integer'},
    'revision': {'type': 'integer'}, 'status': {'type': 'string', 'enum': ['pending', 'in_progress', 'resolved', 'cancelled']},
    'delivery': {'type': 'string', 'enum': ['queued', 'sending', 'sent', 'error', 'cancelled']},
    'syncError': {'type': ['string', 'null']}, 'summary': {'type': ['string', 'null']},
}}

def route_create_accepts(schema, payload):
    """Exercise the emitted Route create schema's object, oneOf, required and enum semantics."""
    if schema.get('type', 'object') != 'object' or not isinstance(payload, dict):
        return False
    if any(key not in payload for key in schema.get('required', [])):
        return False
    properties = schema.get('properties', {})
    if schema.get('additionalProperties') is False and any(key not in properties for key in payload):
        return False
    for key, value in payload.items():
        rule = properties.get(key, {})
        if rule.get('type') == 'integer' and (not isinstance(value, int) or isinstance(value, bool)):
            return False
        if rule.get('type') == 'string' and not isinstance(value, str):
            return False
        if 'enum' in rule and value not in rule['enum']:
            return False
    return 'oneOf' not in schema or sum(route_create_accepts(option, payload) for option in schema['oneOf']) == 1


route_create_schema = spec['paths']['/api/v1/routes']['post']['requestBody']['content']['application/json']['schema']
for payload, expected in [
    ({'instance_id': 12, 'domain': 'shop.example.test'}, True),
    ({'instance_id': 12, 'domain': 'shop.example.test', 'publication': 'public'}, True),
    ({'node_id': 4, 'domain': 'executor.orbit', 'upstream': 'http://127.0.0.1:4788'}, True),
    ({'node_id': 4, 'domain': 'executor.orbit', 'process_id': 7}, True),
    ({'app_id': 3, 'instance_id': 12, 'domain': 'shop.example.test'}, False),
    ({'node_id': 4, 'domain': 'shop.example.test'}, False),
    ({'cluster_id': 5, 'domain': 'shop.example.test'}, False),
    ({'instance_id': 12, 'domain': 'shop.example.test', 'node_id': 4}, False),
    ({'node_id': 4, 'domain': 'executor.orbit', 'upstream': 'http://127.0.0.1:4788', 'process_id': 7}, False),
    ({'node_id': 4, 'domain': 'executor.orbit', 'upstream': 'http://127.0.0.1:4788', 'publication': 'public'}, False),
]:
    if route_create_accepts(route_create_schema, payload) != expected:
        sys.exit(f'route:create OpenAPI schema disagrees with the Gateway contract for {payload!r}')

outputs = {OUTPUT: json.dumps(spec, indent=2) + '\n'}

# keep docs.json navigation in sync with the operations
config_path = DOCS / 'docs.json'
config = json.loads(config_path.read_text())
for tab in config['navigation']['tabs']:
    if tab['tab'] != 'API':
        continue
    groups = [g for g in tab['groups'] if 'openapi' not in g]
    for _, t, _ in TAGS:
        if nav_pages[t]:
            groups.append({'group': t, 'openapi': '/openapi.json', 'pages': nav_pages[t]})
    tab['groups'] = groups
outputs[config_path] = json.dumps(config, indent=2) + '\n'

if CHECK:
    stale = [str(path.relative_to(ROOT)) for path, text in outputs.items() if path.read_text() != text]
    if stale:
        sys.exit(f'{" and ".join(stale)} {"is" if len(stale) == 1 else "are"} stale. Run bin/docs-openapi and commit the result.')
    print(f'{OUTPUT.relative_to(ROOT)} and the API navigation match the Gateway sources')
    sys.exit(0)

for path, text in outputs.items():
    path.write_text(text)

print(f'wrote {OUTPUT.relative_to(ROOT)}: {sum(len(v) for v in spec["paths"].values())} operations, {len(spec["components"]["schemas"])} schemas')
if unmatched:
    print('routes without a PHP SDK request:', ', '.join(unmatched), file=sys.stderr)
