BOOLEAN_FIELDS = {'force', 'offline', 'replace', 'converge', 'converge_existing', 'purge_data', 'handoff', 'accept_termination', 'publish_observer', 'include_worktrees', 'start', 'keep_alive', 'write'}
nav_pages = {t: [] for _, t, _ in TAGS}
unmatched = []

for route in sorted(routes, key=lambda r: (r['uri'], r['method'])):
    path, params = openapi_path(route)
    method = route['method'].lower()
    action = route['action']
    tag = tag_for(route)
    op_id = route['name'].replace(':', '-')
    if '-definitions' in route['uri'] and route['name'].split(':')[0] in {'process', 'schedule'}:
        op_id = 'app-' + op_id + '-definition'
    op = {'operationId': op_id, 'summary': summary_for(route), 'tags': [tag], 'parameters': []}
    description = description_for(route)
    if description:
        op['description'] = description
    env_route = '/environment/' in path or ('/database-connections/' in path and '/instances/' in path)
    for p in params:
        sch, desc = PARAM_SCHEMAS.get(p, ({'type': 'string'}, ''))
        if p == 'session' and route['name'] == 'tasks:agent-stream':
            desc = 'Numeric task agent session ID within this group.'
        if p == 'instance' and env_route:
            sch, desc = ENV_INSTANCE
        op['parameters'].append({'name': p, 'in': 'path', 'required': True, 'schema': sch, 'description': desc})
    rules_text = next((form_requests[rc] for rc in controllers.get(action, {}).get('requests', []) if rc in form_requests), None)
    sdkreq = sdk_by_key.get(route_key(route))
    if sdkreq is None and route['name'] not in INTERNAL:
        unmatched.append(f'{route["method"]} {route["uri"]}')
    body_schema = None
    query = []
    cmd = commands.get(route['name'])
    if rules_text:
        sch = rules_to_schema(rules_text)
        if route['method'] == 'GET':
            for k, v in (sch.get('properties') or {}).items():
                if k in params:
                    continue
                op['parameters'].append({'name': k, 'in': 'query', 'required': k in sch.get('required', []), 'schema': v})
                query.append(k)
        else:
            body_schema = sch
    elif route['method'] == 'GET' and sdkreq and sdkreq.get('query'):
        for k in re.findall(r"'([a-z_]+)'\s*=>", sdkreq['query']):
            op['parameters'].append({'name': k, 'in': 'query', 'required': True, 'schema': {'type': 'integer' if k.endswith('_id') else 'string'}})
            query.append(k)
    elif route['method'] != 'GET' and sdkreq and sdkreq.get('body'):
        keys = re.findall(r"'([a-z_]+)'\s*=>", sdkreq['body'])
        if keys:
            body_schema = {'type': 'object', 'properties': {k: {'type': 'boolean' if k in BOOLEAN_FIELDS else 'string'} for k in keys}}
    if body_schema and cmd:
        def items(x):
            return list(x.items()) if isinstance(x, dict) else [(o.get('name'), o) for o in x]
        opts = {k.replace('-', '_'): o['description'] for k, o in items(cmd['definition']['options'])}
        args = {k.replace('-', '_'): a['description'] for k, a in items(cmd['definition']['arguments'])}
        for k, v in (body_schema.get('properties') or {}).items():
            d = opts.get(k) or args.get(k)
            if d and 'description' not in v:
                v['description'] = d
    if body_schema is not None:
        body_schema['additionalProperties'] = False
        op['requestBody'] = {'required': bool(body_schema.get('required')), 'content': {'application/json': {'schema': body_schema}}}
    stream = route['name'] in ('instance:deploy', 'instance:rollback')
    responses = {}
    if stream:
        responses['200'] = {'description': 'Newline-delimited JSON events: `phase` and `output` events while the Gateway works, then exactly one final `result` event. A failed operation still ends with a `result` event.', 'content': {'application/x-ndjson': {'schema': NDJSON_SCHEMA}}}
        if body_schema is None:
            body = {'type': 'object', 'additionalProperties': False}
            if route['name'] == 'instance:rollback':
                body = {'type': 'object', 'properties': {'release': {'type': 'string', 'description': 'Retained release name to select.'}}, 'required': ['release'], 'additionalProperties': False}
            op['requestBody'] = {'required': True, 'content': {'application/json': {'schema': body}}}
    elif route['name'] == 'annotation:events':
        responses['200'] = {'description': 'Instance annotation snapshots and status updates. Reconnect with a numeric Last-Event-ID or after query cursor.', 'content': {'text/event-stream': {'schema': {'type': 'string'}}}}
    elif route['name'] == 'tasks:agent-stream':
        responses['200'] = {'description': 'Normalized agent conversation snapshots and events. Reconnect with an opaque Last-Event-ID cursor. Requires Gateway access.', 'content': {'text/event-stream': {'schema': {'type': 'string'}}}}
    elif route['name'] == 'schedule:complete':
        responses['204'] = {'description': 'The Gateway recorded the latest run.'}
    elif route['name'] == 'metrics:grafana:authorize':
        responses['204'] = {'description': 'The caller may reach Grafana.'}
    elif route['name'] == 'runtime-activation:app-instance':
        responses['200'] = {'description': 'Not used: Caddy proxies the site once the awake marker exists and never calls this endpoint for an awake Instance.'}
        responses['401'] = {'description': 'An HTML progress page with the animated Orbit mark. The browser polls the original path once a second while X-Orbit-Runtime-Activation-State is pending.', 'content': {'text/html': {'schema': {'type': 'string'}}}}
        responses['503'] = {'description': 'An HTML failure page with the animated Orbit mark, the stored error, and a Try again link. It does not poll.', 'content': {'text/html': {'schema': {'type': 'string'}}}}
    else:
        data, is_list = data_schema_for(route)
        if is_list:
            data = {'type': 'array', 'items': data}
        if controllers.get(action, {}).get('created'):
            responses['201'] = envelope(data, 'Created.')
            # A creating action answers 200 when an exact retry returns the existing record.
            responses['200'] = envelope(data, 'The request succeeded; an exact retry returned the existing record.')
        else:
            responses['200'] = envelope(data, 'The request succeeded.')
        if route['name'] == 'gateway:trust':
            responses['503'] = error_response('The Gateway root CA is unavailable (`ca.unavailable`).')
    if route['name'] not in ('gateway:status', 'gateway:trust'):
        responses['403'] = error_response('The caller is not an active WireGuard peer (`peer.identity_unknown`) or lacks Node access to the target (`node_access.required`).')
    if params and not stream and route['name'] not in INTERNAL:
        responses['404'] = error_response('No record matches the path parameters.')
    if route['method'] in ('POST', 'PUT', 'PATCH', 'DELETE') and route['name'] not in INTERNAL:
        responses['409'] = error_response('A guard refused the change and the Gateway changed nothing; `error.code` names the guard.')
    if route['name'] in ('tasks:list', 'tasks:show', 'tasks:agents', 'tasks:agent-stream'):
        responses['409'] = error_response('The tasks extension is disabled (`tasks.disabled`).')
    if route['name'] == 'tasks:cancel':
        responses['409'] = error_response('The tasks extension is disabled (`tasks.disabled`) or the Task group is settling or completed (`tasks.not_cancellable`).')
    if route['name'] == 'tasks:complete':
        responses['409'] = error_response('The tasks extension is disabled (`tasks.disabled`) or the Task group is not settling (`tasks.not_settling`).')
    if body_schema is not None or stream:
        responses['422'] = error_response('The JSON body is not an object, has duplicate or unknown members, or fails validation (`validation.failed`).')
    if route['name'] == 'node:metrics':
        responses['409'] = error_response('No Node has the Metrics role (`metrics.assignment_missing`).')
        responses['422'] = error_response('The Node is not an active, WireGuard-managed Node (`node.metrics_unavailable`).')
        responses['502'] = error_response('Grafana or Prometheus did not answer, or Prometheus has no samples for this Node, as for a Node without an enabled exporter (`node.metrics_unreachable`).')
    op['responses'] = responses
    request_schema = op.get('requestBody', {}).get('content', {}).get('application/json', {}).get('schema') if (stream or body_schema is not None) else None
    samples = [{'lang': 'bash', 'label': 'curl', 'source': bash_sample(route, path, request_schema, query, tag)}]
    if sdkreq:
        samples.append({'lang': 'php', 'label': 'PHP SDK', 'source': php_sample(sdkreq, stream, tag)})
    op['x-codeSamples'] = samples
    if not op['parameters']:
        op.pop('parameters')
    spec['paths'].setdefault(path, {})[method] = op
    nav_pages[tag].append(f'{route["method"]} {path}')

spec['components']['schemas'].update({k: v for k, v in components.items() if v is not None})
annotation_create = spec['paths']['/api/v1/instances/{instance}/annotations']['post']['requestBody']['content']['application/json']['schema']
annotation_create['properties']['boundingBox'] = {'type': 'object', 'properties': {key: {'type': 'number'} for key in ('x', 'y', 'width', 'height')}, 'additionalProperties': False}
spec['components']['schemas']['Annotation'] = {'type': 'object', 'properties': {
    **annotation_create['properties'], 'instanceId': {'type': 'integer'}, 'taskId': {'type': 'integer'}, 'taskGroupId': {'type': 'integer'},
    'revision': {'type': 'integer'}, 'status': {'type': 'string', 'enum': ['pending', 'in_progress', 'resolved', 'cancelled']},
    'delivery': {'type': 'string', 'enum': ['queued', 'sending', 'sent', 'error', 'cancelled']},
    'syncError': {'type': ['string', 'null']}, 'summary': {'type': ['string', 'null']},
}}

OUTPUT.write_text(json.dumps(spec, indent=2) + '\n')

# keep docs.json navigation in sync with the operations
config_path = DOCS / 'docs.json'
config = json.loads(config_path.read_text())
for tab in config['navigation']['tabs']:
    if tab['tab'] != 'API':
        continue
    groups = [g for g in tab['groups'] if 'openapi' not in g]
    for _, t, _ in TAGS:
        if nav_pages[t]:
            groups.append({'group': t, 'openapi': '/openapi.json', 'pages': nav_pages[t]})
    tab['groups'] = groups
config_path.write_text(json.dumps(config, indent=2) + '\n')

print(f'wrote {OUTPUT.relative_to(ROOT)}: {sum(len(v) for v in spec["paths"].values())} operations, {len(spec["components"]["schemas"])} schemas')
if unmatched:
    print('routes without a PHP SDK request:', ', '.join(unmatched), file=sys.stderr)
