def php_literal(v):
    if isinstance(v, bool):
        return 'true' if v else 'false'
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, list):
        return '[' + ', '.join(php_literal(x) for x in v) + ']'
    if isinstance(v, dict):
        return '[' + ', '.join(f"'{k}' => {php_literal(x)}" for k, x in v.items()) + ']'
    return "'" + str(v).replace("'", "\\'") + "'"


def php_sample(sdkreq, stream, tag):
    ns = 'Orbit\\Sdk\\Requests\\' + sdkreq['file'].replace('.php', '').replace('/', '\\')
    imports = ['Orbit\\Sdk\\GatewayConnector', ns]
    ctor = re.sub(r'#\[[^\]]*\]', '', sdkreq['ctor'])
    args = []
    for part in [p.strip() for p in re.split(r',(?![^(]*\))', ctor) if p.strip()]:
        m = re.match(r'(?:private|public|protected)?\s*(?:readonly)?\s*([\w|?\\]+)\s+\$(\w+)(\s*=\s*(.+))?$', part, re.S)
        if not m:
            continue
        t, name, has_default = m.group(1), m.group(2), m.group(3)
        if has_default:
            if sdkreq['class'] == 'RenameInstanceRequest' and name == 'branch':
                args.append("branch: 't3code/login-redirect'")
            continue
        if 'Target' in t:
            first = t.split('|')[0]
            imports.append(f'Orbit\\Sdk\\Requests\\{sdkreq["file"].split("/")[0]}\\{first}')
            args.append(f'{name}: new {first}({12 if "Instance" in first and "Node" not in first else 7})')
            continue
        if name == 'name':
            val = NAME_BY_TAG.get(tag, 'example')
        elif name == 'definition' and tag == 'Tasks':
            val = json.dumps(task_definition_document(NAME_BY_TAG.get(tag, 'example')))
        elif t == 'array' and name == 'command':
            val = ['/usr/bin/php', 'artisan', 'queue:work']
        elif name in PHP_EXAMPLES:
            val = PHP_EXAMPLES[name]
        elif t.startswith('?'):
            continue
        elif t in ('int', 'int|string'):
            val = 1
        elif t == 'bool':
            val = True
        elif t == 'array':
            val = []
        elif t == 'string':
            val = 'value'
        else:
            continue
        args.append(f'{name}: {php_literal(val)}')
    call = f'new {sdkreq["class"]}(' + ', '.join(args) + ')'
    if len(', '.join(args)) > 60:
        call = f'new {sdkreq["class"]}(\n    ' + ',\n    '.join(args) + ',\n)'
    lines = ['<?php', ''] + [f'use {i};' for i in dict.fromkeys(imports)] + ['', '$connector = new GatewayConnector(', "    baseUrl: 'https://gateway.orbit',", "    caPemPath: '/path/to/orbit-root-ca.pem',", ');', '']
    if stream:
        lines += [f'$stream = $connector->send({call})->dto();', '', 'foreach ($stream as $event) {', '    // DeploymentPhaseEvent, DeploymentOutputEvent, or the final DeploymentResultEvent', '}']
    else:
        lines += [f'$response = $connector->send({call})->dto();']
    return '\n'.join(lines) + '\n'


def example_from_schema(sch, name, tag, depth=0, update=False):
    if not isinstance(sch, dict):
        return None
    if '$ref' in sch:
        return {}
    t = sch.get('type')
    t = t[0] if isinstance(t, list) else t
    if name == 'name' and tag in NAME_BY_TAG:
        return NAME_BY_TAG[tag]
    if name in EXAMPLE_BY_NAME:
        example = EXAMPLE_BY_NAME[name]
        if name == 'command' and t == 'string' and isinstance(example, list):
            return ' '.join(example)
        return example
    if sch.get('enum'):
        return sch['enum'][0]
    if t == 'object':
        out = {}
        props = sch.get('properties') or {}
        for k, v in props.items():
            if k in (sch.get('required') or []) or (depth == 0 and len(props) <= 4):
                out[k] = example_from_schema(v, k, tag, depth + 1)
        if depth == 0 and not out and props and update:
            # An update needs at least one field, so its example sends the first one.
            k, v = next(iter(props.items()))
            out[k] = example_from_schema(v, k, tag, depth + 1)
        return out
    if t == 'array':
        return [example_from_schema(sch.get('items', {}), None, tag, depth + 1)] if sch.get('items') else []
    if t == 'integer':
        return sch.get('minimum', 1)
    if t == 'number':
        return 1
    if t == 'boolean':
        return True
    if sch.get('format') == 'uuid':
        return '9a1f0c2e-6b7d-4e5f-8a9b-0c1d2e3f4a5b'
    return 'example'


ACTIVITY_LIST_EXAMPLES = {
    'request_id': '9d6b1e5c-4a3f-4a1b-9f0e-6d2c3f5a7b81',
    'before_id': 480,
    'status': 'failed',
    'command': 'instance:deploy',
    'caller_node_id': 2,
    'target_node_id': 4,
}


def correct_task_definition_body(schema):
    """The Laravel array rule is a list. These three fields are JSON objects."""
    properties = schema.get('properties') or {}
    subtasks = ((properties.get('subtasks') or {}).get('items') or {}).get('properties') or {}
    if 'routes' in subtasks:
        subtasks['routes'] = {'type': 'object', 'additionalProperties': {'type': 'string'}}
    if 'arguments' in subtasks:
        subtasks['arguments'] = {'type': 'object', 'additionalProperties': True}
    schedule = properties.get('schedule')
    if isinstance(schedule, dict):
        schedule['type'] = ['object', 'null']
        if isinstance(schedule.get('properties'), dict):
            schedule['properties']['values'] = {'type': 'object', 'additionalProperties': True}
    default = (((properties.get('parameters') or {}).get('items') or {}).get('properties') or {}).get('default')
    if isinstance(default, dict):
        properties['parameters']['items']['properties']['default'] = {}


def example_path(route, name):
    """Example value for one path parameter. Task definition names are not the schema for every future `{name}`."""
    if name == 'name' and str(route.get('name') or '').startswith('tasks:definition:'):
        return 'build-feature'
    return EXAMPLE_PATH.get(name, 1)


def task_definition_document(name):
    """A definition the Gateway accepts. `parameters` is present because the write requires it."""
    return {
        'name': name,
        'title': 'Build a feature',
        'brief': 'Document and build it.',
        'parameters': [],
        'status': 'backlog',
        'subtasks': [{'key': 'docs', 'title': 'Write the docs', 'kind': 'agent'}],
    }


def bash_sample(route, path, body_schema, query, tag):
    url = 'https://gateway.orbit' + re.sub(r'\{(\w+)\}', lambda m: str(example_path(route, m.group(1))), path)
    if query:
        examples = {**EXAMPLE_BY_NAME, **ACTIVITY_LIST_EXAMPLES} if route['name'] == 'activity:list' else EXAMPLE_BY_NAME
        url += '?' + '&'.join(f'{q}={examples.get(q, 1)}' for q in query)
    method = '' if route['method'] == 'GET' else f'-X {route["method"]} '
    lines = [f'curl -sS {method}"{url}" \\', '  --cacert /path/to/orbit-root-ca.pem \\', "  -H 'Accept: application/json' \\", "  -H 'X-Orbit-Request-Id: 9d6b1e5c-4a3f-4a1b-9f0e-6d2c3f5a7b81'"]
    if body_schema is not None:
        lines[-1] += ' \\'
        if route['name'] == 'tasks:definition:update':
            body = task_definition_document(example_path(route, 'name'))
        elif route['name'] == 'tasks:definition:create':
            body = task_definition_document('example')
        else:
            body = example_from_schema(body_schema, None, tag, update=route['method'] in ('PATCH', 'PUT')) or {}
        lines += ["  -H 'Content-Type: application/json' \\", "  -d '" + json.dumps(body) + "'"]
    return '\n'.join(lines) + '\n'


# ---------------------------------------------------------------- responses
def envelope(data_schema, description):
    return {'description': description, 'content': {'application/json': {'schema': {'type': 'object', 'properties': {'data': data_schema, 'meta': {'$ref': '#/components/schemas/Meta'}}, 'required': ['data', 'meta']}}}}


def error_response(desc):
    return {'description': desc, 'content': {'application/json': {'schema': {'$ref': '#/components/schemas/Error'}}}}


