def data_schema_for(route):
    action = route['action']
    if action.startswith('ProjectDocumentsController@'):
        verb = action.split('@')[1]
        if verb in ('index', 'search'):
            return ref('DocumentEntryData'), True
        if verb == 'versions':
            return ref('DocumentVersionData'), True
        if verb in ('read', 'download'):
            field = 'content_text' if verb == 'read' else 'content_base64'
            return {'type': 'object', 'properties': {'entry_id': {'type': 'integer'}, 'revision': {'type': 'integer'}, 'version': ref('DocumentVersionData'), field: {'type': 'string'}}, 'required': ['entry_id', 'revision', 'version', field], 'additionalProperties': False}, False
        if verb == 'destroy':
            return {'type': 'object', 'properties': {'id': {'type': 'integer'}, 'removed': {'type': 'boolean'}, 'cleanup_pending': {'type': 'boolean'}}, 'required': ['id', 'removed', 'cleanup_pending'], 'additionalProperties': False}, False
        return ref('DocumentEntryData'), False
    if action in RESPONSE_OVERRIDES:
        return RESPONSE_OVERRIDES[action], False
    if action in CTRL_DATA_OVERRIDES:
        cls, is_list = CTRL_DATA_OVERRIDES[action]
        return ref(cls), is_list
    if action in SDK_RESPONSE_FALLBACK:
        return sdk_schema(SDK_RESPONSE_FALLBACK[action]), False
    cands = [c for c in controllers.get(action, {}).get('data', []) if not INPUT_PREFIX.match(c) and c in gdata]
    is_list = action.endswith(('@index', '@processIndex', '@scheduleIndex'))
    if not cands:
        return {'type': 'object'}, is_list
    if action == 'NodesController@show':
        return {'allOf': [ref('NodeData'), {'type': 'object', 'properties': {
            'access': ref('NodeAccessData'),
            'excluded_projects': {'type': 'array', 'items': ref('DevelopmentNodeExclusionData')},
        }}]}, False
    if action == 'DatabaseServersController@show':
        return {'allOf': [ref('DatabaseServerData'), {'type': 'object', 'properties': {
            'databases': {'type': 'array', 'items': ref('DatabaseConnectionData')},
        }}]}, False
    if action == 'ProjectsController@show':
        return {'allOf': [ref('ProjectData'), {'type': 'object', 'properties': {
            'excluded_nodes': {'type': 'array', 'items': ref('DevelopmentNodeExclusionData')},
        }}]}, False
    return ref(cands[0]), is_list


