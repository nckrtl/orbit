BOOLEAN_FIELDS = {'force', 'offline', 'replace', 'converge', 'converge_existing', 'purge_data', 'handoff', 'accept_termination', 'publish_observer', 'include_worktrees', 'start', 'keep_alive', 'write'}
nav_pages = {t: [] for _, t, _ in TAGS}
unmatched = []

for route in sorted(routes, key=lambda r: (r['uri'], r['method'])):
    path, params = openapi_path(route)
    method = route['method'].lower()
    action = route['action']
    tag = tag_for(route)
    op_id = route['name'].replace(':', '-')
    if '-definitions' in route['uri'] and route['name'].split(':')[0] in {'process', 'schedule'}:
        op_id = 'app-' + op_id + '-definition'
    op = {'operationId': op_id, 'summary': summary_for(route), 'tags': [tag], 'parameters': []}
    if route['name'] and route['name'].startswith('tasks:') and route['name'] != 'tasks:status':
        op['x-orbit-extension'] = 'tasks'
    elif route['name'] and route['name'].startswith('proxycli:'):
        op['x-orbit-extension'] = 'proxycli'
    if route['name'] in ('instance:deploy', 'instance:rollback'):
        op['x-orbit-task-action'] = True
    description = description_for(route)
    if description:
        op['description'] = description
    env_route = '/environment/' in path or ('/database-connections/' in path and '/instances/' in path)
    for p in params:
        sch, desc = PARAM_SCHEMAS.get(p, ({'type': 'string'}, ''))
        if p == 'entry' and route['name'].startswith('project:document:'):
            sch, desc = {'type': 'integer', 'minimum': 1}, 'Numeric Project Document entry ID.'
        if p == 'instance' and env_route:
            sch, desc = ENV_INSTANCE
        if p == 'name' and str(route.get('name') or '').startswith('tasks:definition:'):
            sch, desc = TASK_DEFINITION_NAME
        op['parameters'].append({'name': p, 'in': 'path', 'required': True, 'schema': sch, 'description': desc})
    form_request = next((form_requests[rc] for rc in controllers.get(action, {}).get('requests', []) if rc in form_requests), None)
    rules_text = form_request['rules'] if form_request else None
    sdkreq = sdk_by_key.get(route_key(route))
    if sdkreq is None and route['name'] not in INTERNAL:
        unmatched.append(f'{route["method"]} {route["uri"]}')
    body_schema = None
    query = []
    cmd = commands.get(route['name'])
    if rules_text:
        if 'return DatabaseConnectionFieldRules::update();' in rules_text:
            field_rules = database_field_rules()
            rules_text = database_update_rules(field_rules)
        sch, body_required = rules_to_schema(rules_text, route['name'])
        if route['method'] == 'GET':
            for k, v in (sch.get('properties') or {}).items():
                if k in params:
                    continue
                op['parameters'].append({'name': k, 'in': 'query', 'required': k in sch.get('required', []), 'schema': v})
                query.append(k)
        else:
            body_schema = sch
            if not sch.get('properties') and form_request['requires_empty_body']:
                body_required = True
            if route['name'] == 'route:create':
                # StoreRouteRequest has separate app and custom-proxy rule sets.
                # The generic parser sees only its first return (the proxy).
                app_rules = 'return [' + rules_text.split('return [', 2)[2]
                app_schema, _ = rules_to_schema(app_rules, route['name'])
                sch['properties']['publication']['enum'] = ['private']
                sch['oneOf'] = [{'required': ['upstream']}, {'required': ['process_id']}]
                body_schema = {'oneOf': [app_schema, sch]}
                body_required = True
            if route['name'] == 'database:create':
                # StoreDatabaseConnectionRequest picks one of two rule sets: register an existing
                # database, or create one on a Database server with `server`.
                field_rules = database_field_rules()
                register_schema, _ = rules_to_schema(block(field_rules, field_rules.find('function store(')), route['name'])
                server_rules = block(field_rules, field_rules.find('function onServer(')).replace('$rules = [', 'return [', 1)
                server_schema, _ = rules_to_schema(server_rules, route['name'])
                body_schema = {'oneOf': [register_schema, server_schema]}
                body_required = True
    elif route['method'] == 'GET' and sdkreq and sdkreq.get('query'):
        for k in re.findall(r"'([a-z_]+)'\s*=>", sdkreq['query']):
            op['parameters'].append({'name': k, 'in': 'query', 'required': True, 'schema': {'type': 'integer' if k.endswith('_id') else 'string'}})
            query.append(k)
    elif route['method'] != 'GET' and sdkreq and sdkreq.get('body'):
        keys = re.findall(r"'([a-z_]+)'\s*=>", sdkreq['body'])
        if keys:
            body_schema = {'type': 'object', 'properties': {k: {'type': 'boolean' if k in BOOLEAN_FIELDS else 'string'} for k in keys}}
    if body_schema and 'oneOf' in body_schema:
        for variant in body_schema['oneOf']:
            variant['additionalProperties'] = False
    if body_schema and cmd:
        def items(x):
            return list(x.items()) if isinstance(x, dict) else [(o.get('name'), o) for o in x]
        opts = {k.replace('-', '_'): o['description'] for k, o in items(cmd['definition']['options'])}
        args = {k.replace('-', '_'): a['description'] for k, a in items(cmd['definition']['arguments'])}
        for k, v in (body_schema.get('properties') or {}).items():
            d = opts.get(k) or args.get(k)
            if d and 'description' not in v:
                v['description'] = d
    if route['name'] in ('project:dev-deploy-step:create', 'project:dev-deploy-step:update') and body_schema:
        props = body_schema['properties']
        props['timeout_seconds'].update({'minimum': 1, 'maximum': 900, 'description': 'Step timeout in seconds.'})
        props['command'].update({'minLength': 1, 'description': 'Nonempty UTF-8 shell command, at most 16 KiB, without NUL bytes.'})
        if route['name'] == 'project:dev-deploy-step:create':
            props['timeout_seconds']['default'] = 300
            props['required']['default'] = True
            props['name'].update({'maxLength': 63, 'pattern': '^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$'})
    if route['name'] in ('tasks:definition:create', 'tasks:definition:update') and body_schema:
        correct_task_definition_body(body_schema)
    if route['name'] in ('project:document:create', 'project:document:write') and body_schema:
        props = body_schema['properties']
        props['content_text'].update({'maxLength': 1048576, 'description': 'Exact UTF-8 text without NUL; decoded UTF-8 size is at most 1 MiB.'})
        props['content_base64'].update({'maxLength': 13981016, 'description': 'Canonical RFC 4648 base64; decoded size is at most 10 MiB.'})
        content_choices = [{'required': ['content_text'], 'not': {'required': ['content_base64']}}, {'required': ['content_base64'], 'not': {'required': ['content_text']}}]
        if route['name'] == 'project:document:create':
            body_schema['oneOf'] = [
                {'properties': {'kind': {'const': 'folder'}}, 'not': {'anyOf': [{'required': [field]} for field in ('content_text', 'content_base64', 'media_type')]}},
                {'properties': {'kind': {'const': 'file'}}, 'oneOf': content_choices},
            ]
        else:
            body_schema['oneOf'] = content_choices
        body_schema['additionalProperties'] = False
    if route['name'] == 'project:document:update' and body_schema:
        body_schema['anyOf'] = [{'required': ['name']}, {'required': ['parent_id']}]
    if body_schema is not None:
        if 'oneOf' not in body_schema:
            body_schema['additionalProperties'] = False
        op['requestBody'] = {'required': body_required or bool(body_schema.get('required')), 'content': {'application/json': {'schema': body_schema}}}
    stream = route['name'] in ('instance:deploy', 'instance:rollback')
    responses = {}
    if stream:
        responses['200'] = {'description': 'Newline-delimited JSON events: `phase` and `output` events while the Gateway works, then exactly one final `result` event. A failed operation still ends with a `result` event.', 'content': {'application/x-ndjson': {'schema': NDJSON_SCHEMA}}}
        if body_schema is None:
            body = {'type': 'object', 'additionalProperties': False}
            if route['name'] == 'instance:rollback':
                body = {'type': 'object', 'properties': {'release': {'type': 'string', 'description': 'Retained release name to select.'}}, 'required': ['release'], 'additionalProperties': False}
            op['requestBody'] = {'required': True, 'content': {'application/json': {'schema': body}}}
    elif route['name'] == 'annotation:events':
        responses['200'] = {'description': 'Instance annotation snapshots and status updates. Reconnect with a numeric Last-Event-ID or after query cursor.', 'content': {'text/event-stream': {'schema': {'type': 'string'}}}}
    elif route['name'] == 'tasks:agent-stream':
        responses['200'] = {'description': 'Normalized agent conversation snapshots and events. Reconnect with an opaque Last-Event-ID cursor. Requires Gateway access.', 'content': {'text/event-stream': {'schema': {'type': 'string'}}}}
    elif route['name'] == 'agent:realtime':
        connection = {'type': 'object', 'properties': {
            'url': {'type': ['string', 'null'], 'description': 'Reverb WebSocket URL.'},
            'address': {'type': ['string', 'null'], 'description': 'Address that serves Reverb on port 443.'},
            'key': {'type': ['string', 'null'], 'description': 'Reverb app key.'},
            'channel': {'type': 'string', 'description': "The Node's presence channel, `presence-node.{id}`."},
            'log_channel': {'type': 'string', 'description': "The Node's log channel, `presence-node-logs.{id}`, for live log streams."},
            'member': {'type': 'string', 'description': "The agent's member ID, `agent.{id}`."},
        }, 'required': ['url', 'address', 'key', 'channel', 'log_channel', 'member']}
        responses['200'] = envelope(connection, 'The request succeeded.')
    elif route['name'] == 'agent:workspaces':
        workspace = {'type': 'object', 'properties': {
            'instance_id': {'type': 'integer', 'description': 'The Instance that holds the task workspace.'},
            'path': {'type': 'string', 'description': 'The absolute checkout path on the Node.'},
            'base': {'type': 'string', 'description': "The Project's default branch, which the diff counts are read against."},
