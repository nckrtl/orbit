def tag_for(route):
    if route['name'] in ('tasks:agents', 'tasks:agent-stream'):
        return 'Tasks'
    if route['name'] in INTERNAL:
        return 'Node callbacks'
    return TAG_BY_PREFIX[route['name'].split(':')[0]]


def summary_for(route):
    if route['action'] in DEFINITION_ROUTES:
        return DEFINITION_ROUTES[route['action']]
    return SUMMARIES.get(route['name'], route['name'])


def description_for(route):
    if route['name'] in DESCRIPTIONS:
        return DESCRIPTIONS[route['name']]
    if route['action'] in DEFINITION_ROUTES:
        return 'Project-owned definitions carry the runtime specification that production preparation copies into a new Instance. Changing a definition changes Project configuration only.'
    c = commands.get(route['name'])
    if not c:
        return None
    text = c['description']
    if c.get('help') and c['help'] != c['description']:
        text += '\n\n' + c['help']
    return re.sub(r'\bAppInstances?\b', lambda match: 'Instances' if match[0].endswith('s') else 'Instance', text)


# ---------------------------------------------------------------- path parameters
PARAM_RENAME = {'firewallRule:name': 'firewall_rule', 'servingNode': 'serving_node', 'consumerNode': 'consumer_node', 'processDefinition': 'process_definition', 'scheduleDefinition': 'schedule_definition'}
