#!/usr/bin/env python3
"""Generate docs/openapi.json from the Gateway routes, form requests, data classes, the PHP SDK, and the CLI.

Run from any directory:

    bin/docs-openapi            write docs/openapi.json and the API tab of docs/docs.json
    bin/docs-openapi --check    exit 1 when either file differs from what the sources produce

The script reads the Gateway route table through `php apps/gateway/artisan route:list --json`, parses the
controllers, form requests, data classes, and enums under apps/gateway/app, the request and response classes
under packages/php-sdk/src, and the command descriptions from the signature, description, and help properties
under apps/cli/app/Commands. It does not run `orbit list`: that list hides extension commands unless a Gateway
reports the extension enabled, and it needs apps/cli/vendor, so the same checkout would not always match.
It writes docs/openapi.json, which docs/docs.json references for the API tab of the Mintlify site.

A response schema uses the keys of a hand-written toArray() when each key is one constructor property.
Otherwise it snake-cases constructor properties when the class uses SnakeCaseMapper, and keeps the
constructor names when it does not. AnnotationData is the exception that sends camelCase on purpose:
the controller returns the array fromModel() builds, and that schema is written below.
"""

import copy
import json
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
GW = ROOT / 'apps/gateway'
SDK = ROOT / 'packages/php-sdk/src'
DOCS = ROOT / 'docs'
OUTPUT = DOCS / 'openapi.json'
CHECK = sys.argv[1:] == ['--check']
if sys.argv[1:] and not CHECK:
    sys.exit('usage: bin/docs-openapi [--check]')


# ---------------------------------------------------------------- source parsing
def snake(name):
    return re.sub(r'(?<!^)(?=[A-Z])', '_', name).lower()


def block(s, start):
    j = s.find('{', start)
    depth = 0
    k = j
    while k < len(s):
        if s[k] == '{':
            depth += 1
        elif s[k] == '}':
            depth -= 1
            if depth == 0:
                return s[j + 1:k]
        k += 1
    return ''


def run_json(args, cwd):
    out = subprocess.run(args, cwd=cwd, capture_output=True, text=True, check=True).stdout
    return json.loads(out)


def load_routes():
    rows = run_json(['php', 'artisan', 'route:list', '--json', '--path=api'], GW)
    routes = []
    for r in rows:
        if not r['uri'].startswith('api/'):
            continue
        routes.append({
            'method': r['method'].split('|')[0],
            'uri': r['uri'],
            'name': r.get('name'),
            'action': r['action'].split('\\')[-1],
        })
    return routes


def php_literal(source, start, path):
    """Decode one PHP string literal. A heredoc or nowdoc value has no trailing newline."""
    rel = path.relative_to(ROOT)
    if source.startswith('<<<', start):
        opener = re.match(r"<<<[ \t]*('?)([A-Za-z_][A-Za-z0-9_]*)\1[ \t]*\r?\n", source[start:])
        if not opener:
            sys.exit(f'bin/docs-openapi: {rel} has a PHP heredoc the generator cannot read')
        body_at = start + opener.end()
        closer = re.search(rf'(?m)^{re.escape(opener.group(2))}(?=\s*;)', source[body_at:])
        if not closer:
            sys.exit(f'bin/docs-openapi: {rel} has an unclosed PHP heredoc')
        raw = source[body_at:body_at + closer.start()]
        if raw.endswith('\r\n'):
            raw = raw[:-2]
        elif raw.endswith('\n'):
            raw = raw[:-1]
        if opener.group(1) != "'" and ('$' in raw or '\\' in raw):
            sys.exit(f'bin/docs-openapi: {rel} has an interpolated PHP heredoc the generator does not read')
        return raw
    quote = source[start]
    if quote not in "'\"":
        sys.exit(f'bin/docs-openapi: {rel} has a command property that is not a PHP string')
    i = start + 1
    out = []
    while i < len(source):
        char = source[i]
        if char == '\\' and i + 1 < len(source):
            nxt = source[i + 1]
            if quote == "'" and nxt in "\\'":
                out.append(nxt)
                i += 2
                continue
            if quote == '"':
                mapped = {'n': '\n', 'r': '\r', 't': '\t', '\\': '\\', '"': '"', '$': '$'}
                if nxt in mapped:
                    out.append(mapped[nxt])
                    i += 2
                    continue
        if char == quote:
            return ''.join(out)
        out.append(char)
        i += 1
    sys.exit(f'bin/docs-openapi: {rel} has an unterminated PHP string')


def php_property(source, name, path):
    found = re.search(rf'protected\s+\${name}\s*=\s*', source)
    if not found:
        return None
    return php_literal(source, found.end(), path)


def split_parameter(token):
    parts = re.split(r'\s+:\s+', token.strip(), maxsplit=1)
    if len(parts) == 2:
        return parts[0], parts[1]
    return token.strip(), ''


def command_parameters(signature, path):
    """Argument and option descriptions from a Laravel signature.

    Framework options such as --version and --env are not part of the signature. Copying them onto a
    request field names the console flag rather than the API field, as with analytics:update version.
    """
    found = re.match(r'[^\s]+', signature)
    if not found:
        sys.exit(f'bin/docs-openapi: {path.relative_to(ROOT)} has a signature with no command name')
    arguments = {}
    options = {}
    for token in re.findall(r'\{\s*(.*?)\s*\}', signature):
        if re.match(r'^-{2,}', token):
            spec, description = split_parameter(re.sub(r'^-{2,}', '', token))
            shortcut = re.split(r'\s*\|\s*', spec, maxsplit=1)
            if len(shortcut) == 2:
                spec = shortcut[1]
            option = re.split(r'[=*]', spec, maxsplit=1)[0]
            if option == '':
                sys.exit(f'bin/docs-openapi: {path.relative_to(ROOT)} has an option with no name')
            options[option] = description
        else:
            spec, description = split_parameter(token)
            argument = spec.split('=', 1)[0].rstrip('?*')
            if argument == '':
                sys.exit(f'bin/docs-openapi: {path.relative_to(ROOT)} has an argument with no name')
            arguments[argument] = description
    return found.group(0), arguments, options


def load_commands():
    """Read CLI command text from the command classes.

    `php orbit list` omits tasks and proxycli commands while the active Gateway reports that extension
    off or cannot be reached, and it fails when apps/cli/vendor is absent. The class files are the same
    in both cases, so request-field descriptions stay in the document.
    """
    commands = {}
    for path in sorted((ROOT / 'apps/cli/app/Commands').rglob('*.php')):
        source = path.read_text()
        signature = php_property(source, 'signature', path)
        if signature is None:
            continue
        name, arguments, options = command_parameters(signature, path)
        if name in commands:
            sys.exit(f'bin/docs-openapi: {path.relative_to(ROOT)} redefines command {name}')
        description = php_property(source, 'description', path) or ''
        help_text = php_property(source, 'help', path)
        commands[name] = {
            'name': name,
            'description': description,
            'help': description if help_text is None else help_text,
            'definition': {
                'arguments': {key: {'description': text} for key, text in arguments.items()},
                'options': {key: {'description': text} for key, text in options.items()},
            },
        }
    return commands


def load_controllers():
    ctrl = {}
    for f in sorted((GW / 'app/Http/Controllers/Api').glob('*.php')):
        s = f.read_text()
        for m in re.finditer(r'public function (\w+)\((.*?)\)\s*:\s*([\w|\\]+)', s, re.S):
            params = re.sub(r'\s+', ' ', m.group(2))
            body = block(s, s.find(')', m.end(2)))
            ctrl[f'{f.stem}@{m.group(1)}'] = {
                'requests': re.findall(r'(\w+Request) \$', params),
                'data': sorted({a or b for a, b in re.findall(r'(\w+Data)::fromModel|(\w+Data)::from\w*\(', body)}),
                'created': bool(re.search(r'\b201\b', body)),
            }
    return ctrl


def load_form_requests():
    reqs = {}
    for f in sorted((GW / 'app/Http/Requests').rglob('*.php')):
        s = f.read_text()
        i = s.find('function rules(')
        if i < 0:
            continue
        validation_index = s.find('function validationData(')
        validation = block(s, validation_index) if validation_index >= 0 else ''
        # Empty rules alone do not require a body. Read the explicit rejection before
        # the empty-key inspector; EmptyTasksRequest instead accepts missing content.
        requires_empty_body = bool(
            re.search(r"if\s*\(trim\(\$content\)\s*===\s*''\)\s*\{\s*throw\s+(?:ValidationException::withMessages|new UnexpectedValueException)", validation)
            and re.search(r'->inspect\(\$content,\s*\[\]\)', validation)
        )
        reqs[f.stem] = {'rules': block(s, i), 'requires_empty_body': requires_empty_body}
    return reqs


PROP_VALUE = re.compile(r'^\$this->(\w+)(?:\?->value|->value|\?->toArray\(\)|->toArray\(\))?$')
PROP_LIST = re.compile(r'^array_map\s*\(.*\$this->(\w+)\s*,?\s*\)$', re.S)


def output_names(source, prop_names):
    """Keys of a hand-written toArray(), each mapped to a constructor property, or None when that is not the whole shape."""
    found = re.search(r'function toArray\(\)', source)
    if not found:
        return None
    brace = source.find('{', found.end())
    if brace < 0:
        return None
    arrays = {}
    returns = []
    for kind, name, expr in depth0_bindings(block(source, brace)):
        if kind == 'assign' and expr.lstrip().startswith('['):
            entries = parse_array_literal(expr)
            if entries is not None:
                arrays[name] = entries
        elif kind == 'return':
            returns.append(expr)
    ordered = []
    exprs = {}
    for expr in returns:
        resolved = resolve_entries(expr, arrays)
        if not resolved:
            continue
        for key, value in resolved:
            if key not in exprs:
                ordered.append(key)
            exprs[key] = re.sub(r'\s+', ' ', value).strip()
    if not ordered:
        return None
    names = set(prop_names)
    snaked = {snake(name): name for name in names}
    mapped = []
    for key in ordered:
        value = exprs[key]
        direct = PROP_VALUE.match(value)
        listed = PROP_LIST.match(value)
        if direct and direct.group(1) in names:
            prop = direct.group(1)
        elif listed and listed.group(1) in names:
            prop = listed.group(1)
        elif key in names:
            prop = key
        else:
            prop = snaked.get(key)
        if prop is None:
            return None
        mapped.append((key, prop))
    return mapped


def depth0_bindings(body):
    i = 0
    n = len(body)
    depth = 0
    while i < n:
        skipped = skip_php_token(body, i)
        if skipped is not None:
            i = skipped
            continue
        c = body[i]
        if c in '([{':
            depth += 1
            i += 1
            continue
        if c in ')]}':
            depth -= 1
            i += 1
            continue
        if depth == 0:
            assign = re.match(r'\$(\w+)\s*=(?!=)\s*', body[i:])
            if assign and word_before(body, i):
                j = i + len(assign.group(0))
                end = statement_end(body, j)
                yield 'assign', assign.group(1), body[j:end].strip()
                i = end + 1
                continue
            if body.startswith('return', i) and word_before(body, i) and word_after(body, i + 6):
                j = i + 6
                while j < n and body[j] in ' \t\r\n':
                    j += 1
                end = statement_end(body, j)
                yield 'return', None, body[j:end].strip()
                i = end + 1
                continue
        i += 1


def resolve_entries(expr, arrays):
    expr = expr.strip().rstrip(';').strip()
    if expr.startswith('['):
        entries = parse_array_literal(expr)
        return None if entries is None else expand_entries(entries, arrays)
    bare = re.fullmatch(r'\$(\w+)', expr)
    if bare and bare.group(1) in arrays:
        return expand_entries(arrays[bare.group(1)], arrays)
    return None


def expand_entries(entries, arrays):
    out = []
    for kind, first, *rest in entries:
        if kind == 'key':
            out.append((first, rest[0]))
        elif kind == 'spread':
            bare = re.fullmatch(r'\$(\w+)', first.strip())
            if not bare or bare.group(1) not in arrays:
                return None
            nested = expand_entries(arrays[bare.group(1)], arrays)
            if nested is None:
                return None
            out.extend(nested)
        else:
            return None
    return out


def parse_array_literal(text):
    text = text.strip()
    if not text.startswith('['):
        return None
    i = 1
    n = len(text)
    entries = []
    depth = 1
    start = i
    while i < n and depth:
        skipped = skip_php_token(text, i)
        if skipped is not None:
            i = skipped
            continue
        c = text[i]
        if c in '([{':
            depth += 1
        elif c in ')]}':
            depth -= 1
            if depth == 0:
                chunk = text[start:i].strip().rstrip(',').strip()
                if chunk:
                    parsed = parse_element(chunk)
                    if parsed is None:
                        return None
                    entries.append(parsed)
                return entries
        elif c == ',' and depth == 1:
            chunk = text[start:i].strip()
            if chunk:
                parsed = parse_element(chunk)
                if parsed is None:
                    return None
                entries.append(parsed)
            start = i + 1
        i += 1
    return None


def parse_element(chunk):
    chunk = chunk.strip()
    if chunk.startswith('...'):
        return ('spread', chunk[3:].strip(), None)
    matched = re.match(r"""(['\"])([^'\"]+)\1\s*=>\s*(.*)$""", chunk, re.S)
    if not matched:
        return None
    return ('key', matched.group(2), matched.group(3).strip())


def statement_end(text, i):
    n = len(text)
    depth = 0
    while i < n:
        skipped = skip_php_token(text, i)
        if skipped is not None:
            i = skipped
            continue
        c = text[i]
        if c in '([{':
            depth += 1
        elif c in ')]}':
            depth -= 1
        elif c == ';' and depth == 0:
            return i
        i += 1
    return n


def skip_php_token(text, i):
    """Index after a string or comment starting at i, or None when i is ordinary code."""
    n = len(text)
    c = text[i]
    if c == '/' and i + 1 < n and text[i + 1] == '/':
        nl = text.find('\n', i + 2)
        return n if nl < 0 else nl + 1
    if c == '/' and i + 1 < n and text[i + 1] == '*':
        end = text.find('*/', i + 2)
        return n if end < 0 else end + 2
    if c in '\'"':
        q = c
        i += 1
        while i < n and text[i] != q:
            i += 2 if text[i] == '\\' else 1
        return min(n, i + 1)
    return None


def word_before(text, i):
    return i == 0 or not (text[i - 1].isalnum() or text[i - 1] == '_')


def word_after(text, i):
    return i >= len(text) or not (text[i].isalnum() or text[i] == '_')


def load_data_classes():
    data = {}
    for f in sorted((GW / 'app/Data').rglob('*.php')):
        s = f.read_text()
        m = re.search(r'class (\w+)', s)
        if not m:
            continue
        ctor = re.search(r'function __construct\((.*?)\)\s*\{', s, re.S)
        docs = {n: t for t, n in re.findall(r'@param\s+((?:[^\s<]|<[^>]*>)+)\s+\$(\w+)', s)}
        # An inline `/** @var list<X> */` on a promoted constructor property documents it as well.
        docs.update({n: t for t, n in re.findall(r'@var\s+((?:[^\s<]|<[^>]*>)+)\s*\*/\s*public\s+(?:readonly\s+)?[\w|?\\]+\s+\$(\w+)', s)})
        props = []
        if ctor:
            for pm in re.finditer(r'public\s+(?:readonly\s+)?([\w|?\\]+)\s+\$(\w+)(\s*=\s*[^,)]+)?', ctor.group(1)):
                props.append({'name': pm.group(2), 'type': pm.group(1), 'doc': docs.get(pm.group(2))})
        data[m.group(1)] = {
            'props': props,
            'snake': 'SnakeCaseMapper' in s,
            'outputs': output_names(s, [p['name'] for p in props]),
        }
    return data


def load_enums():
    """String-backed enum values, plus Enum::Case names so Rule::in can name a subset."""
    enums = {}
    enum_cases = {}
    pattern = re.compile(r'enum (\w+)(?::\s*string)?\s*(?:implements [\w, \\]+)?\s*\{')
    for f in sorted((GW / 'app').rglob('*.php')):
        s = f.read_text()
        for m in pattern.finditer(s):
            pairs = re.findall(r"case (\w+)\s*=\s*'([^']+)'", block(s, m.start()))
            if not pairs:
                continue
            enums[m.group(1)] = [value for _, value in pairs]
            for case, value in pairs:
                enum_cases[f'{m.group(1)}::{case}'] = value
    return enums, enum_cases


def load_sdk_requests():
    out = []
    files = {f.stem: f for f in (SDK / 'Requests').rglob('*.php')}

    def parse(f):
        s = f.read_text()
        m = re.search(r'(?:final |abstract )?class (\w+)', s)
        if not m or 'abstract class' in s:
            return None
        method = re.search(r'Method::(\w+)', s)
        ep = re.search(r'function resolveEndpoint\(\): string\s*\{\s*return\s*(.+?);', s, re.S)
        ctor = re.search(r'function __construct\((.*?)\)\s*\{', s, re.S)
        body = re.search(r'function defaultBody\(\): array\s*\{(.*?)\n    \}', s, re.S)
        query = re.search(r'function defaultQuery\(\): array\s*\{(.*?)\n    \}', s, re.S)
        row = {
            'file': str(f.relative_to(SDK / 'Requests')),
            'class': m.group(1),
            'method': method.group(1) if method else None,
            'endpoint': re.sub(r'\s+', ' ', ep.group(1)) if ep else None,
            'ctor': re.sub(r'\s+', ' ', ctor.group(1)).strip() if ctor else '',
            'body': re.sub(r'\s+', ' ', body.group(1)).strip() if body else None,
            'query': re.sub(r'\s+', ' ', query.group(1)).strip() if query else None,
        }
        if not row['endpoint']:
            parent = re.search(r'extends (\w+)', s)
            action = re.search(r"function action\(\): string\s*\{\s*return '(\w+)'", s)
            if parent and action and parent.group(1) in files:
                psrc = files[parent.group(1)].read_text()
                pep = re.search(r'function resolveEndpoint\(\): string\s*\{\s*return\s*(.+?);', psrc, re.S)
                pm = re.search(r'Method::(\w+)', psrc)
                pctor = re.search(r'function __construct\((.*?)\)\s*\{', psrc, re.S)
                pbody = re.search(r'function defaultBody\(\): array\s*\{(.*?)\n    \}', psrc, re.S)
                if pep:
                    row['endpoint'] = pep.group(1).replace('{$this->action()}', action.group(1))
                    row['method'] = row['method'] or (pm.group(1) if pm else None)
                    row['ctor'] = row['ctor'] or (re.sub(r'\s+', ' ', pctor.group(1)).strip() if pctor else '')
                    row['body'] = row['body'] or (re.sub(r'\s+', ' ', pbody.group(1)).strip() if pbody else None)
        return row

    for f in sorted(files.values()):
        row = parse(f)
        if row:
            out.append(row)
    return out


def load_sdk_responses():
    out = {}
    for f in sorted((SDK / 'Responses').rglob('*.php')):
        s = f.read_text()
        m = re.search(r'(?:class|interface|enum) (\w+)', s)
        if not m:
            continue
        ctor = re.search(r'function __construct\((.*?)\)\s*\{', s, re.S)
        props = []
        if ctor:
            for pm in re.finditer(r'public\s+(?:readonly\s+)?([\w|?\\]+)\s+\$(\w+)', ctor.group(1)):
                props.append((pm.group(2), pm.group(1)))
        out[m.group(1)] = props
    return out


routes = load_routes()
commands = load_commands()
controllers = load_controllers()
form_requests = load_form_requests()
gdata = load_data_classes()
enums, enum_cases = load_enums()
sdk = load_sdk_requests()
sdkres = load_sdk_responses()

INPUT_PREFIX = re.compile(r'^(Create|Add(?!ed)|Update|Provision|Remove(?!d)|Register|Clone|Prepare|Store|Install|Issue|Bootstrap|Retarget|AppDefinitionInput)')

