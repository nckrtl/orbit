]}


def data_schema_for(route):
    action = route['action']
    if action in RESPONSE_OVERRIDES:
        return RESPONSE_OVERRIDES[action], False
    if action in CTRL_DATA_OVERRIDES:
        cls, is_list = CTRL_DATA_OVERRIDES[action]
        return ref(cls), is_list
    if action in SDK_RESPONSE_FALLBACK:
        return sdk_schema(SDK_RESPONSE_FALLBACK[action]), False
    cands = [c for c in controllers.get(action, {}).get('data', []) if not INPUT_PREFIX.match(c) and c in gdata]
    is_list = action.endswith(('@index', '@processIndex', '@scheduleIndex'))
    if not cands:
        return {'type': 'object'}, is_list
    if action == 'NodesController@show':
        return {'allOf': [ref('NodeData'), {'type': 'object', 'properties': {
            'access': ref('NodeAccessData'),
            'excluded_projects': {'type': 'array', 'items': ref('DevelopmentNodeExclusionData')},
        }}]}, False
    if action == 'AppsController@show':
        return {'allOf': [ref('AppData'), {'type': 'object', 'properties': {
            'excluded_nodes': {'type': 'array', 'items': ref('DevelopmentNodeExclusionData')},
        }}]}, False
    return ref(cands[0]), is_list


