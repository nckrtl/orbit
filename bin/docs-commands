#!/usr/bin/env python3
"""Render the CLI reference pages and the Orbit Agent Skill from the command sources in docs/commands.

Run from any directory:

    bin/docs-commands           write every generated file
    bin/docs-commands --check   exit 1 when a generated file is missing, stale, or no longer has a source

Sources:

    docs/commands/_skill.md              skill frontmatter and the rules that apply to every command
    docs/commands/<family>/_family.md    family page frontmatter, command order, and prose around the commands
    docs/commands/<family>/<slug>.md     one command; the slug is the command name with colons replaced by hyphens

Generated:

    docs/cli/<family>.mdx                              the family page of the CLI tab
    docs/skills/orbit/SKILL.md                         the skill index
    docs/skills/orbit/references/<family>/<slug>.md    one command file for agents
    docs/skills/orbit.json                             the bundle that `orbit skill:install` downloads

Command sources link each other by relative file path, such as `instance-clone.md` or `../node/node-add.md`.
The page rendering turns those into section anchors, and the skill rendering turns root-relative site links
into hosted Markdown URLs, so one source serves both readers.
"""

import hashlib
import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
SOURCES = ROOT / 'docs/commands'
CLI = ROOT / 'docs/cli'
SKILL = ROOT / 'docs/skills/orbit'
BUNDLE = ROOT / 'docs/skills/orbit.json'
NAVIGATION = ROOT / 'docs/docs.json'
SITE = 'https://orbit.nckrtl.com/docs'
PLACEHOLDER = '{/* commands */}'
BUNDLE_FORMAT = 1


def marker(family):
    return f'{{/* Generated by bin/docs-commands from docs/commands/{family}/. Edit the sources there, then run bin/docs-commands. */}}'


# ---------------------------------------------------------------- sources
def read_source(path):
    """Return (frontmatter dict, body) for a Markdown source with quoted scalar keys and one list key."""
    text = path.read_text(encoding='utf-8')
    match = re.match(r'---\n(.*?)\n---\n', text, re.S)
    if match is None:
        sys.exit(f'{path.relative_to(ROOT)} must start with YAML frontmatter.')
    data = {}
    key = None
    for line in match.group(1).split('\n'):
        item = re.match(r'\s+- (.+)$', line)
        if item and key:
            data[key].append(item.group(1).strip())
            continue
        pair = re.match(r'([A-Za-z]+):\s*(.*)$', line)
        if pair is None:
            sys.exit(f'{path.relative_to(ROOT)} has an unsupported frontmatter line: {line}')
        key, value = pair.groups()
        data[key] = [] if value == '' else json.loads(value) if value.startswith('"') else value
    return data, text[match.end():].strip('\n') + '\n'


def frontmatter(**fields):
    return '---\n' + ''.join(f'{key}: {json.dumps(value, ensure_ascii=False)}\n' for key, value in fields.items() if value is not None) + '---\n'


def slug(name):
    return name.replace(':', '-')


def anchor(name):
    return 'orbit-' + name.replace(':', '')


def load():
    """Read every family and command source into one structure keyed by family."""
    families = {}
    for family_file in sorted(SOURCES.glob('*/_family.md')):
        family = family_file.parent.name
        data, body = read_source(family_file)
        if PLACEHOLDER not in body:
            sys.exit(f'docs/commands/{family}/_family.md must contain {PLACEHOLDER}.')
        names = data.get('commands')
        if not isinstance(names, list) or names == []:
            sys.exit(f'docs/commands/{family}/_family.md must list its commands.')
        commands = []
        for name in names:
            path = family_file.parent / f'{slug(name)}.md'
            if not path.is_file():
                sys.exit(f'docs/commands/{family}/{slug(name)}.md is missing for {name}.')
            command, command_body = read_source(path)
            if command.get('title') != name:
                sys.exit(f'{path.relative_to(ROOT)} must carry title "{name}".')
            commands.append({'name': name, 'slug': slug(name), 'description': command['description'], 'body': command_body})
        expected = {f'{slug(name)}.md' for name in names} | {'_family.md'}
        extra = sorted(p.name for p in family_file.parent.iterdir() if p.name not in expected)
        if extra:
            sys.exit(f'docs/commands/{family}/ has files that no command lists: {", ".join(extra)}.')
        families[family] = {'title': data['title'], 'description': data['description'], 'body': body, 'commands': commands}
    if not families:
        sys.exit('docs/commands has no family sources.')
    return families


def command_index(families):
    return {(family, command['slug']): command['name'] for family, data in families.items() for command in data['commands']}


def groups(families):
    """Return [(group, [family, ...])] in the order of the CLI tab in docs.json."""
    navigation = json.loads(NAVIGATION.read_text(encoding='utf-8'))
    tab = next(tab for tab in navigation['navigation']['tabs'] if tab['tab'] == 'CLI')
    result = []
    for group in tab['groups']:
        members = [page.removeprefix('cli/') for page in group['pages'] if page.removeprefix('cli/') in families]
        if members:
            result.append((group['group'], members))
    listed = {family for _, members in result for family in members}
    missing = sorted(set(families) - listed)
    if missing:
        sys.exit(f'docs/docs.json does not list the CLI page of: {", ".join(missing)}.')
    return result


# ---------------------------------------------------------------- transforms
def outside_fences(text, transform):
    """Apply transform to every line outside fenced code blocks."""
    lines = []
    fenced = False
    for line in text.split('\n'):
        if line.startswith('```'):
            fenced = not fenced
            lines.append(line)
        else:
            lines.append(line if fenced else transform(line))
    return '\n'.join(lines)


LINK = re.compile(r'\]\(([^)\s]+)\)')


def rewrite_links(text, rewrite):
    return outside_fences(text, lambda line: LINK.sub(lambda m: '](' + rewrite(m.group(1)) + ')', line))


def relative_target(target, family, index):
    """Resolve a relative command link to (family, slug) or None."""
    same = re.fullmatch(r'([a-z0-9-]+)\.md(?:#.*)?', target)
    if same and (family, same.group(1)) in index:
        return family, same.group(1)
    other = re.fullmatch(r'\.\./([a-z]+)/([a-z0-9-]+)\.md(?:#.*)?', target)
    if other and (other.group(1), other.group(2)) in index:
        return other.group(1), other.group(2)
    if same or other:
        sys.exit(f'Command link [{target}] in docs/commands/{family}/ names no command source.')
    return None


def page_link(target, family, index):
    resolved = relative_target(target, family, index)
    if resolved is None:
        return target
    other_family, other_slug = resolved
    fragment = '#' + anchor(index[resolved])
    return fragment if other_family == family else f'/cli/{other_family}{fragment}'


def skill_link(target, family, index):
    if relative_target(target, family, index) is not None:
        return target
    site = re.fullmatch(r'/cli/([a-z]+)#orbit-([a-z0-9-]+)', target)
    if site:
        for (other_family, other_slug), name in index.items():
            if other_family == site.group(1) and anchor(name) == 'orbit-' + site.group(2):
                return f'{other_slug}.md' if other_family == family else f'../{other_family}/{other_slug}.md'
    if target.startswith('/'):
        path, _, fragment = target.partition('#')
        return SITE + path + '.md' + ('#' + fragment if fragment else '')
    return target


def shift_headings(text):
    return outside_fences(text, lambda line: '#' + line if line.startswith('#') else line)


def callouts_to_markdown(text):
    """Turn <Note> and <Warning> blocks into blockquotes for agents that read the raw file."""
    def replace(match):
        body = ' '.join(line.strip() for line in match.group(2).strip().split('\n'))
        return f'> **{match.group(1)}:** {body}'
    return re.sub(r'<(Note|Warning)>\n(.*?)\n</\1>', replace, text, flags=re.S)


# ---------------------------------------------------------------- renderers
def render_page(family, data, index):
    sections = []
    for command in data['commands']:
        body = shift_headings(rewrite_links(command['body'], lambda target: page_link(target, family, index)))
        sections.append(f"## orbit {command['name']}\n\n{body}")
    body = data['body'].replace(PLACEHOLDER, '\n'.join(sections).rstrip('\n'))
    return frontmatter(title=data['title'], description=data['description']) + '\n' + marker(family) + '\n\n' + body


def render_reference(family, command, index):
    body = callouts_to_markdown(rewrite_links(command['body'], lambda target: skill_link(target, family, index)))
    return frontmatter(title=command['name'], description=command['description']) + f"\n# {command['name']}\n\n{body}"


def render_skill_index(families):
    data, body = read_source(SOURCES / '_skill.md')
    lines = [frontmatter(name=data['name'], description=data['description']), body, '## Command index', '',
             'Each family lists its commands. Open the command file before you run the command.', '']
    for group, members in groups(families):
        lines += [f'### {group}', '']
        for family in members:
            lines += [f"**{family}**: {families[family]['description']}", '', '| Task | Command file |', '| --- | --- |']
            for command in families[family]['commands']:
                lines.append(f"| {command['description']} | [{command['name']}](references/{family}/{command['slug']}.md) |")
            lines.append('')
    return '\n'.join(lines)


def render_bundle(skill_files):
    files = [{'path': path, 'sha256': hashlib.sha256(contents.encode('utf-8')).hexdigest(), 'contents': contents}
             for path, contents in sorted(skill_files.items())]
    return json.dumps({'format': BUNDLE_FORMAT, 'skill': 'orbit', 'files': files}, indent=2, ensure_ascii=False) + '\n'


def render_all():
    """Return {absolute path: contents} for every generated file."""
    families = load()
    index = command_index(families)
    outputs = {}
    skill_files = {'SKILL.md': render_skill_index(families)}
    for family, data in families.items():
        outputs[CLI / f'{family}.mdx'] = render_page(family, data, index)
        for command in data['commands']:
            skill_files[f"references/{family}/{command['slug']}.md"] = render_reference(family, command, index)
    for path, contents in skill_files.items():
        outputs[SKILL / path] = contents
    outputs[BUNDLE] = render_bundle(skill_files)
    return outputs


def stale_files(outputs):
    """Generated files on disk that no source produces any more."""
    stale = [path for path in SKILL.rglob('*') if path.is_file() and path not in outputs]
    for page in CLI.glob('*.mdx'):
        if page not in outputs and marker(page.stem) in page.read_text(encoding='utf-8'):
            stale.append(page)
    return sorted(stale)


def main():
    outputs = render_all()
    stale = stale_files(outputs)
    if '--check' in sys.argv[1:]:
        problems = [f'{path.relative_to(ROOT)} is missing or out of date.' for path, contents in outputs.items()
                    if not path.is_file() or path.read_text(encoding='utf-8') != contents]
        problems += [f'{path.relative_to(ROOT)} has no source any more.' for path in stale]
        if problems:
            sys.exit('\n'.join(problems) + '\nRun bin/docs-commands.')
        return
    for path in stale:
        path.unlink()
    for path, contents in outputs.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(contents, encoding='utf-8')
    print(f'Wrote {len(outputs)} generated files and removed {len(stale)} stale files.')


if __name__ == '__main__':
    main()
