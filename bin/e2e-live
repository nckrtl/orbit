#!/usr/bin/env bash
# One end-to-end run of the feature flow against a standby built from one exact
# candidate commit in a validation clone. See docs/reference/incus-topologies.md.
set -euo pipefail

usage() {
    cat <<'EOF'
usage: bin/e2e-live <candidate-sha>

Runs apps/e2e/tests/Live/LegacyStandbyRecoveryAcceptanceTest.php and
TopologyLedLifecycleAcceptanceTest.php (issue ACC-1) against real Incus
resources from a validation clone. It first proves that ordinary rebuild
refuses present resources, runs recover-legacy, and verifies its retained
evidence. It then runs acquire, exec, release, proof, promotion, and the
remaining topology lifecycle with proofs/ACC-1.json.

The clone owns its own standby (ORBIT_E2E_STANDBY_NAMESPACE=live:
orbit-e2e-live-standby-<role> on oe-live-standby), so the promote step never
touches the standby of the repository's primary checkout and a run needs no
manual file copy afterwards.

The wrapper owns the validation clone, which is its own primary checkout:
  ORBIT_E2E_VALIDATE_ROOT  clone path (default: $HOME/orbit-validate); cloned
                           from this repository when absent
  ORBIT_E2E_INCUS_PROJECT  Incus project the harness uses (default: default)
  ORBIT_E2E_INCUS_REMOTE   Incus remote the harness uses (default: local)

It fetches the candidate, checks the clone out on `main` at the candidate,
resets the linked worktree .worktrees/acc-1 (branch acc-1-live), bootstraps
both, refreshes the clone's standby to the candidate (rebuilding it from the
base image when no resources exist, or resuming retained legacy recovery when
exact resources remain without a promoted generation), exports every
ORBIT_LIVE_* input, and runs the suite. It refuses only while another
acceptance (ACC-*) topology is live on the Incus host: feature topologies of
other issues share nothing with this run. It releases a stale ACC-1 attempt,
and holds <clone>/.e2e/locks/live.lock so only one run drives the clone.

The run ends with one summary line to paste into the pull request:
  lifecycle: passed, <assertions> assertions, <seconds> s
EOF
}

fail() {
    printf 'e2e-live: %s\n' "$1" >&2
    exit "${2:-1}"
}

log() {
    printf '[e2e-live %s] %s\n' "$(date -u +%H:%M:%S)" "$1" >&2
}

candidate=''
for argument in "$@"; do
    case "$argument" in
        --help|-h)
            usage
            exit 0
            ;;
        --*)
            usage >&2
            fail "unknown option: $argument" 64
            ;;
        *)
            if [[ -n "$candidate" ]]; then
                usage >&2
                fail "unexpected argument: $argument" 64
            fi
            candidate=$argument
            ;;
    esac
done

if [[ -z "$candidate" ]]; then
    usage >&2
    exit 64
fi
if [[ ! "$candidate" =~ ^[0-9a-f]{40}$ ]]; then
    fail 'candidate SHA must be 40 hexadecimal characters' 64
fi

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
validate=${ORBIT_E2E_VALIDATE_ROOT:-$HOME/orbit-validate}
# The clone is a second primary checkout on this host: it owns the `live`
# standby, never the standby of the repository this wrapper runs from.
export ORBIT_E2E_STANDBY_NAMESPACE=live
incus_project=${ORBIT_E2E_INCUS_PROJECT:-default}
incus_remote=${ORBIT_E2E_INCUS_REMOTE:-local}
export PYTHONDONTWRITEBYTECODE=1
lock_directory=$validate/.e2e/locks
profile=gateway_app-dev_app-prod
issue=ACC-1
feature_worktree=$validate/.worktrees/acc-1
plan=proofs/ACC-1.json

# One live run at a time: two runs would race on the clone, the standby, and ACC-1.
# The lock comes before every other prerequisite so a held lock always exits 75.
command -v flock >/dev/null 2>&1 || fail 'flock is required'
mkdir -p "$lock_directory"
exec 9>"$lock_directory/live.lock"
flock --nonblocking 9 || fail "another bin/e2e-live run holds $lock_directory/live.lock" 75

for tool in git jq composer php incus; do
    command -v "$tool" >/dev/null 2>&1 || fail "$tool is required"
done
git -C "$root" rev-parse --verify --quiet "${candidate}^{commit}" >/dev/null \
    || fail "candidate $candidate is not a commit in $root"
if [[ -e "$validate" && "$(cd "$validate" && pwd -P)" == "$(cd "$root" && pwd -P)" ]]; then
    fail 'the validation clone must not be this repository'
fi

# The clone has its own standby, so another issue's topology is no conflict.
# Only another acceptance topology collides: it would race this run's own issue.
live_issues=$(incus --project "$incus_project" list "$incus_remote:" --format json \
    | jq -r --arg issue "$issue" '[.[] | select(.config["user.orbit.e2e.owner"] == "orbit-e2e")
        | .config["user.orbit.e2e.issue"] // empty] | unique | map(select(. != $issue))
        | map(select(startswith("ACC-"))) | join(", ")') \
    || fail 'unable to list the harness instances on the Incus host'
if [[ -n "$live_issues" ]]; then
    fail "an acceptance topology is live on the Incus host ($live_issues); release it before running the live suite"
fi

# Validation clone on main at the candidate.
if [[ ! -d "$validate/.git" ]]; then
    log "cloning $root into $validate"
    git clone --quiet "$root" "$validate"
fi
# The harness state under .e2e/ is not part of the checkout, whatever the candidate's .gitignore says.
if [[ -n "$(git -C "$validate" status --porcelain --untracked-files=all -- . ':!.e2e')" ]]; then
    fail "the validation clone $validate is dirty"
fi
log "fetching $candidate into $validate"
git -C "$validate" fetch --quiet --no-tags "$root" "$candidate"
git -C "$validate" checkout --quiet -B main "$candidate"

if [[ -d "$feature_worktree" ]]; then
    if [[ -n "$(git -C "$feature_worktree" status --porcelain --untracked-files=all -- . ':!.e2e')" ]]; then
        fail "the linked worktree $feature_worktree is dirty"
    fi
    git -C "$feature_worktree" checkout --quiet -B acc-1-live "$candidate"
else
    git -C "$validate" worktree add --quiet -B acc-1-live "$feature_worktree" "$candidate"
fi

gateway_env=$feature_worktree/apps/gateway/.env
remove_guest_gateway_env() {
    # The guests mount the feature worktree, and convergence writes guest paths
    # there. Host bootstrap and the next convergence each write what they need.
    if [[ -f "$gateway_env" ]] && grep -q '^ORBIT_HOME=/home/orbit/' "$gateway_env"; then
        log "removing the guest-written apps/gateway/.env from $feature_worktree"
        rm -f "$gateway_env"
    fi
}

bootstrap_validation() {
    local bootstrap_logs
    local index
    local target
    local -a bootstrap_pids=()
    local -a bootstrap_targets=("$validate" "$feature_worktree")

    bootstrap_logs=$(mktemp -d)
    for target in "${bootstrap_targets[@]}"; do
        log "bootstrapping $target"
        "$target/bin/bootstrap" >"$bootstrap_logs/$(basename "$target").log" 2>&1 &
        bootstrap_pids+=("$!")
    done
    for index in "${!bootstrap_targets[@]}"; do
        if ! wait "${bootstrap_pids[$index]}"; then
            cat "$bootstrap_logs/$(basename "${bootstrap_targets[$index]}").log" >&2
            fail "bootstrap failed for ${bootstrap_targets[$index]}"
        fi
    done
    rm -rf "$bootstrap_logs"
}

checkout_validation_sha() {
    local sha=$1

    remove_guest_gateway_env
    git -C "$validate" fetch --quiet --no-tags "$root" "$sha"
    git -C "$validate" checkout --quiet -B main "$sha"
    git -C "$feature_worktree" checkout --quiet -B acc-1-live "$sha"
    bootstrap_validation
}

remove_guest_gateway_env
bootstrap_validation

harness() {
    "$validate/bin/e2e-$1" "${@:2}" --json
}

primary_inventory() {
    {
        incus --project "$incus_project" list "$incus_remote:" --format json
        incus --project "$incus_project" network list "$incus_remote:" --format json
    } | jq -S -s '
        def stable_config:
            with_entries(select(.key | startswith("volatile.") | not));
        {
            instances: (
                .[0]
                | map(select(.name | startswith("orbit-e2e-standby-")))
                | map({
                    name,
                    type,
                    status,
                    project,
                    config: ((.config // {}) | stable_config),
                    devices: (.expanded_devices // .devices // {})
                })
                | sort_by(.name)
            ),
            networks: (
                .[1]
                | map(select(.name == "oe-standby"))
                | map({
                    name,
                    type,
                    managed,
                    config: ((.config // {}) | stable_config)
                })
                | sort_by(.name)
            )
        }'
}

assert_rebuild_refusal() {
    local refusal=$1
    local before_refusal=$2
    local after_refusal
    local resource

    for resource in \
        orbit-e2e-live-standby-gateway \
        orbit-e2e-live-standby-app-dev \
        orbit-e2e-live-standby-app-prod \
        oe-live-standby; do
        jq -e --arg resource "$resource" '.error | contains($resource)' <<<"$refusal" >/dev/null \
            || fail "ordinary rebuild did not name $resource"
    done
    jq -e '.error | contains("recover-legacy")' <<<"$refusal" >/dev/null \
        || fail 'ordinary rebuild did not name the supported legacy recovery command'
    after_refusal=$(harness standby status 2>/dev/null || true)
    if [[ "$(jq -S . <<<"$after_refusal")" != "$(jq -S . <<<"$before_refusal")" ]]; then
        fail 'ordinary rebuild changed the live standby before refusing'
    fi
}

prepare_network_only() {
    local instances
    local networks
    local resource

    instances=$(incus --project "$incus_project" list "$incus_remote:" --format json) \
        || fail 'unable to inventory the live standby before network-only recovery'
    jq -e '[.[] | select(
        .name == "orbit-e2e-live-standby-gateway-next"
        or .name == "orbit-e2e-live-standby-app-dev-next"
        or .name == "orbit-e2e-live-standby-app-prod-next"
    )] | length == 0' <<<"$instances" >/dev/null \
        || fail 'a promotion copy blocks the network-only proof setup'
    for resource in \
        orbit-e2e-live-standby-gateway \
        orbit-e2e-live-standby-app-dev \
        orbit-e2e-live-standby-app-prod; do
        jq -e --arg resource "$resource" '
            [.[] | select(.name == $resource)]
            | length == 1
                and .[0].config["user.orbit.e2e.owner"] == "orbit-e2e"
                and (.[0].config["user.orbit.e2e.issue"] // "") == ""
        ' <<<"$instances" >/dev/null \
            || fail "the network-only proof cannot remove unowned or ambiguous instance $resource"
        incus --project "$incus_project" delete "$incus_remote:$resource" --force \
            || fail "unable to remove exact proof instance $resource"
    done

    instances=$(incus --project "$incus_project" list "$incus_remote:" --format json) \
        || fail 'unable to verify the network-only instance boundary'
    jq -e '[.[] | select(.name | startswith("orbit-e2e-live-standby-"))] | length == 0' \
        <<<"$instances" >/dev/null \
        || fail 'an exact live standby instance remains after network-only proof setup'
    networks=$(incus --project "$incus_project" network list "$incus_remote:" --format json) \
        || fail 'unable to verify the network-only network boundary'
    jq -e '[.[] | select(.name == "oe-live-standby")]
        | length == 1
            and .[0].config["user.orbit.e2e.owner"] == "orbit-e2e"
            and (.[0].used_by // []) == []' <<<"$networks" >/dev/null \
        || fail 'the exact owned live standby network is not retained without users'
}

# A stale attempt of the suite's own issue blocks its first assertion.
stale=$(harness topology status "$issue" "--worktree=$feature_worktree" | jq -r '.attempt_id // empty')
if [[ -n "$stale" ]]; then
    log "releasing stale $issue attempt $stale"
    harness topology release "$issue" "--worktree=$feature_worktree" >/dev/null
fi

export ORBIT_LIVE_INCUS=1
export ORBIT_LIVE_PROFILE=$profile
export ORBIT_LIVE_ISSUE=$issue
export ORBIT_LIVE_MAIN_WORKTREE=$validate
export ORBIT_LIVE_FEATURE_WORKTREE=$feature_worktree
export ORBIT_LIVE_CANDIDATE_SHA=$candidate
export ORBIT_LIVE_PROOF_PLAN=$validate/$plan

recovery_record=$validate/.e2e/standby/recovery.json
if [[ -f "$recovery_record" ]]; then
    retained_phase=$(jq -er '.phase | strings' "$recovery_record") \
        || fail 'the retained legacy recovery phase is invalid'
    if [[ "$retained_phase" != construction_verified ]]; then
        retained_sha=$(jq -er '.main_sha | strings' "$recovery_record") \
            || fail 'the retained legacy recovery SHA is invalid'
        if [[ ! "$retained_sha" =~ ^[0-9a-f]{40}$ ]]; then
            fail 'the retained legacy recovery SHA is invalid'
        fi
        if [[ "$retained_sha" != "$candidate" ]]; then
            log "checking out retained legacy recovery SHA $retained_sha"
            checkout_validation_sha "$retained_sha"
        fi
        log "resuming retained legacy recovery at its recorded SHA $retained_sha"
        retained_refresh=$(harness standby recover-legacy "--main-sha=$retained_sha") || {
            printf '%s\n' "$retained_refresh" >&2
            fail "retained legacy standby recovery at $retained_sha failed"
        }
        if [[ "$retained_sha" != "$candidate" ]]; then
            log "restoring candidate SHA $candidate after retained recovery"
            checkout_validation_sha "$candidate"
        fi
    fi
fi

# The clone is its own primary: its <clone>/.e2e/standby/promoted.json names
# only its live standby generation. Create one when this is a fresh clone, then
# exercise the explicit schema-4/5 recovery on every proof run.
primary_before=$(primary_inventory) || fail 'unable to inventory the primary standby before live recovery'
set +e
standby_status=$(harness standby status)
standby_status_code=$?
set -e
standby_state=$(jq -r '.state // "invalid"' <<<"$standby_status") \
    || fail 'standby status did not return JSON'
if [[ "$standby_state" == missing && $standby_status_code -eq 0 ]]; then
    log "building the clone's missing live standby at $candidate (cold build, several minutes)"
    set +e
    initial=$(harness standby rebuild "--main-sha=$candidate")
    initial_status=$?
    set -e
    if ((initial_status != 0)); then
        if ! jq -e '.error | contains("recover-legacy")' <<<"$initial" >/dev/null; then
            printf '%s\n' "$initial" >&2
            fail "initial standby build at $candidate failed"
        fi
        assert_rebuild_refusal "$initial" "$standby_status"
        log "resuming legacy standby recovery at $candidate (cold build, several minutes)"
        refresh=$(harness standby recover-legacy "--main-sha=$candidate") || {
            printf '%s\n' "$refresh" >&2
            fail "legacy standby recovery at $candidate failed"
        }
    fi
    standby_status=$(harness standby status) || fail 'the initial live standby is unavailable'
    standby_state=$(jq -r '.state' <<<"$standby_status")
elif [[ "$standby_state" != promoted && "$standby_state" != stale ]]; then
    printf '%s\n' "$standby_status" >&2
    fail "the live standby state $standby_state cannot enter legacy recovery"
fi

standby_schema=$(jq -r '.generation.schema // 5' <<<"$standby_status")
if [[ "$standby_schema" != 4 && "$standby_schema" != 5 ]]; then
    fail "the live standby manifest schema $standby_schema is not eligible for legacy recovery"
fi

live_instance_count=$(incus --project "$incus_project" list "$incus_remote:" --format json \
    | jq '[.[] | select(.name | startswith("orbit-e2e-live-standby-"))] | length') \
    || fail 'unable to count exact live standby instances'
live_network_count=$(incus --project "$incus_project" network list "$incus_remote:" --format json \
    | jq '[.[] | select(.name == "oe-live-standby")] | length') \
    || fail 'unable to count the exact live standby network'
if [[ "$live_instance_count" == 0 && "$live_network_count" == 1 ]]; then
    log "normalizing a retained network-only live standby at $candidate (cold build, several minutes)"
    refresh=$(harness standby recover-legacy "--main-sha=$candidate") || {
        printf '%s\n' "$refresh" >&2
        fail "retained network-only standby recovery at $candidate failed"
    }
    standby_status=$(harness standby status) || fail 'the normalized live standby is unavailable'
fi

log 'proving ordinary rebuild refuses the present live standby before mutation'
if refusal=$(harness standby rebuild "--main-sha=$candidate"); then
    printf '%s\n' "$refusal" >&2
    fail 'ordinary rebuild accepted present live standby resources'
fi
assert_rebuild_refusal "$refusal" "$standby_status"

log 'retaining the network while removing exact proof VMs'
prepare_network_only
log 'writing a network-only retained recovery record'
(cd "$validate/apps/e2e" && vendor/bin/pest --no-tia --compact --colors=never \
    --group=incus-live-network-record tests/Live/LegacyStandbyRecoveryAcceptanceTest.php) \
    || fail 'the network-only retained recovery record was not written'
jq -e '.phase == "authorized"
    and (.inventory.instances | type == "array" and length == 0)
    and (.inventory.snapshots | type == "array" and length == 0)' \
    "$validate/.e2e/standby/recovery.json" >/dev/null \
    || fail 'the retained network-only recovery record is not exact'

log "resuming the network-only recovery in a fresh process at $candidate (cold build, several minutes)"
refresh=$(harness standby recover-legacy "--main-sha=$candidate") || {
    printf '%s\n' "$refresh" >&2
    fail "network-only legacy standby recovery at $candidate failed"
}
jq -e '.phase == "construction_verified"
    and (.inventory.instances | type == "array" and length == 0)
    and (.inventory.snapshots | type == "array" and length == 0)
    and any(.history[]; .phase == "resumed")' \
    "$validate/.e2e/standby/recovery.json" >/dev/null \
    || fail 'the fresh process did not resume and complete the network-only recovery'
log "standby: $(jq -r '.state' <<<"$refresh") ($(jq -r '.generation_id' <<<"$refresh"))"
primary_after=$(primary_inventory) || fail 'unable to inventory the primary standby after live recovery'
if [[ "$(jq -S . <<<"$primary_after")" != "$(jq -S . <<<"$primary_before")" ]]; then
    fail 'legacy recovery changed the primary standby inventory'
fi

remove_guest_gateway_env
log 'running the lifecycle suite'
started=$SECONDS
output=$(mktemp -t orbit-e2e-live.XXXXXX.log)
set +e
(cd "$validate/apps/e2e" && vendor/bin/pest --no-tia --compact --colors=never --group=incus-live \
    tests/Live/LegacyStandbyRecoveryAcceptanceTest.php \
    tests/Live/TopologyLedLifecycleAcceptanceTest.php) 2>&1 | tee "$output" >&2
status=${PIPESTATUS[0]}
set -e
seconds=$((SECONDS - started))
assertions=$(sed 's/\x1b\[[0-9;]*m//g' "$output" | grep -oE '\(([0-9]+) assertions?\)' | tail -1 | tr -dc '0-9')
rm -f "$output"
if ((status != 0)); then
    printf '\nlifecycle: FAILED after %s s (%s assertions)\n' "$seconds" "${assertions:-0}"
    fail 'the lifecycle suite failed'
fi

printf '\nlifecycle: passed, %s assertions, %s s\n' "${assertions:-?}" "$seconds"
