#!/usr/bin/env python3
"""Run the configured delivery controller from main or an issue worktree."""
import os
from pathlib import Path
import subprocess
import sys


def main():
    checkout = Path(__file__).resolve().parent.parent
    common = subprocess.check_output(
        ['git', '-C', str(checkout), 'rev-parse', '--path-format=absolute', '--git-common-dir'],
        text=True,
    ).strip()
    primary = str(Path(common).parent)
    driver = subprocess.run(
        ['git', '-C', str(checkout), 'config', '--path', '--get', 'orbit.deliveryDriver'],
        capture_output=True,
        text=True,
    )
    path = Path(driver.stdout.strip()) if driver.returncode == 0 else None
    if path is None or not path.is_absolute() or not path.is_file():
        raise RuntimeError('Set orbit.deliveryDriver to the absolute path of the installed delivery controller.')
    os.execv(str(path), [str(path), '--repository', primary, *sys.argv[1:]])


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
