#!/usr/bin/env bash

# Run a command and strip ANSI CSI sequences from its combined output.
# Pest's parallel printer writes a cursor-up before the process count even
# with --colors=never. Callers pass that flag; this keeps the Tests summary.

set -euo pipefail

if (($# == 0)); then
    printf 'usage: bin/pest-plain command [arguments]\n' >&2
    exit 2
fi

python3 "$(dirname "${BASH_SOURCE[0]}")/task-feedback-tests" "$@" 2>&1 | php -r '
stream_set_write_buffer(STDOUT, 0);
$pending = "";
while (($chunk = fread(STDIN, 8192)) !== false && $chunk !== "") {
    $pending .= $chunk;
    $clean = preg_replace("/\e\[[\d;?]*[[:alpha:]]/", "", $pending);
    if (! is_string($clean)) {
        fwrite(STDERR, "Could not strip ANSI sequences.\n");
        exit(1);
    }
    if (preg_match("/\e(?:\[[\d;?]*)?$/", $clean, $match, PREG_OFFSET_CAPTURE) === 1) {
        $offset = $match[0][1];
        echo substr($clean, 0, $offset);
        fflush(STDOUT);
        $pending = substr($clean, $offset);
        continue;
    }
    echo $clean;
    fflush(STDOUT);
    $pending = "";
}
echo $pending;
fflush(STDOUT);
'
