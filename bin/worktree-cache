#!/usr/bin/env python3
"""Seed missing, portable quality caches from compatible Git worktrees."""

import argparse
import base64
import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import tempfile


PROJECTS = ("apps/cli", "apps/docs", "apps/gateway", "apps/e2e", "packages/php-sdk")
CACHES = (
    ("Pint", "pint.json", "vendor/pint.cache"),
    ("PHPStan", "phpstan.neon", "vendor/phpstan/cache/resultCache.php"),
)


def worktrees(root):
    try:
        result = subprocess.run(
            ["git", "-C", str(root), "worktree", "list", "--porcelain", "-z"],
            capture_output=True,
            check=False,
        )
    except OSError:
        return []
    if result.returncode != 0:
        return []
    return [
        Path(os.fsdecode(field[len(b"worktree "):])).resolve()
        for field in result.stdout.split(b"\0")
        if field.startswith(b"worktree ")
    ]


def fingerprint(project, config):
    try:
        return ((project / "composer.lock").read_bytes(), (project / config).read_bytes())
    except OSError:
        return None


def copy_missing(source, destination):
    """Publish a complete, independent copy without replacing an existing cache."""
    destination.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".cache-seed-", dir=destination.parent)
    try:
        with os.fdopen(descriptor, "wb") as output, source.open("rb") as input_file:
            shutil.copyfileobj(input_file, output)
        try:
            os.link(temporary, destination)
        except FileExistsError:
            return False
        return True
    finally:
        os.unlink(temporary)


def seed_publication(root, project, tool, config, destination):
    """Prefer durable main publications, including after their feature worktrees leave."""
    try:
        common = Path(subprocess.check_output(
            ['git', '-C', str(root), 'rev-parse', '--path-format=absolute', '--git-common-dir'],
            text=True, stderr=subprocess.DEVNULL).strip())
        path = common / 'orbit-tia/v1/quality' / project.replace('/', '-') / (tool.lower() + '.json')
        snapshot = json.loads(path.read_text())
        if (snapshot.get('schema') != 1 or snapshot.get('project') != project
                or snapshot.get('tool') != tool.lower()):
            return False
        expected = fingerprint(root / project, config)
        if expected is None:
            return False
        runtime = subprocess.check_output(
            ['php', '-r', 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;'], text=True).strip()
        identity = hashlib.sha256(expected[0] + b'\0' + expected[1] + b'\0' + runtime.encode()).hexdigest()
        if snapshot.get('fingerprint') != identity:
            return False
        commit = snapshot['tested_commit']
        if not isinstance(commit, str) or len(commit) not in (40, 64) or any(c not in '0123456789abcdef' for c in commit):
            return False
        if subprocess.run(['git', '-C', str(root), 'merge-base', '--is-ancestor', commit, 'HEAD'],
                          capture_output=True).returncode:
            return False
        data = base64.b64decode(snapshot['data'], validate=True)
        if not data or hashlib.sha256(data).hexdigest() != snapshot['sha256']:
            return False
        destination.parent.mkdir(parents=True, exist_ok=True)
        descriptor, temporary = tempfile.mkstemp(prefix='.cache-publication-', dir=destination.parent)
        try:
            with os.fdopen(descriptor, 'wb') as output:
                output.write(data)
            try:
                os.link(temporary, destination)
            except FileExistsError:
                return True
        finally:
            os.unlink(temporary)
        print(f'[{project}] seeded {tool} cache from published main {commit[:12]}')
        return True
    except (OSError, ValueError, KeyError, TypeError, AttributeError, subprocess.CalledProcessError):
        return False


def seed(root):
    sources = [source for source in worktrees(root) if source != root]
    for relative_project in PROJECTS:
        project = root / relative_project
        for tool, config, relative_cache in CACHES:
            destination = project / relative_cache
            if os.path.lexists(destination):
                continue
            if seed_publication(root, relative_project, tool, config, destination):
                continue
            expected = fingerprint(project, config)
            if expected is None:
                continue
            candidates = []
            for source in sources:
                source_project = source / relative_project
                if fingerprint(source_project, config) != expected:
                    continue
                cache = source_project / relative_cache
                try:
                    info = cache.lstat()
                except OSError:
                    continue
                if stat.S_ISREG(info.st_mode) and info.st_size > 0:
                    candidates.append((info.st_mtime_ns, cache))
            for _, source in sorted(candidates, key=lambda item: item[0], reverse=True):
                try:
                    copied = copy_missing(source, destination)
                except OSError:
                    # A cache can disappear while another worktree is removed or checked.
                    continue
                if copied:
                    print(f"[{relative_project}] seeded {tool} cache from {source}")
                break


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--worktree", type=Path, default=Path(__file__).resolve().parent.parent)
    args = parser.parse_args()
    seed(args.worktree.resolve())


if __name__ == "__main__":
    main()
