#!/usr/bin/env python3
"""Version .loop separately, without changing the candidate or its index."""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile


def git(*args, data=None, env=None):
    result = subprocess.run(['git', *args], input=data, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, env=env, check=False)
    if result.returncode:
        raise RuntimeError(result.stderr.decode().strip())
    return result.stdout


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['save', 'publish', 'fetch'])
    parser.add_argument('issue')
    parser.add_argument('--candidate', help='Exact candidate SHA for fetch (default HEAD)')
    args = parser.parse_args()
    if not re.fullmatch(r'[A-Z]+-[0-9]+', args.issue):
        parser.error('issue must be an uppercase issue identifier')
    root = Path(git('rev-parse', '--show-toplevel').decode().strip())
    os.chdir(root)
    candidate = args.candidate or git('rev-parse', 'HEAD').decode().strip()
    if not re.fullmatch(r'[0-9a-f]{40}', candidate):
        parser.error('candidate must be a full SHA')
    ref = f'refs/tags/loop/{args.issue.lower()}/{candidate}'
    if args.action == 'fetch':
        git('fetch', 'origin', f'{ref}:{ref}')
        print(json.dumps({'candidate': candidate, 'ref': ref,
                          'artifacts': git('rev-parse', ref).decode().strip()}))
        return
    if args.candidate:
        parser.error('--candidate is only valid with fetch')
    if git('ls-tree', '-r', '--name-only', candidate, '--', '.loop').strip():
        raise RuntimeError('Remove tracked .loop entries from the candidate before saving artifacts; keep the local files.')
    directory = root / '.loop'
    if not directory.is_dir() or directory.is_symlink():
        raise RuntimeError('A regular .loop directory is required.')
    for path in directory.rglob('*'):
        if path.is_symlink() or not (path.is_file() or path.is_dir()):
            raise RuntimeError(f'Artifact must be a regular file or directory: {path}')
    with tempfile.TemporaryDirectory(prefix='orbit-loop-index-') as temporary:
        env = dict(os.environ, GIT_INDEX_FILE=str(Path(temporary) / 'index'))
        git('read-tree', candidate, env=env)
        git('add', '-f', '--', '.loop', env=env)
        tree = git('write-tree', env=env).decode().strip()
        ref = ref if args.action == 'publish' else f'refs/orbit/loop/{args.issue.lower()}/draft'
        old = subprocess.run(['git', 'rev-parse', '--verify', ref], capture_output=True)
        previous = old.stdout.decode().strip() if old.returncode == 0 else '0' * 40
        if previous != '0' * 40 and args.action == 'publish':
            if git('rev-parse', f'{ref}^{{tree}}').decode().strip() != tree:
                raise RuntimeError('This candidate already has different artifacts. Commit a new candidate before publishing changed inputs.')
            artifact = previous
        else:
            artifact = git('commit-tree', tree, '-p', candidate,
                           data=f'loop: {args.issue} artifacts for {candidate}\n'.encode()).decode().strip()
            git('update-ref', ref, artifact, previous)
        if args.action == 'publish':
            git('push', 'origin', f'{ref}:{ref}')
        print(json.dumps({'candidate': candidate, 'ref': ref, 'artifacts': artifact}))


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, OSError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
